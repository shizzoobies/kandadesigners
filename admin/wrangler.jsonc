{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ka-admin",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ka-admin",
      "database_id": "7e6d2716-1744-4618-a971-d12308a7bc5b"
    }
  ],
  // Identifiers, not secrets: the AUD tag names the Access application and the
  // team domain is public. Both are safe to commit.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "kandaperformance.cloudflareaccess.com",
    "ACCESS_AUD": "2bf30fbb34a3a276856fa95b5649bce7fd5a5776acb1103d64a6f51e8ed06900",
    // Newsletter sender. ka-performancefl.com is already verified in the
    // Resend account (Resend's records live on their own subdomains, so
    // Google Workspace's inbound MX on the apex is untouched). The
    // RESEND_API_KEY secret is set separately via secret bulk.
    "NEWSLETTER_FROM": "K & A Performance <news@ka-performancefl.com>"
  },
  // A Route, not a Custom Domain, and deliberately so.
  //
  // Custom Domain attachment fails with API code 100117, "already has externally
  // managed DNS records", because a proxied A record already exists at this
  // hostname. Routes are the mechanism that WANTS a pre-existing proxied record,
  // so the thing blocking one path is the prerequisite of the other. The record
  // points at 192.0.2.1 (RFC 5737 documentation space, deliberately unroutable);
  // the Worker intercepts every request before anything is sent there.
  //
  // If the DNS record is ever deleted, switch back to:
  //   { "pattern": "admin.ka-performancefl.com", "custom_domain": true }
  "routes": [
    { "pattern": "admin.ka-performancefl.com/*", "zone_name": "ka-performancefl.com" }
  ],
  "observability": { "enabled": true },
  // False since 2026-09-22. admin.ka-performancefl.com is live, so the route
  // above is the only door that should exist.
  //
  // This was not merely tidy-up. The old comment claimed "the app denies by
  // default, so this URL is not a hole", which was true only of paths the
  // middleware runs on. Static assets in ./dist are served by the assets
  // binding BEFORE any Worker code, so on the workers.dev hostname, where
  // Cloudflare Access does not apply, every file under public/ answered 200 to
  // anyone who guessed the URL. The parked Launch Book was one of them and it
  // carries a client's commercial terms; it has since moved behind the
  // middleware (see src/pages/launch-book.js). Turning this off closes the
  // ungated hostname as well, so the remaining static assets (fonts,
  // favicons) are reachable only through Access.
  "workers_dev": false
}
