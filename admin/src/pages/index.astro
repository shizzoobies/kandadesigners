---
import Shell from '../layouts/Shell.astro';
import { getDashboard } from '../lib/dashboard.js';
import { money, humanDate, todayInEastern } from '../lib/format.js';

const db = Astro.locals.runtime.env.DB;
const today = todayInEastern();
const board = await getDashboard(db, today);

const error = Astro.url.searchParams.get('error');
const ERRORS = {
  title: 'A follow-up needs a title. Nothing was saved.',
  date: 'That date could not be read. Use YYYY-MM-DD, or leave it blank. Nothing was saved.',
};

const moneyRows = board.stream.filter((s) => s.group === 'money');
const promiseRows = board.stream.filter((s) => s.group === 'promises');

const headingDate = new Intl.DateTimeFormat('en-GB', {
  weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC',
}).format(new Date(`${today}T00:00:00Z`));
---
<Shell title="What needs you today" active="today">
  {error && <p class="notice">{ERRORS[error] ?? 'Something went wrong. Nothing was saved.'}</p>}

  <dl class="money">
    <div><dt>Outstanding</dt><dd>{money(board.money.outstanding_cents)}</dd></div>
    <div class={board.money.overdue_cents > 0 ? 'bad' : ''}>
      <dt>Overdue</dt>
      <dd>{money(board.money.overdue_cents)}<small>{board.money.overdue_count} invoice{board.money.overdue_count === 1 ? '' : 's'}</small></dd>
    </div>
    <div class={board.money.not_invoiced_cents > 0 ? 'bad' : ''}>
      <dt>Not yet invoiced</dt>
      <dd>{money(board.money.not_invoiced_cents)}<small>{board.money.not_invoiced_count} item{board.money.not_invoiced_count === 1 ? '' : 's'}</small></dd>
    </div>
  </dl>

  {board.isQuiet && (
    <p class="empty-state">
      Nothing has arrived. No overdue invoices, no unbilled work, no promises due
      today. Anything coming up sits in the panels below.
    </p>
  )}

  {moneyRows.length > 0 && (
    <>
      <div class="groupline">Money, act first</div>
      <div class="rows">
        {moneyRows.map((s) => (
          <div class="row s-money">
            <div class="tag">{s.tag}</div>
            <div class="what">
              <b><a href={s.href}>{s.title}</a></b>
              <span>{s.detail}</span>
            </div>
            <div class="amt due">{money(s.amountCents)}<em>{s.note}</em></div>
          </div>
        ))}
      </div>
    </>
  )}

  {promiseRows.length > 0 && (
    <>
      <div class="groupline">Promises coming due</div>
      <div class="rows">
        {promiseRows.map((s) => (
          <div class="row s-soon">
            <div class="tag">{s.tag}</div>
            <div class="what">
              <b>{s.title}</b>
              <span>{s.detail}</span>
            </div>
            <div class="amt">
              <em>
                <form method="POST" action="/api/followups" style="display:inline">
                  <input type="hidden" name="intent" value="done" />
                  <input type="hidden" name="id" value={s.followupId} />
                  <input type="hidden" name="returnTo" value="/" />
                  <button class="danger" type="submit">done</button>
                </form>
              </em>
            </div>
          </div>
        ))}
      </div>
    </>
  )}

  {board.overflow > 0 && (
    <p class="empty-state">
      And {board.overflow} more. The stream caps at 20 so a busy week cannot turn it
      into a wall. See <a href="/invoices">Invoices</a> and <a href="/followups">Follow-ups</a>
      for the full lists.
    </p>
  )}

  <div class="groupline">Coming up, and quieter signals</div>
  <div class="grid">
    <section class="panel warn">
      <h3><b>Due in 7 days</b><span>{board.panels.followupsUpcoming.length}</span></h3>
      {board.panels.followupsUpcoming.length === 0 ? (
        <p class="empty">Nothing this week.</p>
      ) : (
        <ul>
          {board.panels.followupsUpcoming.map((f) => (
            <li>
              <div>{f.title}<span>{f.client_name ?? 'No client'} · {humanDate(f.due_on)}</span></div>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="panel warn">
      <h3><b>Retainers later this month</b><span>{board.panels.retainersLater.length}</span></h3>
      {board.panels.retainersLater.length === 0 ? (
        <p class="empty">Nothing pending.</p>
      ) : (
        <ul>
          {board.panels.retainersLater.map((r) => (
            <li>
              <div><a href={`/clients/${r.client_id}`}>{r.client_name}</a><span>{r.label} · day {r.day_of_month}</span></div>
              <i>{money(r.amount_cents)}</i>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="panel calm">
      <h3><b>Gone quiet</b><span>{board.panels.goneQuiet.length}</span></h3>
      {board.panels.goneQuiet.length === 0 ? (
        <p class="empty">Everything active has moved recently.</p>
      ) : (
        <ul>
          {board.panels.goneQuiet.map((p) => (
            <li>
              <div><a href={`/projects/${p.id}`}>{p.name}</a><span>{p.client_name} · {p.quiet_days} days quiet</span></div>
              <i>{p.waiting_on ? p.waiting_on : 'nobody'}</i>
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>

  {board.panels.followupsUndated.length > 0 && (
    <>
      <div class="groupline">Open follow-ups with no date</div>
      <div class="rows">
        {board.panels.followupsUndated.map((f) => (
          <div class="row s-quiet">
            <div class="tag">No date</div>
            <div class="what">
              <b>{f.title}</b>
              <span>{f.client_name ?? 'No client attached'}</span>
            </div>
            <div class="amt"><em><a href="/followups">give it a date</a></em></div>
          </div>
        ))}
      </div>
    </>
  )}

  <details class="adder">
    <summary>Quick add a follow-up</summary>
    <form method="POST" action="/api/followups">
      <input type="hidden" name="intent" value="create" />
      <input type="hidden" name="returnTo" value="/" />
      <div class="field">
        <label for="title">What did you promise</label>
        <input id="title" name="title" required autocomplete="off" placeholder="Send Berkseth badge revisions" />
      </div>
      <div class="field">
        <label for="dueOn">By when</label>
        <input id="dueOn" name="dueOn" type="date" />
      </div>
      <div class="actions">
        <button class="btn" type="submit">Add</button>
        <span class="linkish"><a href="/followups">all follow-ups</a></span>
      </div>
    </form>
  </details>

  <p class="empty-state" style="font-family:var(--font-mono);font-size:10px;letter-spacing:.13em;text-transform:uppercase">
    {headingDate} · Eastern
  </p>
</Shell>
