---
import Shell from '../../layouts/Shell.astro';
import {
  getClient, listLinks, listNotes, listProjectsForClient,
  listInvoicesForClient, listRetainersForClient,
} from '../../lib/db.js';
import { humanDate, money, todayInEastern, centsToInput } from '../../lib/format.js';

const id = Number(Astro.params.id);
const db = Astro.locals.runtime.env.DB;
const client = Number.isInteger(id) && id > 0 ? await getClient(db, id) : null;
if (!client) return new Response('Client not found', { status: 404 });

const [links, notes, projects, invoices, retainers] = await Promise.all([
  listLinks(db, id),
  listNotes(db, 'client', id),
  listProjectsForClient(db, id),
  listInvoicesForClient(db, id),
  listRetainersForClient(db, id),
]);
const today = todayInEastern();
const owed = invoices
  .filter((i) => i.status === 'sent')
  .reduce((n, i) => n + i.amount_cents, 0);

const saved = Astro.url.searchParams.get('saved');
const error = Astro.url.searchParams.get('error');
const here = `/clients/${id}`;

const KIND_LABEL = {
  live: 'Live site',
  staging: 'Staging',
  repo: 'Repo',
  drive: 'Drive',
  gbp: 'Google Business',
  social: 'Social',
  dashboard: 'Dashboard',
  other: 'Link',
};

const ERRORS = {
  name: 'A client needs a name. Nothing was saved.',
  label: 'That needs a label. Nothing was saved.',
  url: 'That link was rejected. Only http and https addresses are stored.',
  note: 'An empty note was not saved.',
  money: 'That amount could not be read. Use digits, like 350 or 2,400.00. Nothing was saved.',
  date: 'A date could not be read. Use YYYY-MM-DD, or leave it blank. Nothing was saved.',
  day: 'The billing day must be a number from 1 to 28, so a monthly charge cannot skip February.',
  client: 'That client could not be found. Nothing was saved.',
  project: 'That project could not be found. Nothing was saved.',
  id: 'That record could not be found. Nothing was saved.',
  intent: 'Unrecognised action. Nothing was saved.',
};
---
<Shell title={client.name} active="clients">
  {saved && <p class="empty-state">Saved.</p>}
  {error && <p class="notice">{ERRORS[error] ?? 'Something went wrong. Nothing was saved.'}</p>}

  <dl class="money">
    <div><dt>Status</dt><dd style="font-size:18px">{client.status}</dd></div>
    <div><dt>Company</dt><dd style="font-size:18px">{client.company || 'none'}</dd></div>
    <div><dt>Found us via</dt><dd style="font-size:18px">{client.source || 'unknown'}</dd></div>
  </dl>

  <div class="groupline">Contact</div>
  <div class="rows">
    <div class="row s-quiet">
      <div class="tag">Email</div>
      <div class="what">
        <b>{client.email ? <a href={`mailto:${client.email}`}>{client.email}</a> : 'Not recorded'}</b>
        <span>{client.phone ? client.phone : 'No phone recorded'}</span>
      </div>
      <div class="amt"><em>added {humanDate(client.created_at.slice(0, 10))}</em></div>
    </div>
  </div>

  <div class="groupline">Projects</div>
  {projects.length === 0 ? (
    <p class="empty-state">
      No projects for this client yet. Add one from <a href="/projects">Projects</a>.
    </p>
  ) : (
    <div class="rows">
      {projects.map((p) => (
        <div class={`row ${p.waiting_on === 'us' ? 's-money' : p.waiting_on ? 's-soon' : 's-quiet'}`}>
          <div class="tag">{p.status.replace('_', ' ')}</div>
          <div class="what">
            <b><a href={`/projects/${p.id}`}>{p.name}</a></b>
            <span>
              {p.waiting_on ? `Waiting on ${p.waiting_on === 'us' ? 'us' : p.waiting_on === 'client' ? 'the client' : 'an artist'}` : 'Nobody flagged'}
              {p.due_on ? ` · due ${humanDate(p.due_on)}` : ''}
            </span>
          </div>
          <div class="amt">{money(p.total_quoted_cents)}<em>quoted</em></div>
        </div>
      ))}
    </div>
  )}

  <div class="groupline">Invoices{owed > 0 ? ` · ${money(owed)} outstanding` : ''}</div>
  {invoices.length === 0 ? (
    <p class="empty-state">No invoices recorded for this client yet.</p>
  ) : (
    <div class="rows">
      {invoices.map((inv) => (
        <div class={`row ${
          inv.status === 'expected' ? 's-money'
          : inv.status === 'sent' ? (inv.due_on && inv.due_on < today ? 's-money' : 's-soon')
          : 's-quiet'
        }`}>
          <div class="tag">{inv.kind}</div>
          <div class="what">
            <b><a href={`/invoices/${inv.id}`}>{inv.ref || `${inv.kind} invoice`}</a></b>
            <span>
              {inv.project_id ? <><a href={`/projects/${inv.project_id}`}>{inv.project_name}</a>{' · '}</> : ''}
              {inv.status === 'paid' ? `paid ${humanDate(inv.paid_on)}`
                : inv.status === 'void' ? 'void'
                : inv.status === 'expected' ? 'not billed yet'
                : inv.due_on && inv.due_on < today ? `overdue, due ${humanDate(inv.due_on)}`
                : inv.due_on ? `due ${humanDate(inv.due_on)}` : 'sent, no due date'}
            </span>
          </div>
          <div class="amt">{money(inv.amount_cents)}<em>{inv.status}</em></div>
        </div>
      ))}
    </div>
  )}

  <details class="adder">
    <summary>Record an invoice, not tied to a project</summary>
    <form method="POST" action="/api/invoices">
      <input type="hidden" name="intent" value="create" />
      <input type="hidden" name="clientId" value={id} />
      <input type="hidden" name="returnTo" value={here} />
      <div class="field">
        <label for="iamount">Amount</label>
        <input id="iamount" name="amount" inputmode="decimal" required placeholder="350" />
      </div>
      <div class="field">
        <label for="ikind">Kind</label>
        <select id="ikind" name="kind">
          <option value="retainer">Retainer</option>
          <option value="other">Other</option>
          <option value="deposit">Deposit</option>
          <option value="balance">Balance</option>
        </select>
      </div>
      <div class="field">
        <label for="istatus">Status</label>
        <select id="istatus" name="status">
          <option value="expected">Expected, I still need to bill this</option>
          <option value="sent">Sent, awaiting payment</option>
          <option value="paid">Already paid</option>
        </select>
      </div>
      <div class="field">
        <label for="idue">Due date</label>
        <input id="idue" name="dueOn" type="date" />
      </div>
      <div class="field">
        <label for="iref">Reference</label>
        <input id="iref" name="ref" placeholder="INV-014" autocomplete="off" />
      </div>
      <div class="actions"><button class="btn" type="submit">Record invoice</button></div>
    </form>
  </details>

  <div class="groupline">Retainers</div>
  {retainers.length === 0 ? (
    <p class="empty-state">
      No retainers. Add one for anything that recurs monthly, like hosting, a care
      plan, or an AI assistant subscription. The invoices screen then tells you when
      a month has gone unbilled.
    </p>
  ) : (
    <div class="rows">
      {retainers.map((r) => (
        <div class={`row ${r.active ? 's-soon' : 's-quiet'}`}>
          <div class="tag">{r.active ? `Day ${r.day_of_month}` : 'Paused'}</div>
          <div class="what">
            <b>{r.label}</b>
            <span>
              {r.active ? `Bills on day ${r.day_of_month} each month` : 'Not billing'}
              {r.started_on ? ` · since ${humanDate(r.started_on)}` : ''}
            </span>
          </div>
          <div class="amt">
            {money(r.amount_cents)}
            <em>
              <form method="POST" action="/api/retainers" style="display:inline">
                <input type="hidden" name="intent" value={r.active ? 'pause' : 'resume'} />
                <input type="hidden" name="id" value={r.id} />
                <input type="hidden" name="returnTo" value={here} />
                <button class="danger" type="submit">{r.active ? 'pause' : 'resume'}</button>
              </form>
            </em>
          </div>
        </div>
      ))}
    </div>
  )}

  <details class="adder">
    <summary>Add a retainer</summary>
    <form method="POST" action="/api/retainers">
      <input type="hidden" name="intent" value="create" />
      <input type="hidden" name="clientId" value={id} />
      <input type="hidden" name="returnTo" value={here} />
      <div class="field">
        <label for="rlabel">What it is</label>
        <input id="rlabel" name="label" required placeholder="Hosting and care plan" autocomplete="off" />
      </div>
      <div class="field">
        <label for="ramount">Monthly amount</label>
        <input id="ramount" name="amount" inputmode="decimal" required placeholder="95" />
      </div>
      <div class="field">
        <label for="rday">Day of the month it bills</label>
        <input id="rday" name="dayOfMonth" type="number" min="1" max="28" value="1" required />
      </div>
      <div class="field">
        <label for="rstart">Started</label>
        <input id="rstart" name="startedOn" type="date" />
      </div>
      <div class="actions"><button class="btn" type="submit">Add retainer</button></div>
    </form>
  </details>

  <div class="groupline">Links</div>
  {links.length === 0 ? (
    <p class="empty-state">No links yet. This is where the tab hunting stops.</p>
  ) : (
    <div class="rows">
      {links.map((l) => (
        <div class="row s-quiet">
          <div class="tag">{KIND_LABEL[l.kind] ?? 'Link'}</div>
          <div class="what">
            <b><a href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a></b>
            <span>{l.url}</span>
          </div>
          <div class="amt">
            <form method="POST" action="/api/links" style="display:inline">
              <input type="hidden" name="intent" value="delete" />
              <input type="hidden" name="id" value={l.id} />
              <input type="hidden" name="returnTo" value={here} />
              <button class="danger" type="submit">remove</button>
            </form>
          </div>
        </div>
      ))}
    </div>
  )}

  <details class="adder">
    <summary>Add a link</summary>
    <form method="POST" action="/api/links">
      <input type="hidden" name="intent" value="create" />
      <input type="hidden" name="clientId" value={id} />
      <input type="hidden" name="returnTo" value={here} />
      <div class="field">
        <label for="label">Link label</label>
        <input id="label" name="label" required autocomplete="off" />
      </div>
      <div class="field">
        <label for="url">URL</label>
        <input id="url" name="url" type="url" required placeholder="https://" />
      </div>
      <div class="field">
        <label for="kind">Kind</label>
        <select id="kind" name="kind">
          {Object.entries(KIND_LABEL).map(([value, label]) => (
            <option value={value}>{label}</option>
          ))}
        </select>
      </div>
      <div class="actions">
        <button class="btn" type="submit">Add link</button>
      </div>
    </form>
  </details>

  <details class="adder">
    <summary>Notes</summary>
    <form method="POST" action="/api/notes">
      <input type="hidden" name="intent" value="create" />
      <input type="hidden" name="entityType" value="client" />
      <input type="hidden" name="entityId" value={id} />
      <input type="hidden" name="returnTo" value={here} />
      <div class="field">
        <label for="body">Add a note</label>
        <textarea id="body" name="body" required></textarea>
      </div>
      <div class="actions">
        <button class="btn" type="submit">Save note</button>
        <label class="linkish"><input type="checkbox" name="pinned" value="1" /> pin it</label>
      </div>
    </form>
  </details>

  {notes.length === 0 ? (
    <p class="empty-state">No notes yet.</p>
  ) : (
    <div class="rows">
      {notes.map((n) => (
        <div class={`row ${n.pinned ? 's-soon' : 's-quiet'}`}>
          <div class="tag">{n.pinned ? 'Pinned' : humanDate(n.created_at.slice(0, 10))}</div>
          <div class="what">
            <b>{n.body}</b>
            <span>{n.author_email}{n.pinned ? ` · ${humanDate(n.created_at.slice(0, 10))}` : ''}</span>
          </div>
          <div class="amt">
            <form method="POST" action="/api/notes" style="display:inline">
              <input type="hidden" name="intent" value="delete" />
              <input type="hidden" name="id" value={n.id} />
              <input type="hidden" name="returnTo" value={here} />
              <button class="danger" type="submit">delete</button>
            </form>
          </div>
        </div>
      ))}
    </div>
  )}

  <details class="adder">
    <summary>Edit client</summary>
    <form method="POST" action="/api/clients">
      <input type="hidden" name="intent" value="update" />
      <input type="hidden" name="id" value={id} />
      <div class="field">
        <label for="ename">Name</label>
        <input id="ename" name="name" value={client.name} required />
      </div>
      <div class="field">
        <label for="ecompany">Company</label>
        <input id="ecompany" name="company" value={client.company} />
      </div>
      <div class="field">
        <label for="eemail">Email</label>
        <input id="eemail" name="email" type="email" value={client.email} />
      </div>
      <div class="field">
        <label for="ephone">Phone</label>
        <input id="ephone" name="phone" value={client.phone} />
      </div>
      <div class="field">
        <label for="estatus">Status</label>
        <select id="estatus" name="status">
          {['active', 'lead', 'past'].map((s) => (
            <option value={s} selected={s === client.status}>{s}</option>
          ))}
        </select>
      </div>
      <div class="field">
        <label for="esource">How they found us</label>
        <input id="esource" name="source" value={client.source} />
      </div>
      <div class="actions">
        <button class="btn" type="submit">Save changes</button>
      </div>
    </form>
  </details>

  <details class="adder danger-adder">
    <summary>Archive</summary>
    <form method="POST" action="/api/clients">
      <input type="hidden" name="intent" value="archive" />
      <input type="hidden" name="id" value={id} />
      <p class="empty-state">
        Archiving hides this client from the list. Nothing is deleted, because the
        notes and invoices hanging off it are the record of real money and real
        conversations.
      </p>
      <div class="actions">
        <button class="danger" type="submit">Archive {client.name}</button>
      </div>
    </form>
  </details>
</Shell>
