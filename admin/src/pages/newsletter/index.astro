---
import Shell from '../../layouts/Shell.astro';
import { listNewslettersAll, listAllLeads, countCourseLeads } from '../../lib/db.js';
import { humanDate } from '../../lib/format.js';

const db = Astro.locals.runtime.env.DB;

// Two tabs, money-page style: the letters themselves, and the list they
// go to. The whole mailing list lives here; coaching keeps its recent-20.
const TABS = [
  { key: 'letters', label: 'Letters' },
  { key: 'subscribers', label: 'Mailing list' },
];
const rawTab = Astro.url.searchParams.get('tab') ?? 'letters';
const tab = TABS.some((t) => t.key === rawTab) ? rawTab : 'letters';

const FILTERS = ['all', 'subscribed', 'unsubscribed'];
const rawFilter = Astro.url.searchParams.get('filter') ?? 'all';
const filter = FILTERS.includes(rawFilter) ? rawFilter : 'all';

const [letters, leads, total] = await Promise.all([
  listNewslettersAll(db),
  tab === 'subscribers' ? listAllLeads(db, filter) : Promise.resolve([]),
  countCourseLeads(db),
]);
const drafts = letters.filter((n) => n.status === 'draft');
const sentOnes = letters.filter((n) => n.status === 'sent');

const deleted = Astro.url.searchParams.get('deleted');
const error = Astro.url.searchParams.get('error');
---
<Shell title="Newsletter" active="newsletter">
  {deleted && <p class="notice">Draft deleted.</p>}
  {error === 'missing' && <p class="notice">That letter could not be found.</p>}

  <dl class="money">
    <div><dt>On the list</dt><dd>{total}</dd></div>
    <div><dt>Drafts</dt><dd>{drafts.length}</dd></div>
    <div><dt>Sent</dt><dd>{sentOnes.length}</dd></div>
  </dl>

  <div class="groupline">
    {TABS.map((t, i) => (
      <>{i > 0 ? ' · ' : ''}<a
        href={`/newsletter?tab=${t.key}`}
        style={t.key === tab ? 'color:var(--ink);text-decoration:underline' : ''}
      >{t.label}</a></>
    ))}
  </div>

  {tab === 'letters' ? (
    <>
      <details class="adder" open={letters.length === 0}>
        <summary>Start a letter</summary>
        <form method="POST" action="/api/newsletter">
          <input type="hidden" name="intent" value="create" />
          <div class="field">
            <label for="notes">Jot the idea. Rough is fine; the polish pass does the writing.</label>
            <textarea id="notes" name="notes" rows="4" placeholder="Tell the list about the free course update, mention the launch has 2 openings in October, keep it short"></textarea>
          </div>
          <div class="actions"><button class="btn" type="submit">Create draft</button></div>
        </form>
      </details>

      {letters.length === 0 ? (
        <p class="empty-state">No letters yet. Jot an idea above and let the polish pass earn its keep.</p>
      ) : (
        <div class="rows">
          {letters.map((n) => (
            <div class={`row ${n.status === 'draft' ? 's-soon' : 's-quiet'}`}>
              <div class="tag">{n.status === 'draft' ? 'Draft' : humanDate((n.sent_at ?? n.updated_at).slice(0, 10))}</div>
              <div class="what">
                <b><a href={`/newsletter/${n.id}`}>{n.subject || '(no subject yet)'}</a></b>
                <span>
                  {n.status === 'sent'
                    ? `to ${n.sent_count}${n.fail_count ? ` · ${n.fail_count} failed` : ''} · by ${n.sent_by}`
                    : `edited ${humanDate(n.updated_at.slice(0, 10))}`}
                </span>
              </div>
              <div class="amt"><em><a href={`/newsletter/${n.id}`}>open</a></em></div>
            </div>
          ))}
        </div>
      )}
    </>
  ) : (
    <>
      <div class="groupline">
        {FILTERS.map((f, i) => (
          <>{i > 0 ? ' · ' : ''}<a
            href={`/newsletter?tab=subscribers&filter=${f}`}
            style={f === filter ? 'color:var(--ink);text-decoration:underline' : ''}
          >{f}</a></>
        ))}
      </div>
      {leads.length === 0 ? (
        <p class="empty-state">Nobody {filter === 'all' ? 'on the list yet' : filter} yet.</p>
      ) : (
        <div class="rows">
          {leads.map((l) => (
            <div class={`row ${l.unsubscribed_at ? 's-quiet' : 's-soon'}`}>
              <div class="tag">{l.unsubscribed_at ? 'Unsubbed' : l.source}</div>
              <div class="what">
                <b>{l.name || l.email}</b>
                <span>
                  {l.name ? `${l.email} · ` : ''}joined {humanDate(l.created_at.slice(0, 10))}
                  {l.times > 1 ? ` · back ${l.times} times` : ''}
                  {l.unsubscribed_at ? ` · left ${humanDate(l.unsubscribed_at.slice(0, 10))}` : ''}
                </span>
              </div>
            </div>
          ))}
        </div>
      )}
    </>
  )}
</Shell>
