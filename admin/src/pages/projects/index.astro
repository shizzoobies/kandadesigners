---
import Shell from '../../layouts/Shell.astro';
import { listProjects, listClients } from '../../lib/db.js';
import { money, humanDate, todayInEastern } from '../../lib/format.js';

const db = Astro.locals.runtime.env.DB;
const [projects, clients] = await Promise.all([listProjects(db), listClients(db)]);

const error = Astro.url.searchParams.get('error');
const archived = Astro.url.searchParams.get('archived');
const today = todayInEastern();

const ERRORS = {
  name: 'A project needs a name. Nothing was saved.',
  client: 'Pick a client. Every project belongs to one.',
  money: 'That quoted amount could not be read. Use digits, like 8500 or 8,500.00. Nothing was saved.',
  date: 'A date could not be read. Use YYYY-MM-DD, or leave it blank. Nothing was saved.',
  id: 'That project could not be found. Nothing was saved.',
  intent: 'Unrecognised action. Nothing was saved.',
};

const FINISHED = new Set(['complete', 'cancelled']);
const live = projects.filter((p) => !FINISHED.has(p.status));
const finished = projects.filter((p) => FINISHED.has(p.status));

// Grouped by who is blocking, because "waiting on them" and "waiting on me" are
// different jobs. Waiting on us is rust: it is the only group you can act on
// without chasing somebody.
const GROUPS = [
  { key: 'us', label: 'Waiting on us', rule: 's-money' },
  { key: 'client', label: 'Waiting on the client', rule: 's-soon' },
  { key: 'artist', label: 'Waiting on an artist', rule: 's-soon' },
  { key: null, label: 'Nobody flagged', rule: 's-quiet' },
];

const quotedLive = live.reduce((n, p) => n + (p.total_quoted_cents || 0), 0);
const blockedOnUs = live.filter((p) => p.waiting_on === 'us').length;

function dueLabel(p) {
  if (p.delivered_on) return `delivered ${humanDate(p.delivered_on)}`;
  if (!p.due_on) return 'no due date';
  if (p.due_on < today) return `overdue, due ${humanDate(p.due_on)}`;
  if (p.due_on === today) return 'due today';
  return `due ${humanDate(p.due_on)}`;
}
---
<Shell title="Projects" active="projects">
  {error && <p class="notice">{ERRORS[error] ?? 'Something went wrong. Nothing was saved.'}</p>}
  {archived && <p class="empty-state">Project archived. It is hidden here but nothing was deleted.</p>}

  <dl class="money">
    <div><dt>Live projects</dt><dd>{live.length}</dd></div>
    <div><dt>Quoted, live work</dt><dd>{money(quotedLive)}</dd></div>
    <div class={blockedOnUs > 0 ? 'bad' : ''}><dt>Waiting on us</dt><dd>{blockedOnUs}</dd></div>
  </dl>

  {projects.length === 0 && (
    <p class="empty-state">
      No projects yet. Add one below. A project is what invoices get billed
      against, so this is where the money tracking starts.
    </p>
  )}

  {GROUPS.map((group) => {
    const rows = live.filter((p) => (p.waiting_on ?? null) === group.key);
    if (rows.length === 0) return null;
    return (
      <>
        <div class="groupline">{group.label}</div>
        <div class="rows">
          {rows.map((p) => (
            <div class={`row ${group.rule}`}>
              <div class="tag">{p.status.replace('_', ' ')}</div>
              <div class="what">
                <b><a href={`/projects/${p.id}`}>{p.name}</a></b>
                <span><a href={`/clients/${p.client_id}`}>{p.client_name}</a> · {dueLabel(p)}</span>
              </div>
              <div class="amt">{money(p.total_quoted_cents)}<em>quoted</em></div>
            </div>
          ))}
        </div>
      </>
    );
  })}

  {finished.length > 0 && (
    <>
      <div class="groupline">Finished</div>
      <div class="rows">
        {finished.map((p) => (
          <div class="row s-quiet">
            <div class="tag">{p.status}</div>
            <div class="what">
              <b><a href={`/projects/${p.id}`}>{p.name}</a></b>
              <span><a href={`/clients/${p.client_id}`}>{p.client_name}</a> · {dueLabel(p)}</span>
            </div>
            <div class="amt">{money(p.total_quoted_cents)}<em>quoted</em></div>
          </div>
        ))}
      </div>
    </>
  )}

  <details class="adder">
  <summary>Add a project</summary>
  {clients.length === 0 ? (
    <p class="empty-state">
      Add a <a href="/clients">client</a> first. Every project belongs to one.
    </p>
  ) : (
    <form method="POST" action="/api/projects">
      <input type="hidden" name="intent" value="create" />
      <div class="field">
        <label for="name">Project name</label>
        <input id="name" name="name" required autocomplete="off" />
      </div>
      <div class="field">
        <label for="clientId">Client</label>
        <select id="clientId" name="clientId" required>
          {clients.map((c) => <option value={c.id}>{c.name}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="totalQuoted">Quoted total</label>
        <input id="totalQuoted" name="totalQuoted" inputmode="decimal" placeholder="8500" autocomplete="off" />
      </div>
      <div class="field">
        <label for="status">Status</label>
        <select id="status" name="status">
          <option value="active">Active</option>
          <option value="quoted">Quoted</option>
          <option value="on_hold">On hold</option>
          <option value="delivered">Delivered</option>
          <option value="complete">Complete</option>
          <option value="cancelled">Cancelled</option>
        </select>
      </div>
      <div class="field">
        <label for="waitingOn">Waiting on</label>
        <select id="waitingOn" name="waitingOn">
          <option value="">Nobody</option>
          <option value="us">Us</option>
          <option value="client">The client</option>
          <option value="artist">An artist</option>
        </select>
      </div>
      <div class="field">
        <label for="dueOn">Due date</label>
        <input id="dueOn" name="dueOn" type="date" />
      </div>
      <div class="actions"><button class="btn" type="submit">Add project</button></div>
    </form>
  )}
  </details>
</Shell>
