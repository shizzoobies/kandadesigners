    background: none;
    transition: opacity var(--dur-fast) var(--ease-out-expo), transform var(--dur-fast) var(--ease-out-expo), background var(--dur-fast) var(--ease-out-expo), color var(--dur-fast) var(--ease-out-expo);
  }
  .al-kai-btn:hover { background: var(--color-accent); color: #FFFDF9; }
  .al-kai-dot {
    width: 0.5rem;
