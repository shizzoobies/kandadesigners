        <div data-animate="frame-lift" class="glow-frame p-8 md:p-10">
          <form id="al-form" class="flex flex-col gap-6" novalidate>
            <input type="hidden" name="access_key" value="7ad90fb9-bc88-411a-9442-c249b49c32f6" />
            <input type="hidden" name="subject" value="New AI Launch lead | ka-performancefl.com" />
            <input type="hidden" name="from_name" value="K & A Performance Website" />
