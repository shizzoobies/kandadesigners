              </div>
              <div>
                <label for="al-heard" class="mb-3 block font-mono text-xs uppercase tracking-[0.2em] text-muted">How did you hear about us?</label>
                <select id="al-heard" name="how_did_you_hear" class="field">
                  <option>Synovial Marketing</option>
                  <option>Referral</option>
                  <option>Search</option>
                  <option selected>Other</option>
                </select>
              </div>
            </div>

            <button type="submit" id="al-submit" class="btn-draw w-full text-center">Request the call</button>
            <p id="al-status" class="sr-only" role="status" aria-live="polite"></p>
            <p id="al-error" tabindex="-1" class="hidden text-sm leading-relaxed text-muted" role="alert">
              Something went wrong sending that. Please email us directly at
              <a href="mailto:alex@ka-performancefl.com" class="text-accent underline transition-colors hover:text-accent-hot">alex@ka-performancefl.com</a>
              and we'll pick it up.
            </p>
          </form>

          <div id="al-success" tabindex="-1" role="status" aria-live="polite" class="hidden flex-col justify-center">
            <h3 class="font-display text-3xl leading-tight">Got it</h3>
            <p class="mt-6 text-lg leading-relaxed text-muted">
              Alex will call you back within one business day, usually the same
              day. The call is twenty minutes: what eats your week, whether
              there is something worth building, and honest advice either way.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* The twelve-week rail. Decorative, desktop only; the phase list carries
     the content. Lenia Mono for the week numbers keeps the site's one mono
     face doing its usual technical-layer job. */
  .al-rail-wrap {
    position: relative;
    padding-top: 2rem;
  }
  .al-rail {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.4rem;
