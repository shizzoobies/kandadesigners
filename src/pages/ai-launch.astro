              <div>
                <label for="al-email" class="mb-3 block font-mono text-xs uppercase tracking-[0.2em] text-muted">Email</label>
                <input type="email" id="al-email" name="email" required autocomplete="email" placeholder="your@email.com" class="field" />
              </div>
            </div>

            <div>
              <label for="al-week" class="mb-3 block font-mono text-xs uppercase tracking-[0.2em] text-muted">What eats your week?</label>
              <textarea id="al-week" name="what_eats_your_week" required rows="4" placeholder="The thing that takes hours you know it shouldn't" class="field field-area"></textarea>
            </div>

            <!-- Only shown for the two site tiers: knowing what exists today
                 is half of what makes the callback useful. -->
            <div id="al-site-wrap" class="hidden">
              <label for="al-site" class="mb-3 block font-mono text-xs uppercase tracking-[0.2em] text-muted">
                Current website <span class="tracking-normal normal-case">(if you have one)</span>
              </label>
              <input type="url" id="al-site" name="current_website" autocomplete="url" placeholder="https://yourbusiness.com" class="field" />
            </div>

            <div class="grid gap-6 sm:grid-cols-2">
              <div>
                <label for="al-interest" class="mb-3 block font-mono text-xs uppercase tracking-[0.2em] text-muted">Interested in</label>
                <select id="al-interest" name="interested_in" class="field">
                  <option>The Launch, $2,000</option>
                  <option>Launch + Site, $3,999</option>
                  <option>Build Alongside, from $10,000</option>
                  <option selected>Not sure yet</option>
