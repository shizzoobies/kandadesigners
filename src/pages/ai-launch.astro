  }
  @keyframes al-sg-nudge {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.14); }
  }

  /* The traveling dot rides the rail as the section scrolls through. Its
     authored resting place is week twelve, so reduced-motion and no-JS both
     read as a finished program rather than one stuck at the start. */
  .al-dot {
    position: absolute;
    left: 100%;
    bottom: 0.4rem;
