---
import BaseLayout from '../layouts/BaseLayout.astro';

// The lead offer's landing page. Copy source: Coaching/ai-membership-business-plan.md
// and Coaching/site-integration-handoff.md. Rules that page carries everywhere:
// no em dashes, no claim that K&A provides Claude accounts or seats, no client
// names without permission, no guaranteed outcomes.
//
// Service schema sits beside BaseLayout's @graph and points provider at the
// existing organization node, so the offer inherits the LocalBusiness identity
// instead of describing a second business.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: '90-Day AI Launch',
  serviceType: 'AI integration coaching and implementation',
  description:
    'Twelve weekly one-on-one working sessions ending with one real AI workflow running in the client’s own accounts, plus the ability to run it without us.',
  url: 'https://ka-performancefl.com/ai-launch/',
  provider: { '@id': 'https://ka-performancefl.com/#organization' },
  // Delivered over video from Gainesville; the page sells it remotely, so
  // the schema claims the state rather than understating to one city.
  areaServed: { '@type': 'State', name: 'Florida' },
  offers: [
    { '@type': 'Offer', name: '90-Day AI Launch', price: '2000', priceCurrency: 'USD' },
    { '@type': 'Offer', name: 'Launch + Site', price: '3999', priceCurrency: 'USD' },
    {
      '@type': 'Offer',
      name: 'Build Alongside',
      priceSpecification: { '@type': 'PriceSpecification', minPrice: 10000, priceCurrency: 'USD' },
    },
  ],
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://ka-performancefl.com/' },
    { '@type': 'ListItem', position: 2, name: '90-Day AI Launch', item: 'https://ka-performancefl.com/ai-launch/' },
  ],
};

// The twelve weeks, three phases. The track below renders from this.
const phases = [
  {
    weeks: 'Weeks 01 to 02',
    title: 'Map',
    copy: 'An opportunity map of your business, your account set up on your own subscription, and one quick win shipped in the first session so you feel it immediately.',
  },
  {
    weeks: 'Weeks 03 to 08',
    title: 'Build',
    copy: 'The highest-value workflow in your business, built together, live, on your real data. Not a demo on sample files.',
  },
  {
    weeks: 'Weeks 09 to 12',
    title: 'Run it yourself',
    copy: 'You build one on your own with Alex watching. You finish with a handoff doc, recorded walkthroughs, and a written plan for what comes next.',
  },
];

// Real workflows, all shipped and running. No client names: nothing here has
// written permission on file, so everything cited is our own operation.
// Each carries a small line-drawn glyph in the site's sketch language;
// the paths draw themselves in as the cards arrive.
const outcomes = [
  {
    what: 'A scoping assistant that interviews a website visitor, asks what a first call would ask, and emails a working project brief.',
    where: 'Live on this site right now',
    icon: 'M8 12 h20 a6 6 0 0 1 6 6 v8 a6 6 0 0 1 -6 6 h-10 l-8 7 v-7 h-2 a6 6 0 0 1 -6 -6 v-8 a6 6 0 0 1 6 -6 Z M12 22 h16 M12 27 h10',
  },
  {
    what: 'An operations dashboard tracking clients, projects, invoices and follow-ups, with a 7am digest email of what needs attention today.',
    where: 'Runs this studio every morning',
    icon: 'M4 8 h32 v26 h-32 Z M4 15 h32 M13 15 v19 M17 21 h14 M17 26 h10 M7 11.5 h3',
  },
  {
    what: 'A voice assistant that answers customer questions in text or out loud, trained on the business it serves.',
    where: 'That is Kai. Hear the voice demo on our services page',
    icon: 'M20 6 a5 5 0 0 1 5 5 v9 a5 5 0 0 1 -10 0 v-9 a5 5 0 0 1 5 -5 Z M10 20 a10 10 0 0 0 20 0 M20 30 v6 M14 36 h12',
  },
  {
    what: 'A daily content engine that drafts, files and scores creative output, so the good ideas stop dying in a notes app.',
    where: 'In daily use',
    icon: 'M10 4 h16 l6 6 v26 h-22 Z M26 4 v6 h6 M15 18 h12 M15 23 h12 M15 28 h8 M29 29 l3 3 l5 -6',
  },
];

const answers = [
  {
    q: 'Can’t I just use ChatGPT for free?',
    a: 'You can, and some people should. What you are paying for is not access to a tool. It is twelve weeks not spent finding out which approaches are dead ends. Alex has already spent them.',
  },
  {
    q: 'What does it cost after the twelve weeks?',
    a: 'Your own Claude subscription, around twenty dollars a month, paid to Anthropic on your own card. There is no ongoing fee to us unless you choose to keep working together after the program ends.',
  },
  {
    q: 'I am not technical.',
    a: 'Neither are most of the people we build for. The last three weeks of the program exist specifically so you can run everything without us.',
  },
  {
    q: 'What if there is nothing worth building in my business?',
    a: 'Then Alex tells you so on the first call and it has cost you twenty minutes. He would rather say no than take two thousand dollars for a bad fit.',
  },
  {
    q: 'I do not like the idea of replacing people with AI.',
    a: 'Neither do we, and nothing in this program does. AI cannot replace a productive person or a creative one. What it replaces is the retyping, the sorting, the formatting: the hours that were never the real job. The point is handing those hours back so your people can focus on the decisions that matter most. In our experience the team does not shrink, the backlog does.',
  },
  {
    q: 'Will AI not make my business feel generic?',
    a: 'Only if you let it write your judgment instead of your paperwork. The workflows we build run on your voice, your policies, and your standards, and a person stays on every decision a customer would feel. Generic comes from replacing taste with automation; we automate the parts that never had taste in them.',
  },
];
---
<BaseLayout
  title="The 90-Day AI Launch | K & A Performance | Gainesville, FL"
  description="Twelve weeks, one build, one owner. Get AI running a real job in your business, in your own account, with a Gainesville developer who has shipped it. From $2,000."
  ogImage="/images/og-ai-launch.png?v=1"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} />

  <!-- Editorial hero: text beside a window sketching the before-and-after,
       same drawn language as the home page's act-0 and audit sketches. -->
  <section class="mx-auto max-w-6xl px-6 pt-40 pb-20 md:pt-48 md:pb-24">
    <div class="grid items-center gap-12 lg:grid-cols-[1fr_0.8fr] lg:gap-16">
      <div>
        <p data-animate="type-settle" class="font-mono text-sm uppercase tracking-[0.3em] text-muted">The 90-Day AI Launch</p>
        <h1 data-animate="type-settle" data-animate-delay="0.1" class="mt-6 font-display text-[clamp(2.6rem,7vw,5.25rem)] leading-[1.04]">
          Ninety days to one part of your business <span class="text-accent">running on AI</span>
        </h1>
        <p data-animate="type-settle" data-animate-delay="0.2" class="mt-8 max-w-2xl text-lg leading-relaxed text-muted">
          A twelve-week build, one on one with Alex. We find the job that eats your
          week, build the workflow that does it, and hand you the controls. You
          finish with something running in your own account that was not there
          before, and the ability to run it without us.
        </p>
        <div data-animate="type-settle" data-animate-delay="0.3" class="mt-10 flex flex-wrap items-center gap-6">
          <a href="#apply" class="btn-draw" data-pick="The Launch, $2,000">Book the first call</a>
          <p class="text-sm text-muted">$2,000 one time, or three payments of $700.<br class="sm:hidden" /> The first call is twenty minutes and free.</p>
        </div>
      </div>
      <!-- A workflow drawing itself: the pile of stuff, through the AI mark,
           into checked-off lines. Decorative; draws in on load. -->
      <svg
        id="al-hero-sketch"
        class="hidden w-full text-ink/35 lg:block"
        viewBox="0 0 640 430"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="1" y="1" width="638" height="428" rx="14" />
        <line x1="1" y1="46" x2="639" y2="46" />
        <circle cx="26" cy="23" r="6" />
        <circle cx="48" cy="23" r="6" />
        <circle cx="70" cy="23" r="6" />
        <!-- the pile: uneven inbox lines -->
        <line x1="48" y1="110" x2="196" y2="110" />
        <line x1="48" y1="140" x2="172" y2="140" />
        <line x1="48" y1="170" x2="208" y2="170" />
        <line x1="48" y1="200" x2="160" y2="200" />
        <line x1="48" y1="230" x2="188" y2="230" />
        <line x1="48" y1="260" x2="150" y2="260" />
        <line x1="48" y1="290" x2="200" y2="290" />
        <line x1="48" y1="320" x2="166" y2="320" />
        <!-- through the AI mark -->
        <line x1="240" y1="215" x2="296" y2="215" />
        <path d="M296 209 L308 215 L296 221" />
        <circle cx="352" cy="215" r="34" class="text-accent" />
        <path d="M352 193 v44 M330 215 h44 M337 200 l30 30 M367 200 l-30 30" class="text-accent" />
        <line x1="396" y1="215" x2="452" y2="215" />
        <path d="M452 209 L464 215 L452 221" />
        <!-- out the other side: checked and done -->
        <path d="M488 104 l8 8 l14 -16" class="text-accent" />
        <line x1="522" y1="104" x2="592" y2="104" />
        <path d="M488 164 l8 8 l14 -16" class="text-accent" />
        <line x1="522" y1="164" x2="592" y2="164" />
        <path d="M488 224 l8 8 l14 -16" class="text-accent" />
        <line x1="522" y1="224" x2="592" y2="224" />
        <path d="M488 284 l8 8 l14 -16" class="text-accent" />
        <line x1="522" y1="284" x2="592" y2="284" />
        <rect x="480" y="330" width="112" height="34" rx="17" />
      </svg>
    </div>
  </section>

  <!-- The twelve-week track: the one element doing work no paragraph could. -->
  <section class="border-t border-ink/10 bg-surface">
    <div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
      <h2 data-animate="type-settle" class="font-display text-3xl md:text-5xl">How the twelve weeks work</h2>

      <!-- Decorative tick rail, desktop only. The three phase blocks below are
           the accessible content; at 375px they are all that renders. -->
      <div id="al-track" class="mt-16 hidden md:block" aria-hidden="true">
        <div class="al-rail-wrap">
          <div class="al-rail"></div>
          <span class="al-dot"></span>
          <div class="al-weeks">
            {Array.from({ length: 12 }, (_, i) => (
              <span class:list={['al-week', (i === 0 || i === 2 || i === 8) && 'al-week-major']}>
                <span class="al-num font-mono">{String(i + 1).padStart(2, '0')}</span>
                <span class="al-tick"></span>
              </span>
            ))}
          </div>
        </div>
      </div>

      <ol class="mt-10 grid gap-10 md:mt-12 md:grid-cols-[2fr_6fr_4fr] md:gap-8">
        {phases.map((p) => (
          <li data-animate="type-settle" class="al-phase">
            <p class="font-mono text-xs uppercase tracking-[0.25em] text-accent">{p.weeks}</p>
            <h3 class="mt-3 font-display text-2xl">{p.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{p.copy}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Week one, live. The program's first deliverable is an opportunity map,
       so the page makes a small one on the spot. Same qualifying question as
       the intake form; the sketch hands its answer straight to the form. -->
  <section class="mx-auto max-w-4xl px-6 py-24 md:py-32">
    <div data-animate="frame-lift" class="glow-frame ai-alive p-8 md:p-12">
      <p class="font-mono text-sm uppercase tracking-[0.3em] text-accent">Try week one now</p>
      <h2 class="mt-6 font-display text-3xl leading-tight md:text-4xl">What eats your week?</h2>
      <p class="mt-6 text-lg leading-relaxed text-muted">
        Answer the same question the intake form asks, and Kai sketches what
        your Launch would build: the workflow, the first session's quick win,
        and where you are by week nine.
      </p>

      <form id="al-map-form" class="mt-8 flex flex-col gap-4 sm:flex-row" novalidate>
        <label for="al-map-input" class="sr-only">What eats your week?</label>
        <input
          type="text"
          id="al-map-input"
          maxlength="600"
          placeholder="Every quote takes me a whole evening"
          class="field flex-1"
          autocomplete="off"
        />
        <button type="submit" id="al-map-btn" class="btn-accent shrink-0">Sketch my launch</button>
      </form>
      <p id="al-map-status" class="sr-only" role="status" aria-live="polite"></p>

      <div id="al-map-out" class="hidden" tabindex="-1">
        <dl class="mt-8 space-y-6 border-t border-ink/10 pt-8">
          <div>
            <dt class="font-mono text-xs uppercase tracking-[0.25em] text-accent">The workflow, weeks 03 to 08</dt>
            <dd id="al-map-workflow" class="mt-2 leading-relaxed"></dd>
          </div>
          <div>
            <dt class="font-mono text-xs uppercase tracking-[0.25em] text-accent">Session one quick win</dt>
            <dd id="al-map-quickwin" class="mt-2 leading-relaxed"></dd>
          </div>
          <div>
            <dt class="font-mono text-xs uppercase tracking-[0.25em] text-accent">By week 09, yours to run</dt>
            <dd id="al-map-week9" class="mt-2 leading-relaxed"></dd>
          </div>
        </dl>
        <div class="mt-8 flex flex-wrap items-center gap-5">
          <button type="button" id="al-map-apply" class="btn-accent">Start my intake with this</button>
          <p class="text-sm text-muted">A sketch, not a quote. The real map happens in week one.</p>
        </div>
      </div>

      <p id="al-map-note" class="mt-6 hidden leading-relaxed text-muted" tabindex="-1" role="status"></p>
      <p id="al-map-error" class="mt-6 hidden leading-relaxed text-muted" tabindex="-1" role="alert">
        Kai is offline right now. The intake form at the bottom of this page
        works regardless, and Alex reads every one.
      </p>
    </div>
  </section>

  <!-- Cousin, not funnel stage: the free course has its own front door at
       /free-course/. One calm pointer here for the not-ready-yet. -->
  <section class="border-t border-ink/10 bg-surface">
    <div class="mx-auto max-w-4xl px-6 py-16 text-center md:py-20">
      <p data-animate="type-settle" class="text-lg leading-relaxed text-muted">
        Not ready for the twelve weeks? Our
        <a href="/free-course/" class="font-semibold text-accent underline underline-offset-4 hover:text-accent-hot">free interactive course</a>
        lets you experience building with AI first, for the price of an email.
      </p>
    </div>
  </section>

  <!-- The differentiator, allowed to interrupt. -->
  <section class="dark-band border-y border-ink/10">
    <div class="mx-auto max-w-6xl px-6 py-28 md:py-36">
      <h2 data-animate="type-settle" class="font-display text-4xl md:text-6xl">It is <span class="text-accent">your</span> account</h2>
      <div class="mt-8 grid max-w-4xl gap-8 md:grid-cols-2">
        <p data-animate="type-settle" data-animate-delay="0.1" class="text-lg leading-relaxed text-muted">
          Everything the program builds lives in accounts you own. Your Claude
          subscription, around twenty dollars a month, paid to Anthropic on your
          own card. Your data, your files, your workflows. If you walked away
          the day the program ended, all of it would keep working.
        </p>
        <p data-animate="type-settle" data-animate-delay="0.2" class="text-lg leading-relaxed text-muted">
          We do not sell seats, share logins, or sit between you and your tools.
          That is not a courtesy, it is the design, and it is the same way we
          hand over the code on every website we build.
        </p>
      </div>
    </div>
  </section>

  <!-- Proof: shipped work, not hypotheticals. -->
  <section class="mx-auto max-w-6xl px-6 py-24 md:py-32">
    <h2 data-animate="type-settle" class="font-display text-3xl md:text-5xl">Built and shipped, not hypothetical</h2>
    <p data-animate="type-settle" data-animate-delay="0.1" class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
      Every workflow taught in the program is one Alex has already built and
      runs, the same work our
      <a href="/services/ai-integration/" class="text-accent underline underline-offset-4 hover:text-accent-hot">AI integration service</a>
      ships for clients. A few that are live right now:
    </p>
    <!-- Hover a card and it demonstrates itself: the chat card draws an
         arrow to the real Kai in the corner, the dashboard and content
         cards pop illustrated panels (numbers invented and labeled so),
         and the voice card grows a button that actually opens Kai. -->
    <div class="mt-12 grid gap-8 md:grid-cols-2">
      {outcomes.map((o, i) => (
        <div data-animate="frame-lift" data-demo={['chat', 'dash', 'voice', 'content'][i]} class="al-card glow-frame relative flex flex-col p-8">
          <svg class="al-glyph mb-5 h-10 w-10 text-accent" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={o.icon} />
          </svg>
          <p class="flex-1 text-lg leading-relaxed">{o.what}</p>
          <p class="mt-5 font-mono text-xs uppercase tracking-[0.2em] text-accent">{o.where}</p>

          {i === 1 && (
            <div class="al-pop" aria-hidden="true">
              <p class="al-pop-kicker">Today &middot; example numbers</p>
              <div class="al-pop-strip">
                <span>Outstanding <b>$3,250</b></span>
                <span>Overdue <b>$1,450</b></span>
              </div>
              <div class="al-pop-row al-pop-hot"><i>Overdue 12d</i><span>Riverside Clinic &middot; $1,450 &middot; chase it</span></div>
              <div class="al-pop-row al-pop-warm"><i>Retainer</i><span>BlueOak Landscaping &middot; $600 arrived</span></div>
              <div class="al-pop-row al-pop-warm"><i>Promise</i><span>Send the mockups &middot; due today</span></div>
            </div>
          )}

          {i === 2 && (
            <button type="button" id="al-kai-btn" class="al-kai-btn font-heading text-sm font-semibold tracking-wide">
              <span class="al-kai-dot" aria-hidden="true"></span>
              Click to chat with Kai
            </button>
          )}

          {i === 3 && (
            <div class="al-pop" aria-hidden="true">
              <p class="al-pop-kicker">Newsletter &middot; example numbers</p>
              <div class="al-pop-strip">
                <span>Subscribers <b>145</b></span>
                <span>Unsubscribed <b>8</b></span>
                <span>Last signup <b>Aug 27</b></span>
              </div>
              <div class="al-pop-row al-pop-warm"><i>Sent</i><span>One useful thing about intake forms &middot; to 137</span></div>
              <div class="al-pop-btns">
                <span class="al-pop-cta">Compose</span>
                <span class="al-pop-ghost">Past sends</span>
              </div>
            </div>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- The bundle -->
  <section class="border-t border-ink/10 bg-surface">
    <div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
      <div class="grid gap-12 lg:grid-cols-[1fr_0.9fr] lg:gap-16">
        <div>
          <h2 data-animate="type-settle" class="font-display text-3xl md:text-5xl">Add the site. <span class="text-accent">$3,999 for both.</span></h2>
          <p data-animate="type-settle" data-animate-delay="0.1" class="mt-6 text-lg leading-relaxed text-muted">
            The same twelve weeks, with a full custom site built alongside them.
            That is our $2,500 custom build plus the $2,000 Launch, with $500
            off for taking both together.
          </p>
          <p data-animate="type-settle" data-animate-delay="0.2" class="mt-6 text-lg leading-relaxed text-muted">
            We build the site. A website is a once-in-five-years artifact, so it
            gets built to our standard, accessibility included, rather than
            co-built as a teaching exercise. What the sessions teach is the
            layer you will actually touch every week: updating your own copy,
            handling the inquiries the site brings in, writing new pages, and
            reading what is working.
          </p>
          <div data-animate="type-settle" data-animate-delay="0.3" class="mt-8">
            <a href="#apply" class="btn-draw" data-pick="Launch + Site, $3,999">Start Launch + Site</a>
          </div>
        </div>
        <div data-animate="frame-lift" class="glow-frame self-start p-8 md:p-10">
          <p class="font-mono text-xs uppercase tracking-[0.25em] text-accent">What you finish with</p>
          <ul class="mt-6 space-y-4 text-lg leading-relaxed">
            <li>A workflow running in your business that was not there before</li>
            <li>A handoff doc and recorded walkthroughs of everything built</li>
            <li>A written plan for what to build next</li>
            <li>The ability to run all of it without us</li>
            <li class="border-t border-ink/10 pt-4 text-muted">With the bundle: a custom site, built and handed over the way we hand over every build</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- The top rung: the apprenticeship, and the page's second dark moment.
       Espresso rather than the teal of the ownership band, so the two dark
       passages read as different rooms. Alex still builds the site (the
       quality authorship never moves), but the client is in the room for
       every decision. Bottom of the stack by placement, top by price. -->
  <section class="al-espresso border-y border-ink/10">
    <div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
      <div class="grid items-center gap-12 lg:grid-cols-[1fr_0.85fr] lg:gap-16">
        <div>
          <p data-animate="type-settle" class="font-mono text-sm uppercase tracking-[0.3em] text-amber">For the few</p>
          <h2 data-animate="type-settle" data-animate-delay="0.1" class="mt-6 font-display text-3xl md:text-5xl">Build yours alongside Alex. <span class="text-amber">From $10,000.</span></h2>
          <p data-animate="type-settle" data-animate-delay="0.2" class="mt-6 text-lg leading-relaxed text-muted">
            The apprenticeship version. Alex builds your full custom
            AI-integrated site to the studio standard, and you are there for
            all of it: every working session, every decision, every
            integration. You learn to use AI day to day, to build with it,
            and to wire in the APIs your business runs on, on the real
            project instead of a toy.
          </p>
          <p data-animate="type-settle" data-animate-delay="0.3" class="mt-6 leading-relaxed text-muted">
            You finish with the site, and with something rarer: you know how
            it works, deep enough to extend it yourself. Everything lives in
            your own accounts, same as always. From $10,000, scoped to what
            your build actually is; the first call is where that number gets
            honest.
          </p>
          <div data-animate="type-settle" data-animate-delay="0.4" class="mt-10">
            <a href="#apply" class="btn-draw" data-pick="Build Alongside, from $10,000">Talk about building alongside</a>
          </div>
        </div>
        <!-- Two terminals, one desk: the apprenticeship drawn in the site's
             sketch line. Draws itself in as the band arrives. -->
        <svg
          id="al-desk-sketch"
          class="hidden w-full text-[#8a7d6e] lg:block"
          viewBox="0 0 640 400"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <!-- the desk -->
          <line x1="20" y1="330" x2="620" y2="330" />
          <line x1="70" y1="330" x2="60" y2="392" />
          <line x1="570" y1="330" x2="580" y2="392" />
          <!-- Alex's terminal -->
