  }
  @media (prefers-reduced-motion: reduce) {
    .al-pop, .al-kai-btn { transition: none; }
    .al-kai-dot { animation: none; }
  }

  /* The straight-answers accordion. Panels are height-animated by the
     script; these are the resting looks. The rule inside each answer is
     drawn (scaleY) as its panel opens. */
  .al-acc-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    text-align: left;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--color-ink);
    padding: 1.35rem 0.25rem;
    transition: color var(--dur-fast) var(--ease-out-expo);
  }
  .al-acc-item.is-open .al-acc-btn,
  .al-acc-btn:hover {
    color: var(--color-accent);
  }
  .al-acc-ind {
    width: 1rem;
    height: 1rem;
    flex: none;
    color: var(--color-accent);
    transition: transform 0.45s var(--ease-out-expo);
  }
  .al-acc-item.is-open .al-acc-ind {
    transform: rotate(135deg);
  }
  .al-acc-panel {
    height: 0;
    overflow: hidden;
