  .al-week-major .al-num {
    color: var(--color-accent);
    font-weight: 600;
  }
  .al-week-major .al-tick {
    height: 1.4rem;
    background: var(--color-accent);
  }
  /* The second dark moment: espresso, not teal, so the ownership band and
     the apprenticeship read as different rooms. Amber is the accent that
     survives on espresso; rust does not. */
  .al-espresso {
    --color-canvas: #221C15;
    --color-surface: #2B241C;
    --color-ink: #F5EFE7;
    --color-muted: #B3A695;
    --color-accent: #D97706;
    --color-accent-hot: #F59E0B;
    background: linear-gradient(180deg, #1D1710 0%, #2B241C 100%);
    color: var(--color-ink);
  }

  /* The premium CTA: editorial rectangle, not a pill. A quiet border at
     rest; on hover the amber sweeps in from the left and the text goes
     espresso. Used only at the four lead-capture moments on this page. */
  .btn-draw {
    position: relative;
    display: inline-block;
    isolation: isolate;
    overflow: hidden;
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
    border: 1.5px solid currentColor;
    border-radius: 2px;
    padding: 0.95rem 1.9rem;
    transition: color var(--dur-fast) var(--ease-out-expo);
  }
  .btn-draw::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-amber, #D97706);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--dur-fast) var(--ease-out-expo);
  }
  .btn-draw:hover {
    color: #221C15;
    border-color: var(--color-amber, #D97706);
  }
  .btn-draw:hover::before {
    transform: scaleX(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .btn-draw::before { transition: none; }
  }

  /* Hover demonstrations on the outcome cards. Pointer devices only: on
     touch the cards stay plain, which is the honest fallback. The mock
     panels are labeled "example numbers" in their own kicker so an
     illustration can never be mistaken for a record. */
  /* glow-frame clips overflow for its media children; these cards hold
     only text, and their popups need to escape the frame. */
  .al-card {
    overflow: visible;
  }
  .al-pop {
    position: absolute;
    right: 1rem;
    bottom: calc(100% - 1.25rem);
    z-index: 30;
    width: 20rem;
    max-width: calc(100% - 2rem);
    background: var(--color-surface);
    border: 1px solid rgb(34 28 21 / 0.14);
    border-radius: 10px;
    box-shadow: 0 18px 40px rgb(34 28 21 / 0.16);
    padding: 1rem 1.1rem;
    opacity: 0;
    transform: translateY(10px) rotate(-1.5deg) scale(0.98);
    pointer-events: none;
    transition: opacity var(--dur-fast) var(--ease-out-expo), transform var(--dur-fast) var(--ease-out-expo);
  }
  @media (hover: hover) and (min-width: 768px) {
    .al-card:hover .al-pop,
    .al-card:focus-within .al-pop {
      opacity: 1;
      transform: translateY(0) rotate(0deg) scale(1);
