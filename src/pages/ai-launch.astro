<script>
  // Attribution read. The write happens sitewide in BaseLayout (first touch
  // wins there, whatever page the ?src= link landed on); this page only
  // copies the stored value into the hidden field. Kept in its own module,
  // fully guarded: a malformed cookie must never take the form's submit
  // handler down with it. The field defaults to "direct" server-side, so
  // no JS means no false attribution either way.
  try {
    const raw =
      document.cookie.match(/(?:^|;\s*)ka_src=([^;]+)/)?.[1] ??
      new URLSearchParams(location.search).get('src');
    let src = raw;
    try {
      src = raw ? decodeURIComponent(raw) : raw;
    } catch {
      /* keep the raw value */
    }
    const sourceField = document.getElementById('al-source') as HTMLInputElement | null;
    if (src && sourceField) sourceField.value = src;
  } catch {
    /* attribution is best-effort; the form must work regardless */
  }
</script>

<script>
  // Product lead buttons: every tier's button carries data-pick with its
  // exact select option. Clicking pre-selects the tier, reveals the
  // current-website field for the two site tiers, and lands focus on the
  // form. ?p=launch|bundle|alongside does the same for future ad links.
  const PICKS: Record<string, string> = {
    launch: 'The Launch, $2,000',
    bundle: 'Launch + Site, $3,999',
    alongside: 'Build Alongside, from $10,000',
  };
  const interestSel = document.getElementById('al-interest') as HTMLSelectElement | null;
  const siteWrap = document.getElementById('al-site-wrap');

  const syncSiteField = () => {
    const v = interestSel?.value ?? '';
    const wants = v.includes('Site') || v.includes('Alongside');
    siteWrap?.classList.toggle('hidden', !wants);
  };

  const pick = (value: string, scroll: boolean) => {
    if (interestSel && [...interestSel.options].some((o) => o.value === value || o.text === value)) {
      interestSel.value = value;
    }
    syncSiteField();
    if (scroll) {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.getElementById('apply')?.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth' });
      (document.getElementById('al-name') as HTMLInputElement | null)?.focus({ preventScroll: true });
    }
  };

  document.querySelectorAll<HTMLAnchorElement>('[data-pick]').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      pick(a.dataset.pick!, true);
    });
  });
  interestSel?.addEventListener('change', syncSiteField);

  const p = new URLSearchParams(location.search).get('p');
  if (p && PICKS[p]) pick(PICKS[p], location.hash === '#apply');
  syncSiteField();
</script>

<script>
  // Intake submit: same Web3Forms flow as the contact page.
  const form = document.getElementById('al-form') as HTMLFormElement | null;
  const successEl = document.getElementById('al-success');
  const errorEl = document.getElementById('al-error');
  const statusEl = document.getElementById('al-status');
  const btn = document.getElementById('al-submit') as HTMLButtonElement | null;

  if (form && btn) {
    const original = btn.textContent;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      errorEl?.classList.add('hidden');
      btn.disabled = true;
      btn.textContent = 'Sending…';
      if (statusEl) statusEl.textContent = 'Sending your message…';

      const data: Record<string, string> = {};
      new FormData(form).forEach((value, key) => {
        data[key] = String(value);
      });
      // The tier rides the subject line so the inbox triages itself:
      // "New lead: Launch + Site, $3,999 | ka-performancefl.com".
      if (data.interested_in && data.interested_in !== 'Not sure yet') {
        data.subject = `New lead: ${data.interested_in} | ka-performancefl.com`;
      }

      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        const result = await res.json();

        if (result.success) {
          // Success path only; guarded because ad blockers stop fbq existing.
          if (window.fbq) window.fbq('track', 'Lead');
          if (statusEl) statusEl.textContent = '';
          form.classList.add('hidden');
          successEl?.classList.remove('hidden');
          successEl?.classList.add('flex');
          (successEl as HTMLElement | null)?.focus();
        } else {
          throw new Error(result.message || 'Submission failed');
        }
      } catch {
        if (statusEl) statusEl.textContent = '';
        errorEl?.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = original;
        (errorEl as HTMLElement | null)?.focus();
      }
    });
  }
</script>

<script>
  // The chat card's arrow: hover draws a sketch-line from the card to the
  // real Kai orb in the corner, because the fastest proof the assistant
  // exists is pointing at it. Pointer devices only; pure decoration, so
  // keyboard users lose nothing.
  import gsap from 'gsap';

  const fine = window.matchMedia('(hover: hover) and (min-width: 768px)').matches;
  const noMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const chatCard = document.querySelector('[data-demo="chat"]');
  const orb = document.getElementById('sg-open');

  if (fine && chatCard && orb) {
    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.setAttribute('aria-hidden', 'true');
    svg.style.cssText = 'position:fixed;inset:0;width:100vw;height:100vh;pointer-events:none;z-index:45;opacity:0;';
    const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    const head = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    for (const el of [path, head]) {
      el.setAttribute('fill', 'none');
      el.setAttribute('stroke', '#9A3412');
      el.setAttribute('stroke-width', '1.75');
      el.setAttribute('stroke-linecap', 'round');
      el.setAttribute('stroke-linejoin', 'round');
    }
    svg.append(path, head);
    document.body.appendChild(svg);

    let tween: gsap.core.Tween | null = null;

    chatCard.addEventListener('mouseenter', () => {
      const c = chatCard.getBoundingClientRect();
      const o = orb.getBoundingClientRect();
      const sx = c.right - 24;
      const sy = c.top + c.height * 0.55;
      const ex = o.left - 14;
      const ey = o.top + o.height * 0.3;
      // one easy curve that swings low, like a hand gesturing "down there"
      const mx = sx + (ex - sx) * 0.45;
      const my = Math.max(sy, ey) + 60;
      path.setAttribute('d', `M ${sx} ${sy} Q ${mx} ${my} ${ex} ${ey}`);
      // arrowhead from the end tangent
      const ang = Math.atan2(ey - my, ex - mx);
      const a1 = ang + Math.PI * 0.82;
      const a2 = ang - Math.PI * 0.82;
      head.setAttribute('d', `M ${ex + Math.cos(a1) * 12} ${ey + Math.sin(a1) * 12} L ${ex} ${ey} L ${ex + Math.cos(a2) * 12} ${ey + Math.sin(a2) * 12}`);
      svg.style.opacity = '1';
      orb.classList.add('sg-nudge');
      if (!noMotion) {
        const len = path.getTotalLength();
        path.style.strokeDasharray = String(len);
        path.style.strokeDashoffset = String(len);
        head.style.opacity = '0';
        tween?.kill();
        tween = gsap.to(path, {
          strokeDashoffset: 0,
          duration: 0.55,
          ease: 'power2.out',
          onComplete: () => gsap.to(head, { opacity: 1, duration: 0.15 }),
        });
      } else {
        path.style.strokeDasharray = '';
        head.style.opacity = '1';
      }
    });
    chatCard.addEventListener('mouseleave', () => {
      tween?.kill();
      svg.style.opacity = '0';
      orb.classList.remove('sg-nudge');
    });
  }

  // The voice card's button opens the real corner chat.
  document.getElementById('al-kai-btn')?.addEventListener('click', () => {
    document.getElementById('sg-open')?.click();
  });

  // Straight-answers accordion: exactly one open at a time. Hover peeks,
  // click pins (that one survives the mouse leaving), Enter pins for
  // keyboard users. Reduced motion gets instant open/close, no spring.
  {
    const acc = document.getElementById('al-acc');
    const items = acc ? [...acc.querySelectorAll<HTMLElement>('.al-acc-item')] : [];
    const canHover = window.matchMedia('(hover: hover)').matches;
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let pinned: HTMLElement | null = null;
    let current: HTMLElement | null = null;

    const setOpen = (item: HTMLElement, open: boolean) => {
      const panel = item.querySelector<HTMLElement>('.al-acc-panel')!;
      const btn = item.querySelector<HTMLElement>('.al-acc-btn')!;
      const body = item.querySelector<HTMLElement>('.al-acc-body')!;
      item.classList.toggle('is-open', open);
      btn.setAttribute('aria-expanded', String(open));
      if (still) {
        panel.style.height = open ? 'auto' : '0px';
        return;
      }
      gsap.killTweensOf([panel, body]);
      if (open) {
        gsap.fromTo(panel, { height: panel.offsetHeight }, {
          height: body.offsetHeight,
          duration: 0.5,
          ease: 'power3.out',
          onComplete: () => { panel.style.height = 'auto'; },
        });
        gsap.fromTo(body, { y: 14, opacity: 0 }, { y: 0, opacity: 1, duration: 0.45, ease: 'back.out(1.6)', delay: 0.08 });
      } else {
        gsap.to(panel, { height: 0, duration: 0.38, ease: 'power3.inOut' });
      }
    };

    const show = (item: HTMLElement | null) => {
      if (item === current) return;
      if (current) setOpen(current, false);
      current = item;
      if (item) setOpen(item, true);
    };

    items.forEach((item) => {
      const btn = item.querySelector<HTMLElement>('.al-acc-btn')!;
      if (canHover) {
        btn.addEventListener('mouseenter', () => show(item));
      }
      btn.addEventListener('click', () => {
        if (pinned === item && current === item) {
          pinned = null;
          show(null);
        } else {
          pinned = item;
          show(item);
        }
      });
    });
    acc?.addEventListener('mouseleave', () => {
      if (current !== pinned) show(pinned);
    });
  }
</script>

<script>
  // Motion, front-page style: the hero sketch draws itself on load, and the
  // twelve-week rail draws scrubbed to the scroll with the dot riding it.
  // Skipped entirely under reduced motion: everything is authored visible,
  // gsap only animates FROM states, so the static page is the finished one.
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isDesktop = window.matchMedia('(min-width: 1024px)').matches;

  if (!reduced) {
    gsap.registerPlugin(ScrollTrigger);

    // Hero sketch: stroke-by-stroke draw on load, same treatment as the home
    // page's act-0 window. Desktop only; the element is hidden below lg.
    const sketch = document.getElementById('al-hero-sketch');
    if (sketch && isDesktop) {
      const strokes = [...sketch.querySelectorAll('path, line, rect, circle')];
      strokes.forEach((p) => {
        const len = p.getTotalLength ? p.getTotalLength() : 800;
        p.style.strokeDasharray = String(len);
        p.style.strokeDashoffset = String(len);
      });
      gsap.to(strokes, {
        strokeDashoffset: 0,
        duration: 1.1,
        stagger: 0.05,
        ease: 'power1.inOut',
        delay: 0.3,
      });
    }

    // Line-drawn glyphs and the desk sketch draw themselves in as they
    // arrive. Same helper treatment as the hero: measure, offset, release.
    const drawIn = (el: Element, delay = 0) => {
      const strokes = [...el.querySelectorAll('path, line, rect, circle')];
      strokes.forEach((s) => {
        const len = (s as SVGGeometryElement).getTotalLength ? (s as SVGGeometryElement).getTotalLength() : 300;
        (s as SVGElement).style.strokeDasharray = String(len);
        (s as SVGElement).style.strokeDashoffset = String(len);
      });
      gsap.to(strokes, {
        strokeDashoffset: 0,
        duration: 0.9,
        stagger: 0.06,
        ease: 'power1.inOut',
        delay,
        scrollTrigger: { trigger: el, start: 'top 88%' },
      });
    };
    document.querySelectorAll('.al-glyph').forEach((g) => drawIn(g));
    const desk = document.getElementById('al-desk-sketch');
    if (desk && isDesktop) drawIn(desk, 0.2);

    // The rail is scrubbed rather than one-shot: scroll draws the weeks in
    // and carries the dot from week one to week twelve, and scrolling back
    // rewinds it. Motion with meaning: the page is about a timeline.
    const track = document.getElementById('al-track');
    if (track) {
      gsap.timeline({
        scrollTrigger: { trigger: track, start: 'top 88%', end: 'top 35%', scrub: 0.7 },
      })
        .from(track.querySelector('.al-rail'), { scaleX: 0, ease: 'none', duration: 1 }, 0)
        .from(track.querySelector('.al-dot'), { left: '0%', ease: 'none', duration: 1 }, 0)
        .from(track.querySelectorAll('.al-tick'), { scaleY: 0, transformOrigin: 'bottom', duration: 0.3, stagger: 0.055, ease: 'none' }, 0.05)
        .from(track.querySelectorAll('.al-num'), { y: 8, opacity: 0, duration: 0.3, stagger: 0.055, ease: 'none' }, 0.1);
    }
  }
</script>


<script>
  // Week-one demo: one question in, a three-line opportunity sketch out,
  // then straight into the intake form with the answer carried over.
  const mapForm = document.getElementById('al-map-form') as HTMLFormElement | null;
  const mapInput = document.getElementById('al-map-input') as HTMLInputElement | null;
  const mapBtn = document.getElementById('al-map-btn') as HTMLButtonElement | null;
  const mapOut = document.getElementById('al-map-out');
  const mapNote = document.getElementById('al-map-note');
  const mapError = document.getElementById('al-map-error');
  const mapStatus = document.getElementById('al-map-status');

  if (mapForm && mapInput && mapBtn) {
    const original = mapBtn.textContent;

    mapForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const week = mapInput.value.trim();
      if (week.length < 3) {
        mapInput.focus();
        return;
      }

      mapOut?.classList.add('hidden');
      mapNote?.classList.add('hidden');
      mapError?.classList.add('hidden');
      mapBtn.disabled = true;
      mapBtn.textContent = 'Sketching…';
      if (mapStatus) mapStatus.textContent = 'Kai is sketching your launch…';

      try {
        const res = await fetch('/api/launchmap', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ week }),
        });
        const data = await res.json();
        if (mapStatus) mapStatus.textContent = '';

        if (res.ok && data.fit === true) {
          document.getElementById('al-map-workflow')!.textContent = data.workflow;
          document.getElementById('al-map-quickwin')!.textContent = data.quickWin;
          document.getElementById('al-map-week9')!.textContent = data.week9;
          mapOut?.classList.remove('hidden');
          (mapOut as HTMLElement | null)?.focus();
        } else if (res.ok && data.fit === false) {
          if (mapNote) {
            mapNote.textContent = data.note;
            mapNote.classList.remove('hidden');
            mapNote.focus();
          }
        } else {
          throw new Error('unavailable');
        }
      } catch {
        if (mapStatus) mapStatus.textContent = '';
        mapError?.classList.remove('hidden');
        (mapError as HTMLElement | null)?.focus();
      } finally {
        mapBtn.disabled = false;
        mapBtn.textContent = original;
      }
    });

    // Hand the answer to the real form: the demo asked the intake's
    // qualifying question, so nobody should have to type it twice.
    document.getElementById('al-map-apply')?.addEventListener('click', () => {
      const weekField = document.getElementById('al-week') as HTMLTextAreaElement | null;
      if (weekField && !weekField.value.trim()) weekField.value = mapInput.value.trim();
      const apply = document.getElementById('apply');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      apply?.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth' });
      weekField?.focus({ preventScroll: true });
    });
  }
</script>
