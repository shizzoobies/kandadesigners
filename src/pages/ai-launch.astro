  }

  /* The Kai button on the voice card: rises in on hover or keyboard focus,
     and genuinely opens the corner chat. */
  .al-kai-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.1rem;
    align-self: flex-start;
    color: var(--color-accent);
    border: 1.5px solid currentColor;
    border-radius: 2px;
    padding: 0.55rem 1.1rem;
