  <!-- Intake -->
  <section id="apply" class="scroll-mt-28 border-t border-ink/10">
    <div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1fr] lg:gap-16">
