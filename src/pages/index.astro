---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroGallery from '../components/HeroGallery.astro';
import ReviewsRail from '../components/ReviewsRail.astro';
import HomeWork from '../components/home/HomeWork.astro';
import HomeAiDemo from '../components/home/HomeAiDemo.astro';
import HomeAccessibility from '../components/home/HomeAccessibility.astro';
import HomeLaunch from '../components/home/HomeLaunch.astro';
import HomeArtistry from '../components/home/HomeArtistry.astro';
import HomeTraining from '../components/home/HomeTraining.astro';
import HomeStudio from '../components/home/HomeStudio.astro';
---
<BaseLayout
  title="Gainesville Web Design & AI Integration | K & A Performance"
  description="A Gainesville web design and AI integration studio building fast, accessible sites for businesses that refuse to blend in. Quotes are always free."
>
  <HeroGallery />
  <HomeWork />
  <HomeAiDemo />
  <HomeAccessibility />
  <HomeLaunch />
  <HomeArtistry />
  <HomeTraining />
  <HomeStudio />
  <ReviewsRail />
  <section class="home-close" aria-labelledby="home-close-title">
    <p class="close-label">What would make work easier?</p>
    <h2 id="home-close-title">Let’s build<br /><span>something useful.</span></h2>
    <p>A website, a workflow, or a better way to teach your team. Tell us where you want to go.</p>
    <a href="/contact/#scope" class="btn-accent">Start a project</a>
    <span class="close-note">Quotes are always free.</span>
    <nav aria-label="Explore our services"><a href="/services/web-design/">Web design</a><a href="/services/ai-integration/">AI integration</a><a href="/services/seo-ai-search/">SEO &amp; AI search</a><a href="/services/accessibility/">Accessibility</a></nav>
  </section>
</BaseLayout>
<style>
  .home-close{max-width:1152px;margin:auto;padding:80px 24px 104px;text-align:center;border-top:1px solid #221c1525}.close-label{font-family:var(--font-mono);font-size:.7rem;letter-spacing:.13em;text-transform:uppercase;color:var(--color-accent);margin-bottom:24px}.home-close h2{font-family:var(--font-display);font-size:clamp(2.75rem,6vw,5.5rem);line-height:1.04;font-weight:700;letter-spacing:-.035em}.home-close h2 span{color:var(--color-accent)}.home-close>p:not(.close-label){max-width:460px;margin:26px auto;font-size:1.12rem;line-height:1.6;color:var(--color-muted)}.close-note{display:block;margin:17px 0 45px;font-size:.85rem;color:var(--color-muted)}.home-close nav{display:flex;justify-content:center;flex-wrap:wrap;gap:16px 28px}.home-close nav a{font-size:.88rem;text-decoration:underline;text-underline-offset:5px;color:var(--color-accent)}
</style>
