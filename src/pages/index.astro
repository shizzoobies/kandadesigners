---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroGallery from '../components/HeroGallery.astro';
---
<BaseLayout
  title="K & A Performance | Web Design & AI Integration"
  description="K & A Performance crafts fast, animated, AI-ready websites for businesses that refuse to blend in."
>
  <!-- Hero and work gallery are one scroll-driven piece: the sloppy stack
       of client sites sweeps into the 3D horseshoe as you scroll. -->
  <HeroGallery />

  <!-- Accessibility promise: the differentiator, stated plainly. -->
  <section class="mx-auto max-w-6xl px-6 py-28">
    <h2 data-animate="type-settle" class="font-display text-4xl md:text-6xl">Accessible <span class="text-accent italic">by default.</span></h2>
    <p data-animate="type-settle" data-animate-delay="0.1" class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
      Every build is measured against WCAG AA: contrast, keyboard, screen
      readers, motion preferences. Already have a site? We'll check it and
      tell you exactly where it stands.
    </p>
    <div data-animate="type-settle" data-animate-delay="0.2" class="mt-8">
      <a href="/services/#svc-a11y" class="btn-ghost">Get an accessibility check</a>
    </div>
  </section>

  <!-- AI section: the one deliberate dark moment on the light site — and it breathes. -->
  <section class="dark-band ai-alive ai-alive-dark border-y border-ink/10">
    <div class="mx-auto max-w-6xl px-6 py-32">
      <h2 data-animate="type-settle" class="font-display text-4xl md:text-6xl">Sites that <span class="ai-pulse text-accent italic">think.</span></h2>
      <p data-animate="type-settle" data-animate-delay="0.1" class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
        We integrate AI where it earns its place: assistants that qualify leads,
        content engines, smart search. Ours is live right now:
      </p>
      <div data-animate="type-settle" data-animate-delay="0.2" class="mt-10">
        <a href="/contact/#scope" class="btn-accent">Scope your project with our AI</a>
      </div>
    </div>
  </section>

  <!-- Artists teaser -->
  <section class="mx-auto max-w-6xl px-6 py-32">
    <h2 data-animate="type-settle" class="font-display text-4xl md:text-6xl">In-house artistry</h2>
    <p data-animate="type-settle" data-animate-delay="0.1" class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
      Original illustration and artwork through our collaborating artists. No stock, ever.
    </p>
    <div class="mt-14 grid gap-10 md:grid-cols-2">
      <a href="/artists/artist-one/" class="group block" data-animate="frame-lift">
        <figure class="glow-frame transition-transform duration-300 group-hover:-translate-y-1">
          <img src="/images/art/a1-magnolia.jpg" alt="Artist One, watercolor magnolia study, portfolio preview" class="aspect-[4/3] w-full object-cover" loading="lazy" />
        </figure>
        <h3 class="mt-4 font-heading text-lg tracking-wide">Artist One</h3>
        <p class="mt-1 text-sm text-muted">Illustration &amp; brand artwork</p>
      </a>
      <a href="/artists/artist-two/" class="group block" data-animate="frame-lift">
        <figure class="glow-frame transition-transform duration-300 group-hover:-translate-y-1">
          <img src="/images/art/a2-abstract-face.png" alt="Artist Two, abstract geometric face composition, portfolio preview" class="aspect-[4/3] w-full object-cover" loading="lazy" />
        </figure>
        <h3 class="mt-4 font-heading text-lg tracking-wide">Artist Two</h3>
        <p class="mt-1 text-sm text-muted">Digital art &amp; visual identity</p>
      </a>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="px-6 pb-40 pt-16">
    <div class="mx-auto max-w-4xl text-center">
      <p data-animate="type-settle" class="font-display text-[clamp(2.5rem,6vw,5rem)] leading-[1.05]">
        Your site should work hard, <span class="text-accent italic">so you don't have to.</span>
      </p>
      <div data-animate="type-settle" data-animate-delay="0.15" class="mt-10">
        <a href="/contact/#scope" class="btn-accent">Start a project</a>
      </div>
    </div>
  </section>
</BaseLayout>
