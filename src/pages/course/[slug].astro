---
// Keep previously shared chapter links working with the replacement lesson.
const destinations = {
  introduction: 'direction', install: 'setup', 'sign-in': 'setup',
  'first-request': 'plan', connect: 'context', 'build-a-website': 'next',
  'build-a-lesson': 'next', 'build-an-app': 'next', recap: 'next',
};
export function getStaticPaths() {
  return Object.keys({ introduction: 1, install: 1, 'sign-in': 1, 'first-request': 1, connect: 1, 'build-a-website': 1, 'build-a-lesson': 1, 'build-an-app': 1, recap: 1 }).map(slug => ({ params: { slug } }));
}
const chapter = destinations[Astro.params.slug as keyof typeof destinations];
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Continue the Course | K &amp; A Performance</title><meta name="robots" content="noindex,nofollow" /><link rel="canonical" href="https://ka-performancefl.com/course/" /></head>
<body><p>The course has a new home. <a href={`/course/?chapter=${chapter}`}>Continue the lesson</a>.</p>
<script is:inline define:vars={{ chapter }}>
  const target = new URL('/course/', location.origin);
  target.search = location.search;
  target.searchParams.set('chapter', chapter);
  location.replace(target.href);
</script></body></html>
