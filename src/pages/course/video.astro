---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = '/course-app/first-session';
const chapters = [
  { time: 0, label: 'You set the direction', display: '0:00' },
  { time: 64, label: 'Open your first project', display: '1:04' },
  { time: 145, label: 'Map before you change', display: '2:25' },
  { time: 212, label: 'Make a small plan', display: '3:32' },
  { time: 285, label: 'Check the result', display: '4:45' },
  { time: 363, label: 'Keep the session focused', display: '6:03' },
  { time: 447, label: 'Make the workflow yours', display: '7:27' },
];
---
<BaseLayout title="Your First Session: Video Guide | K & A Performance" description="Watch our narrated guide to a first project with Claude Code. Includes English captions, chapter shortcuts, a transcript, and a matching interactive lesson." noindex>
  <script is:inline src="/course-app/first-session/gate.js?v=20260922-ai"></script>
  <section class="mx-auto max-w-6xl px-6 pt-32 pb-16 md:pt-40">
    <a href="/training/ai/" class="text-accent underline underline-offset-4">Back to AI training</a>
    <p class="mt-8 font-mono text-xs uppercase tracking-[0.2em] text-muted">Video guide / 8 min 38 sec / AI narration</p>
    <h1 class="mt-5 font-display text-[clamp(2.3rem,5vw,4rem)] leading-tight">Your first session</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">A guided workflow for a small project with Claude Code. Watch through, or choose a chapter below. Pause whenever you want to practice.</p>
    <video id="training-video" class="mt-9 w-full bg-ink" controls playsinline preload="none" poster={`${base}/video/poster.jpg?v=20260922`} aria-label="Your first session with Claude Code video guide" width="1920" height="1080">
      <source src={`${base}/video/claude-code-first-session.mp4?v=20260922`} type="video/mp4" />
      <track default kind="captions" srclang="en" label="English" src={`${base}/video/claude-code-first-session.vtt?v=20260922`} />
      <p><a href={`${base}/video/claude-code-first-session.mp4`}>Download the video</a></p>
    </video>
    <p id="video-status" class="mt-3 text-muted" role="status"></p>
    <div class="video-details">
      <nav aria-label="Video chapters">
        <h2 class="font-display text-2xl">In this guide</h2>
        <ul class="mt-5 chapter-list">
          {chapters.map(chapter => <li><button type="button" data-video-time={chapter.time}><span class="font-mono text-sm text-accent">{chapter.display}</span><span>{chapter.label}</span></button></li>)}
        </ul>
      </nav>
      <aside>
        <h2 class="font-display text-2xl">Try it yourself</h2>
        <p class="mt-4 leading-relaxed text-muted">The interactive lesson adds guided exercises and saves your progress in this browser.</p>
        <a href="/course/" class="mt-5 inline-block text-accent underline underline-offset-4">Open the interactive lesson</a>
        <ul class="mt-8 space-y-4 text-accent">
          <li><a href={`${base}/downloads/reading-list-starter.zip`} download>Download starter project</a></li>
          <li><a href={`${base}/downloads/lesson-transcript.txt`} download>Read the transcript</a></li>
          <li><a href={`${base}/video/claude-code-first-session.mp4`} download>Download video</a></li>
          <li><a href={`${base}/video/claude-code-first-session.srt`} download>Download captions</a></li>
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>
<script>
  const video = document.getElementById('training-video') as HTMLVideoElement | null;
  const status = document.getElementById('video-status');
  document.querySelectorAll<HTMLButtonElement>('[data-video-time]').forEach(button => {
    button.addEventListener('click', () => {
      if (!video) return;
      const seek = () => {
        video.currentTime = Number(button.dataset.videoTime);
        video.play().catch(() => { if (status) status.textContent = 'Press play on the video to continue.'; });
      };
      if (video.readyState >= 1) seek();
      else { video.addEventListener('loadedmetadata', seek, { once: true }); video.load(); }
      if (status) status.textContent = `Selected chapter: ${Array.from(button.querySelectorAll('span'), span => span.textContent).join(' ')}`;
      video.focus({ preventScroll: true });
    });
  });
  video?.addEventListener('error', () => { if (status) status.textContent = 'The video could not load. Try reloading this page or use the download link below.'; });
</script>
<style>
  video { aspect-ratio: 16 / 9; height: auto; border: 8px solid var(--color-ink); border-radius: 10px; box-shadow: 0 12px 30px rgb(34 28 21 / .15); }
  @media (max-width: 650px) { video { border-width: 5px; border-radius: 7px; } }
  .video-details { display: grid; gap: 2.5rem; margin-top: 2.5rem; }
  .chapter-list li { border-top: 1px solid rgb(34 28 21 / .15); }
  .chapter-list button { width: 100%; display: flex; align-items: center; gap: 1.2rem; padding: .95rem .25rem; text-align: left; cursor: pointer; }
  .chapter-list button:hover { color: var(--color-accent); }
  aside a { text-decoration: underline; text-underline-offset: .25em; }
  @media (min-width: 768px) { .video-details { grid-template-columns: 1.4fr 1fr; gap: 4rem; } }
</style>
