---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sections, chapters, chapterBySlug } from '../../data/course.js';

// The course home: a gated table of contents drawn as a journey. One
// vertical rail runs the length of the course; each chapter is a node on
// it, filled with a check once done. No numbered kickers anywhere: the
// rail IS the position. _headers keeps /course/* unindexed; /free-course/
// is the page that ranks.
---
<BaseLayout
  title="The Free Course | K & A Performance"
  description="Nine hands-on chapters: install Claude Code, sign in, connect your tools, and build a website, a lesson, and an app. Free with your email."
>
  <section class="mx-auto max-w-4xl px-6 pt-36 pb-10 md:pt-44">
    <p data-animate="type-settle" class="font-mono text-sm uppercase tracking-[0.3em] text-muted">The free course</p>
    <h1 data-animate="type-settle" data-animate-delay="0.1" class="mt-6 font-display text-[clamp(2.4rem,6vw,4.5rem)] leading-[1.05]">
      Getting to know <span class="text-accent">Claude Code</span>
    </h1>
    <p data-animate="type-settle" data-animate-delay="0.2" class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
      Nine hands-on chapters. Go in order the first time; every chapter
      remembers your name, your role, and your operating system, and the
      assistant inside each one answers questions as you go.
    </p>
    <p id="course-resume" class="mt-4 hidden text-sm text-muted" aria-live="polite"></p>
  </section>

  <section class="mx-auto max-w-4xl px-6 pb-32">
    <div id="course-path" class="relative">
      <!-- the rail: drawn by scroll, sitting behind the nodes -->
      <span id="course-rail" class="pointer-events-none absolute bottom-6 left-[1.05rem] top-2 w-px bg-ink/15" aria-hidden="true"></span>

      {sections.map((s) => (
        <div class="course-section">
          <h2 data-animate="type-settle" class="relative mt-12 mb-6 pl-12 font-display text-2xl first:mt-0 md:text-3xl">{s.title}</h2>
          <div class="flex flex-col gap-3">
            {s.slugs.map((slug) => {
              const c = chapterBySlug(slug);
              return (
                <a href={`/course/${c.slug}/`} data-chapter={c.slug} class="course-row group relative flex items-start gap-5 rounded-lg py-4 pl-12 pr-4 transition-colors hover:bg-surface">
                  <!-- node: hollow until done, then accent with a drawn check -->
                  <span class="course-node absolute left-2 top-1/2 flex h-5 w-5 -translate-y-1/2 items-center justify-center rounded-full border-2 border-ink/25 bg-canvas transition-colors" aria-hidden="true">
                    <svg class="course-check hidden h-3 w-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m2.5 6.5 2.5 2.5 4.5-5.5"/></svg>
                  </span>
                  <span class="flex-1">
                    <b class="font-heading text-lg tracking-wide transition-colors group-hover:text-accent">{c.title}</b>
                    <span class="mt-1 block text-sm text-muted">{c.blurb}</span>
                  </span>
                  <span class="course-state self-center font-mono text-xs uppercase tracking-[0.2em] text-muted transition-colors group-hover:text-accent" data-state>Start</span>
                </a>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .course-row.is-done .course-node {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: #fffdf9;
  }
  .course-row.is-done .course-check {
    display: block;
  }
  .course-row.is-next .course-node {
    border-color: var(--color-amber);
  }
</style>

<script>
  // Gate: same speed bump as always; ?pass keeps working for members.
  try {
    const q = new URLSearchParams(location.search);
    if (document.cookie.indexOf('ka_course=') !== -1 || q.has('pass')) {
      document.cookie = 'ka_course=' + (document.cookie.match(/(?:^|;\s*)ka_course=([^;]+)/)?.[1] ?? (q.get('pass') || '1')) + '; Max-Age=31536000; Path=/; SameSite=Lax; Secure';
    } else {
      location.replace('/free-course/');
    }
  } catch {}

  // Progress states on the path. Local and cosmetic; the beacons on the
  // chapter pages are the real analytics.
  try {
    const done: string[] = JSON.parse(localStorage.getItem('ka_course_done') ?? '[]');
    let firstTodo: HTMLAnchorElement | null = null;
    document.querySelectorAll<HTMLAnchorElement>('[data-chapter]').forEach((a) => {
      const slug = a.dataset.chapter!;
      const state = a.querySelector('[data-state]');
      if (done.includes(slug)) {
        a.classList.add('is-done');
        if (state) state.textContent = 'Done';
      } else if (!firstTodo) {
        firstTodo = a;
        a.classList.add('is-next');
        if (state) state.textContent = done.length ? 'Next' : 'Start';
      } else if (state) {
        state.textContent = '';
      }
    });
    if (done.length > 0 && firstTodo) {
      const el = document.getElementById('course-resume');
      if (el) {
        el.innerHTML = '';
        const link = document.createElement('a');
        link.href = (firstTodo as HTMLAnchorElement).href;
        link.className = 'font-semibold text-accent underline underline-offset-4';
        link.textContent = 'Pick up where you left off';
        el.append('You have finished ' + done.length + ' of 9. ', link, '.');
        el.classList.remove('hidden');
      }
    }
  } catch {}
</script>

<script>
  // The rail draws with the scroll and the nodes arrive along it, the
  // ai-launch track's language turned vertical. From-states only, gated on
  // reduced motion, so the static page is always the finished one.
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const path = document.getElementById('course-path');

  if (!reduced && path) {
    gsap.registerPlugin(ScrollTrigger);
    gsap.from('#course-rail', {
      scaleY: 0,
      transformOrigin: 'top',
      ease: 'none',
      scrollTrigger: { trigger: path, start: 'top 78%', end: 'bottom 65%', scrub: 0.6 },
    });
    gsap.utils.toArray<HTMLElement>('.course-row').forEach((row) => {
      gsap.from(row, {
        x: -18,
        opacity: 0,
        duration: 0.55,
        ease: 'power2.out',
        scrollTrigger: { trigger: row, start: 'top 88%' },
      });
      const node = row.querySelector('.course-node');
      if (node) {
        gsap.from(node, {
          scale: 0,
          duration: 0.4,
          ease: 'back.out(2)',
          scrollTrigger: { trigger: row, start: 'top 88%' },
        });
      }
    });
  }
</script>
