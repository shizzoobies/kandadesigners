---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReviewsRail from '../../components/ReviewsRail.astro';
import { phone } from '../../data/contact.js';
import { locations } from '../../data/locations.js';

const PAGE_URL = 'https://ka-performancefl.com/locations/bradenton-sarasota/';

// One page for Bradenton, Sarasota, St. Petersburg, Tampa and Brandon, on
// purpose. There are no pages for the individual cities, so they are named in
// prose and nothing links to a page that does not exist. The office's street
// is never written here; the sentences that mention the address follow the
// flag in src/data/locations.js and point at the Ellenton page.
const office = locations.ellenton;

// Home > Bradenton & Sarasota. No /locations/ index exists on purpose, so the
// trail has exactly two crumbs and both of them resolve.
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://ka-performancefl.com/' },
    { '@type': 'ListItem', position: 2, name: 'Bradenton & Sarasota', item: PAGE_URL },
  ],
};

// The four questions an enquiry from these cities opens with. Every answer
// restates something already said in the body of this page, which is the
// condition for marking them up: FAQ markup over answers a reader cannot see
// on the page is what gets the markup discounted rather than rewarded.
const faqs = [
  {
    q: 'Where are you actually based?',
    a: office.published
      ? 'Gainesville is the headquarters. The second office is in Ellenton, in Manatee County, and it is where we meet clients from Bradenton, Sarasota, St. Petersburg, Tampa and Brandon, by appointment. The address is on the Ellenton page.'
      : 'Gainesville is the headquarters. The second office is in Ellenton, in Manatee County, and it is where we meet clients from Bradenton, Sarasota, St. Petersburg, Tampa and Brandon, by appointment. The street address goes on the Ellenton page the day the doors open.',
  },
  {
    q: 'Will you come to us?',
    a: 'Yes. Bradenton, Sarasota, St. Petersburg, Tampa and Brandon are all in-person territory, so we will meet you at the office in Ellenton or at your place of business, whichever is easier. Either way, it is by appointment.',
  },
  {
    q: 'Is pricing different in Bradenton or Sarasota?',
    a: 'No. The bands are the same here as everywhere else we work, they are published on the cost page, and a quote is free. There is no local markup.',
  },
  {
    q: 'Can you help a business that already has a site?',
    a: 'Yes, and we will look at what you have before we suggest replacing it. If patching the site you have beats rebuilding it, we will say so. Existing sites can also be audited for accessibility on their own.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const services = [
  {
    href: '/services/web-design/',
    kicker: 'Web design',
    blurb: 'A site built for your business from scratch, reviewed on a real staging URL.',
  },
  {
    href: '/services/ai-integration/',
    kicker: 'AI integration',
    blurb: 'Assistants, automations, and AI audio, built into the site rather than bolted on.',
  },
  {
    href: '/services/seo-ai-search/',
    kicker: 'SEO & AI search',
    blurb: 'Local search across five cities that share one map. We do the on-site half.',
  },
  {
    href: '/services/accessibility/',
    kicker: 'Accessibility',
    blurb: 'Contrast, keyboard paths, screen readers. Checked, not claimed.',
  },
];
---
<BaseLayout
  title="Web Design in Bradenton & Sarasota | K & A Performance"
  description="Web design and AI integration for Bradenton, Sarasota, St. Petersburg, Tampa and Brandon, from our office in Ellenton. By appointment, and quotes are free."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

  <section class="mx-auto max-w-4xl px-6 pt-40 pb-16 md:pt-48">
    <p data-animate="type-settle" class="font-mono text-sm uppercase tracking-[0.3em] text-muted">
      Bradenton &amp; Sarasota, Florida
    </p>
    <h1 data-animate="type-settle" data-animate-delay="0.1" class="mt-6 font-display text-[clamp(2.25rem,6vw,4.5rem)] leading-[1.04]">
      Web design in Bradenton and Sarasota, <span class="text-accent">and up the road to Tampa</span>
    </h1>
    <p data-animate="type-settle" data-animate-delay="0.2" class="mt-8 max-w-2xl text-lg leading-relaxed text-muted">
      Bradenton, Sarasota, St. Petersburg, Tampa and Brandon have five names,
      five downtowns and, as far as most of the people living in them are
      concerned, one map. Alex lived here, so this is not an area we learned
      from a list of search terms. The office is inland, in Ellenton, and every
      one of those five is an appointment away.
    </p>
  </section>

  <section class="mx-auto max-w-3xl border-t border-ink/10 px-6 py-20 md:py-24">
    <h2 data-animate="type-settle" class="font-display text-3xl leading-tight md:text-5xl">Five cities wearing one map</h2>
    <p data-animate="type-settle" class="mt-6 leading-relaxed text-muted">
      People here live in one city, work in a second and eat out in a third.
      Somebody in Brandon drives into Tampa every morning. Somebody in
      Bradenton goes down to Sarasota for dinner and does not think of it as a
      trip. St. Petersburg is across the water from Tampa and across the
      Skyway from Manatee County, and people cross both without much ceremony,
      the Skyway on a windy day excepted.
    </p>
    <p data-animate="type-settle" class="mt-5 leading-relaxed text-muted">
      The customers a business here is chasing move the same way. They do not
      stop at a county line, and neither does the map on their phone. So we
      treat the five as one territory rather than five landing pages. There is
      no Sarasota page with Bradenton swapped in for the name, because nobody
      searching lives in that version of Florida.
    </p>

    <h2 data-animate="type-settle" class="mt-16 font-display text-3xl leading-tight md:text-5xl">Ellenton, in the middle of the five</h2>
    <p data-animate="type-settle" class="mt-6 leading-relaxed text-muted">
      The office is in Ellenton, in Manatee County, well inland. Bradenton is
      next door, Sarasota is to the south, Tampa and Brandon are to the north,
      and St. Petersburg is over the Skyway. That is most of the point of
      putting it there. Meetings are by appointment, at the office or at your
      place of business, whichever is easier.
    </p>
    {office.published ? (
      <p data-animate="type-settle" class="mt-5 leading-relaxed text-muted">
        The address is on the
        <a href="/locations/ellenton/" class="text-accent underline underline-offset-4 hover:text-accent-hot">Ellenton page</a>.
        Gainesville stays the headquarters; Ellenton is where Bradenton,
        Sarasota and their neighbors get a table of their own.
      </p>
    ) : (
      <p data-animate="type-settle" class="mt-5 leading-relaxed text-muted">
        The street address goes on the
        <a href="/locations/ellenton/" class="text-accent underline underline-offset-4 hover:text-accent-hot">Ellenton page</a>
        the day the doors open, and not a day before. Gainesville stays the
        headquarters; Ellenton is where Bradenton, Sarasota and their neighbors
        get a table of their own.
      </p>
    )}

    <h2 data-animate="type-settle" class="mt-16 font-display text-3xl leading-tight md:text-5xl">Already building here</h2>
    <p data-animate="type-settle" class="mt-6 leading-relaxed text-muted">
      There are two builds around here so far, and both are medical.
      <a href="https://familypracticedirect.com" target="_blank" rel="noopener" class="text-accent underline underline-offset-4 hover:text-accent-hot">Ellenton Family Practice Direct</a>
      is direct primary care right next door to the office, on a site built
      around membership signups.
      <a href="https://mbsdoc.com" target="_blank" rel="noopener" class="text-accent underline underline-offset-4 hover:text-accent-hot">MBS Medicine</a>,
      nearby, is a veteran-owned Florida telehealth clinic with same-week
      booking and a patient portal.
    </p>
    <p data-animate="type-settle" class="mt-5 leading-relaxed text-muted">
      That is the honest count: two builds, and an office to do more from. We
      would rather say so than pad a list with towns we have never shipped
      anything in.
    </p>

    <h2 data-animate="type-settle" class="mt-16 font-display text-3xl leading-tight md:text-5xl">What it costs, and how it runs</h2>
    <p data-animate="type-settle" class="mt-6 leading-relaxed text-muted">
      Quotes are free, and the bands are the same here as everywhere else we
      work. They are on the
      <a href="/services/web-design/what-it-costs/" class="text-accent underline underline-offset-4 hover:text-accent-hot">cost page</a>.
      There is no local markup and no out-of-town discount, because nobody
      here is out of town.
    </p>
    <p data-animate="type-settle" class="mt-5 leading-relaxed text-muted">
      Most of the work runs over a live staging site you can open on your own
      phone, recorded walkthroughs, and a reply within 24 hours. A room is for
      when a room helps, like a kickoff or the first look at a new site. Either
      way you deal with the same two people: Alex Anderson on design and
      development, Kristina Anderson on strategy and content.
    </p>
    <p data-animate="type-settle" class="mt-5 leading-relaxed text-muted">
      And if you already have a site, we look at it first. If patching the
      site you have beats rebuilding it, we will say so, and an existing site
      can be audited for accessibility on its own.
    </p>
  </section>

  <section class="mx-auto max-w-6xl border-t border-ink/10 px-6 py-20 md:py-24">
    <h2 data-animate="type-settle" class="font-display text-3xl leading-tight md:text-5xl">What we do from Ellenton</h2>
    <p data-animate="type-settle" class="mt-6 max-w-2xl leading-relaxed text-muted">
      The same four things we do everywhere, scoped to what the business
      actually needs.
    </p>
    <div class="mt-10 grid gap-8 md:grid-cols-2">
      {services.map((s) => (
        <a href={s.href} data-animate="frame-lift" class="glow-frame group flex flex-col p-7">
          <p class="font-mono text-xs uppercase tracking-[0.25em] text-accent">{s.kicker}</p>
          <p class="mt-3 leading-relaxed text-muted">{s.blurb}</p>
          <p class="mt-5 font-heading text-sm font-semibold tracking-wide text-accent">
            Read more
          </p>
        </a>
      ))}
    </div>
  </section>

  <!-- The questions that open an enquiry from these cities, answered where a
       reader can see them. The FAQPage markup in the head describes exactly
       these. -->
  <section class="mx-auto max-w-3xl border-t border-ink/10 px-6 py-20 md:py-24">
    <h2 data-animate="type-settle" class="font-display text-3xl leading-tight md:text-5xl">Questions we get first</h2>
    <dl class="mt-10 flex flex-col gap-8">
      {faqs.map((f) => (
        <div class="border-t border-ink/10 pt-6">
          <dt class="font-heading text-lg font-semibold tracking-wide">{f.q}</dt>
          <dd class="m-0 mt-3 leading-relaxed text-muted">{f.a}</dd>
        </div>
      ))}
    </dl>
  </section>

  <div class="border-t border-ink/10">
    <ReviewsRail />
  </div>

  <section class="px-6 pb-40 pt-16 md:pt-24">
    <div class="mx-auto max-w-4xl text-center">
      <p data-animate="type-settle" class="font-display text-[clamp(2.25rem,5.5vw,4.5rem)] leading-[1.05]">
        Five cities, <span class="text-accent">one phone number</span>
      </p>
      <p data-animate="type-settle" data-animate-delay="0.1" class="mx-auto mt-8 max-w-2xl text-lg leading-relaxed text-muted">
        Tell us what the site has to do and we will tell you what it would take,
        what it would cost, and whether it is worth doing at all. The quote is
        free either way, and the
        <a href="/services/web-design/what-it-costs/" class="text-accent underline underline-offset-4 hover:text-accent-hot">cost page</a>
        shows the bands before you ask.
      </p>
      <div data-animate="type-settle" data-animate-delay="0.2" class="mt-10">
        <a href="/contact/" class="btn-accent">Start a project</a>
      </div>
      <p data-animate="type-settle" data-animate-delay="0.25" class="mt-6 text-lg leading-relaxed text-muted">
        Or call
        <a href={phone.href} class="whitespace-nowrap font-semibold text-accent underline underline-offset-4 transition-colors hover:text-accent-hot">{phone.display}</a>.
      </p>
    </div>
  </section>
</BaseLayout>
