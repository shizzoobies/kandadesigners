---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrainingOverview from '../../components/TrainingOverview.astro';
import { trainingPresentation } from '../../data/trainingPresentation.js';
import {
  section,
  deliverables,
  engagementModels,
  inquiryFields,
} from '../../data/training.js';

// The overview presentation is separate from the established inquiry flow.
// Service facts and publication decisions remain in training.js.

const PAGE_URL = 'https://ka-performancefl.com/training/';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://ka-performancefl.com/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://ka-performancefl.com/services/' },
    { '@type': 'ListItem', position: 3, name: 'Training content', item: PAGE_URL },
  ],
};

// Service schema. The offer catalog lists the three engagement models by
// shape only: no price, no priceRange, no priceSpecification anywhere, which
// is the brief's first hard constraint applied to structured data as well as
// to copy.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Training and eLearning content development',
  url: PAGE_URL,
  serviceType: deliverables.map((d) => d.title),
  description:
    "Custom eLearning and training content development: full courses, standard modules, microlearning, job aids, assessments, conversion, and accessibility remediation, delivered as SCORM, xAPI, or plain HTML into the client's own LMS.",
  // Point at the organisation node BaseLayout already publishes, the way
  // /ai-launch/ does, instead of restating a second, thinner copy of the
  // business here and leaving search engines to guess they are the same one.
  provider: { '@id': 'https://ka-performancefl.com/#organization' },
  // Florida, not the whole country. The organisation node claims a service
  // area of Florida cities; a Service claiming the United States on top of it
  // is the kind of overreach that gets the smaller, true claim discounted too.
  areaServed: { '@type': 'State', name: 'Florida' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Engagement models',
    itemListElement: engagementModels.map((m) => ({
      '@type': 'Offer',
      name: m.title,
      description: m.shape,
    })),
  },
};

// Questions we already answer on this page, pulled together where a reader
// scanning for them can find them in one place. Every answer restates a fact
// that is visible above it (the delivery block, the accessibility section, the
// AI transparency section), because FAQ markup over content a reader cannot
// see on the page is exactly what Google penalises. Nothing new is claimed
// here, and nothing here carries a price.
const faqs = [
  {
    q: 'Do you host our training content?',
    a: 'No. Everything is delivered into your own LMS, in the package your system already accepts. We never receive learner data either: completion, scores, and identities stay in your system.',
  },
  {
    q: 'What formats do you deliver?',
    a: 'SCORM 1.2, SCORM 2004, xAPI, or plain HTML. Tell us the LMS and the version, and the build is tested inside it before you see the invoice for it.',
  },
  {
    q: 'What accessibility standard do you build to?',
    a: 'WCAG 2.1 AA, tested rather than claimed. Every build gets a keyboard pass, a read through with a real screen reader, measured contrast, a reduced-motion check, and all of it verified again inside your actual LMS.',
  },
  {
    q: 'Do you use AI to build the content?',
    a: 'Yes, and we will tell you exactly how. Authoring is AI-assisted with a human instructional designer reviewing and validating every output before it reaches you. Your confidential material never goes into a tool that trains on submitted content, and any restriction you need, from specific tools to no AI at all, is written into the statement of work.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

---
<BaseLayout
  clientRouter
  ogImage={trainingPresentation['hazard-recognition'].shareImage}
  title="Custom eLearning Content Development | K & A Performance"
  description="Custom eLearning and instructional design: SCORM and xAPI courses, microlearning, job aids, and accessibility remediation, built into your own LMS."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

  <TrainingOverview faqs={faqs} />

  <!-- The inquiry modal. Every [data-inquire] button on the page opens it;
       the native dialog gives Esc, focus containment, and a real backdrop
       without a line of trap-management code. -->
  <dialog id="tr-modal" class="tr-modal" aria-labelledby="tr-modal-title">
    <div class="glow-frame tr-frame p-8 md:p-10">
      <div class="mb-8 flex items-start justify-between gap-6">
        <div>
          <h2 id="tr-modal-title" class="font-display text-2xl md:text-3xl">Training inquiry</h2>
          <p class="mt-2 text-sm leading-relaxed text-muted">Four questions are required. The rest just make the reply better.</p>
        </div>
        <button type="button" id="tr-modal-close" class="inquiry-close" aria-label="Close inquiry">Close</button>
      </div>

      <form id="tr-form" class="flex flex-col gap-6" novalidate>
        <input type="hidden" name="access_key" value="7ad90fb9-bc88-411a-9442-c249b49c32f6" />
        <input type="hidden" name="subject" value="New training inquiry | ka-performancefl.com" />
        <input type="hidden" name="from_name" value="K & A Performance Website" />
        <!-- Attribution: filled from the first-touch cookie by the script
             below. Defaults to direct, so no JS means no false attribution. -->
        <input type="hidden" id="tr-source" name="source" value="direct" />
        <!-- No SMS opt-in on purpose: the promised follow-up here is email.
             The explicit "No" keeps every emailed lead carrying an
             unambiguous consent record. Do not text these leads. -->
        <input type="hidden" name="sms_consent" value="No" />
        <!-- Honeypot: hidden from humans, bots fill it and get filtered. -->
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="tr-name" class="mb-3 block font-mono text-xs uppercase tracking-[0.2em] text-muted">Name</label>
            <input type="text" id="tr-name" name="name" required autocomplete="name" placeholder="Your name" class="field" />
          </div>
          <div>
            <label for="tr-organization" class="mb-3 block font-mono text-xs uppercase tracking-[0.2em] text-muted">Organization</label>
            <input type="text" id="tr-organization" name="organization" required autocomplete="organization" placeholder="Your organization" class="field" />
          </div>
        </div>

        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="tr-email" class="mb-3 block font-mono text-xs uppercase tracking-[0.2em] text-muted">Email</label>
            <input type="email" id="tr-email" name="email" required autocomplete="email" placeholder="you@organization.com" class="field" />
          </div>
          <div>
            <label for="tr-phone" class="mb-3 block font-mono text-xs uppercase tracking-[0.2em] text-muted">
              Phone <span class="tracking-normal normal-case">(optional)</span>
            </label>
            <input type="tel" id="tr-phone" name="phone" autocomplete="tel" placeholder="(352) 555-0142" class="field" />
          </div>
        </div>

        <div>
          <label for="tr-need" class="mb-3 block font-mono text-xs uppercase tracking-[0.2em] text-muted">What training do you need?</label>
          <textarea id="tr-need" name="need" required rows="4" placeholder="The topic, the problem it solves, and what happens if it does not get built" class="field field-area"></textarea>
        </div>

        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="tr-role" class="mb-3 block font-mono text-xs uppercase tracking-[0.2em] text-muted">
              Your role <span class="tracking-normal normal-case">(optional)</span>
            </label>
            <input type="text" id="tr-role" name="role" placeholder="Training manager, HR, operations" class="field" />
          </div>
          <div>
            <label for="tr-deadline" class="mb-3 block font-mono text-xs uppercase tracking-[0.2em] text-muted">
              Deadline <span class="tracking-normal normal-case">(optional)</span>
            </label>
            <input type="text" id="tr-deadline" name="deadline" placeholder="A date, a quarter, or the event it has to beat" class="field" />
          </div>
        </div>

        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="tr-audience" class="mb-3 block font-mono text-xs uppercase tracking-[0.2em] text-muted">
              Audience <span class="tracking-normal normal-case">(optional)</span>
            </label>
            <input type="text" id="tr-audience" name="audience" placeholder="Who takes this, and how many of them" class="field" />
          </div>
          <div>
            <label for="tr-scope" class="mb-3 block font-mono text-xs uppercase tracking-[0.2em] text-muted">
              Scope or seat time <span class="tracking-normal normal-case">(optional)</span>
            </label>
            <input type="text" id="tr-scope" name="scope" placeholder="Modules, topics, or minutes in the seat" class="field" />
          </div>
        </div>

        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="tr-lms" class="mb-3 block font-mono text-xs uppercase tracking-[0.2em] text-muted">
              LMS and version <span class="tracking-normal normal-case">(optional)</span>
            </label>
            <input type="text" id="tr-lms" name="lms" placeholder="What it has to load into" class="field" />
          </div>
          <div>
            <label for="tr-readiness" class="mb-3 block font-mono text-xs uppercase tracking-[0.2em] text-muted">
              Source content readiness <span class="tracking-normal normal-case">(optional)</span>
            </label>
            <select id="tr-readiness" name="source_readiness" class="field">
              <option value="">Select one</option>
              {inquiryFields.sourceReadiness.map((o) => <option>{o}</option>)}
            </select>
          </div>
        </div>

        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="tr-sme" class="mb-3 block font-mono text-xs uppercase tracking-[0.2em] text-muted">
              Subject matter expert availability <span class="tracking-normal normal-case">(optional)</span>
            </label>
            <select id="tr-sme" name="sme_availability" class="field">
              <option value="">Select one</option>
              {inquiryFields.smeAvailability.map((o) => <option>{o}</option>)}
            </select>
          </div>
          <div>
            <label for="tr-accessibility" class="mb-3 block font-mono text-xs uppercase tracking-[0.2em] text-muted">
              Accessibility requirement <span class="tracking-normal normal-case">(optional)</span>
            </label>
            <select id="tr-accessibility" name="accessibility_requirement" class="field">
              <option value="">Select one</option>
              {inquiryFields.accessibilityRequirement.map((o) => <option>{o}</option>)}
            </select>
          </div>
        </div>

        <div>
          <label for="tr-heard" class="mb-3 block font-mono text-xs uppercase tracking-[0.2em] text-muted">
            How did you hear about us? <span class="tracking-normal normal-case">(optional)</span>
          </label>
          <select id="tr-heard" name="how_did_you_hear" class="field">
            {inquiryFields.heardFrom.map((o) => (
              <option selected={o === 'Other' ? true : undefined}>{o}</option>
            ))}
          </select>
        </div>

        <button type="submit" id="tr-submit" class="btn-draw w-full text-center">Send the inquiry</button>
        <p id="tr-status" class="sr-only" role="status" aria-live="polite"></p>
        <p id="tr-error" tabindex="-1" class="hidden text-sm leading-relaxed text-muted" role="alert">
          Something went wrong sending that. Please email us directly at
          <a href={'mailto:' + section.email} class="text-accent underline transition-colors hover:text-accent-hot">{section.email}</a>
          and we will pick it up.
        </p>
      </form>

      <div id="tr-success" tabindex="-1" role="status" aria-live="polite" class="hidden flex-col justify-center py-10">
        <h3 class="font-display text-3xl leading-tight">Got it</h3>
        <p class="mt-6 text-lg leading-relaxed text-muted">
          Alex reads every one of these himself and will answer within one
          business day. If anything you sent needs a conversation rather than
          a reply, he will say so and offer a time.
        </p>
      </div>
    </div>
  </dialog>
</BaseLayout>

<style>
  .inquiry-close { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 8px 12px; border: 1px solid var(--color-accent); background: transparent; color: var(--color-accent); font: 700 .85rem var(--font-heading); cursor: pointer; }
  .inquiry-close:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 4px; }
  /* The inquiry modal: a bare dialog shell so the glow-frame inside is the
     only visible surface, floating on a blurred ink wash. Same treatment as
     the intake modal on /ai-launch/. */
  .tr-modal {
    margin: auto;
    width: min(34rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 2.5rem);
    overflow-y: auto;
    background: transparent;
    border: none;
    padding: 0;
    border-radius: 1rem;
  }
  .tr-modal::backdrop {
    background: rgb(34 28 21 / 0.45);
    backdrop-filter: blur(5px);
  }
  .tr-modal[open] {
    animation: tr-modal-in 0.45s var(--ease-out-expo);
  }
  .tr-modal[open]::backdrop {
    animation: tr-modal-fade 0.3s ease;
  }
  @keyframes tr-modal-in {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.98);
    }
  }
  @keyframes tr-modal-fade {
    from { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tr-modal[open], .tr-modal[open]::backdrop { animation: none; }
  }
</style>

<script>
  // Re-run after every client-side navigation (ClientRouter). astro:page-load
  // also fires on the initial load, after this has run once, so the init
  // marks the root it wires and skips a DOM it has already seen.
  const trInit1 = () => {
    const root = document.getElementById("tr-modal") || document.body;
    if ((root as HTMLElement).dataset["trInit1"]) return;
    (root as HTMLElement).dataset["trInit1"] = "1";
    // Attribution read. The write happens sitewide in BaseLayout (first touch
    // wins there, whatever page the ?src= link landed on); this page only
    // copies the stored value into the hidden field. Fully guarded: a malformed
    // cookie must never take the form's submit handler down with it.
    try {
      const raw =
        document.cookie.match(/(?:^|;\s*)ka_src=([^;]+)/)?.[1] ??
        new URLSearchParams(location.search).get('src');
      let src = raw;
      try {
        src = raw ? decodeURIComponent(raw) : raw;
      } catch {
        /* keep the raw value */
      }
      const sourceField = document.getElementById('tr-source') as HTMLInputElement | null;
      if (src && sourceField) sourceField.value = src;
    } catch {
      /* attribution is best-effort; the form must work regardless */
    }
  };
  trInit1();
  document.addEventListener("astro:page-load", trInit1);
</script>

<script>
  // Re-run after every client-side navigation (ClientRouter). astro:page-load
  // also fires on the initial load, after this has run once, so the init
  // marks the root it wires and skips a DOM it has already seen.
  const trInit2 = () => {
    const root = document.getElementById("tr-modal") || document.body;
    if ((root as HTMLElement).dataset["trInit2"]) return;
    (root as HTMLElement).dataset["trInit2"] = "1";
    // Modal wiring. Native dialog handles Esc and focus containment; this adds
    // the page scroll lock, the backdrop click, and the close button.
    const modal = document.getElementById('tr-modal') as HTMLDialogElement | null;

    const openInquiry = () => {
      if (!modal) return;
      if (!modal.open) modal.showModal();
      // Native dialog does not lock the page behind it.
      document.documentElement.style.overflow = 'hidden';
      const nameEl = document.getElementById('tr-name') as HTMLInputElement | null;
      // Skip the focus grab when the form is hidden (post-success state).
      if (nameEl && nameEl.offsetParent !== null) nameEl.focus({ preventScroll: true });
    };

    modal?.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
    });
    document.getElementById('tr-modal-close')?.addEventListener('click', () => modal?.close());
    // A click on the backdrop targets the dialog element itself.
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });

    document.querySelectorAll<HTMLElement>('[data-inquire]').forEach((el) => {
      el.addEventListener('click', () => openInquiry());
    });

    // ?inquire=1 opens the form on load, for links that exist to do exactly that.
    if (new URLSearchParams(location.search).get('inquire')) openInquiry();
  };
  trInit2();
  document.addEventListener("astro:page-load", trInit2);
</script>

<script>
  // Re-run after every client-side navigation (ClientRouter). astro:page-load
  // also fires on the initial load, after this has run once, so the init
  // marks the root it wires and skips a DOM it has already seen.
  const trInit3 = () => {
    const root = document.getElementById("tr-modal") || document.body;
    if ((root as HTMLElement).dataset["trInit3"]) return;
    (root as HTMLElement).dataset["trInit3"] = "1";
    // Inquiry submit: the same Web3Forms flow as the contact page and the
    // AI Launch intake.
    const form = document.getElementById('tr-form') as HTMLFormElement | null;
    const successEl = document.getElementById('tr-success');
    const errorEl = document.getElementById('tr-error');
    const statusEl = document.getElementById('tr-status');
    const btn = document.getElementById('tr-submit') as HTMLButtonElement | null;

    if (form && btn) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const original = btn.textContent;

        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }

        errorEl?.classList.add('hidden');
        btn.disabled = true;
        btn.textContent = 'Sending…';
        if (statusEl) statusEl.textContent = 'Sending your inquiry…';

        const data: Record<string, string> = {};
        new FormData(form).forEach((value, key) => {
          data[key] = String(value);
        });

        try {
          const res = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(data),
          });
          const result = await res.json();

          if (result.success) {
            // Success path only; guarded because ad blockers stop fbq existing.
            if (window.fbq) window.fbq('track', 'Lead');
            if (statusEl) statusEl.textContent = '';
            form.classList.add('hidden');
            successEl?.classList.remove('hidden');
            successEl?.classList.add('flex');
            (successEl as HTMLElement | null)?.focus();
          } else {
            throw new Error(result.message || 'Submission failed');
          }
        } catch {
          if (statusEl) statusEl.textContent = '';
          errorEl?.classList.remove('hidden');
          btn.disabled = false;
          btn.textContent = original;
          (errorEl as HTMLElement | null)?.focus();
        }
      });
    }
  };
  trInit3();
  document.addEventListener("astro:page-load", trInit3);
</script>
