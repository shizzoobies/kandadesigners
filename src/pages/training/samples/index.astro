---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TrainingSubnav from '../../../components/TrainingSubnav.astro';
import TrainingCourseCard from '../../../components/TrainingCourseCard.astro';
import { liveSamples, plannedSamples } from '../../../data/training.js';
import { trainingPresentation } from '../../../data/trainingPresentation.js';
const SITE = 'https://ka-performancefl.com';
const PAGE_URL = SITE + '/training/samples/';
const key = (text) => text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const industries = [...new Set(liveSamples.map((sample) => sample.vertical))].map((title) => ({ title, key: key(title), count: liveSamples.filter((sample) => sample.vertical === title).length }));
const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE + '/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: SITE + '/services/' },
    { '@type': 'ListItem', position: 3, name: 'Training content', item: SITE + '/training/' },
    { '@type': 'ListItem', position: 4, name: 'Samples', item: PAGE_URL },
  ],
};
const collectionSchema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': PAGE_URL + '#collection', url: PAGE_URL, name: 'Training content samples',
  description: 'Six original interactive courses with illustrated guides, optional audio and practical activities. Explore each course in your browser.', inLanguage: 'en-US',
  hasPart: liveSamples.map((sample) => ({ '@type': 'CreativeWork', name: sample.title, url: SITE + '/training/samples/' + sample.slug + '/', description: sample.what, image: SITE + trainingPresentation[sample.slug].cover, learningResourceType: sample.kind, timeRequired: 'PT' + sample.minutes + 'M' })),
};
---
<BaseLayout clientRouter title="Interactive Training Samples | K & A Performance" description="Explore six original interactive courses with illustrated guides, optional audio and practical activities. Play construction, finance and wellness samples." ogImage={trainingPresentation['hazard-recognition'].shareImage}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionSchema)} />
  <section class="gallery-intro mx-auto max-w-6xl px-6">
    <p class="gallery-eyebrow"><a href="/training/">Training content</a><span aria-hidden="true"> / </span> The courses</p>
    <div class="gallery-intro-copy"><h1>Learning you can <span>step into.</span></h1><p>Walk a jobsite. Open a bakery's books. Build a plate. Six original courses with illustrated guides, optional audio and something useful to practice.</p></div>
  </section>
  <TrainingSubnav />
  <section class="gallery-collection mx-auto max-w-6xl px-6" aria-label="Playable courses">
    <div class="gallery-filter" id="tr-filter" hidden>
      <fieldset><legend class="sr-only">Filter courses by industry</legend><div class="gallery-filter-options">
        <button type="button" data-value="" aria-pressed="true">All courses <span>{liveSamples.length}</span></button>
        {industries.map((industry) => <button type="button" data-value={industry.key} aria-pressed="false">{industry.title}<span>{industry.count}</span></button>)}
      </div></fieldset>
      <p id="tr-filter-state" role="status" aria-live="polite">{liveSamples.length} courses to explore</p>
    </div>
    <ul class="gallery-grid" id="tr-grid">{liveSamples.map((sample, index) => <li data-vertical={key(sample.vertical)}><TrainingCourseCard sample={sample} headingLevel={2} eager={index < 2} /></li>)}</ul>
    {plannedSamples.length > 0 && <aside class="gallery-coming" aria-labelledby="coming-title">
      <div class="gallery-coming-mark" aria-hidden="true"><svg viewBox="0 0 64 64" fill="none"><path d="M12 16h26v34H12zM26 10h26v34H38M19 25h12M19 32h9M19 39h12" stroke="currentColor" stroke-width="1.5" /><path d="m41 24 4 4 8-8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></div>
      <div><p class="gallery-eyebrow" id="coming-title">Coming next</p>{plannedSamples.map((sample) => <div><h2>{sample.title}</h2><p>{sample.what}</p></div>)}</div><span class="gallery-coming-status">In development</span>
    </aside>}
  </section>
  <section class="gallery-cta mx-auto max-w-6xl px-6">
    <div><p class="gallery-eyebrow">Your subject. Your audience.</p><h2>Give your content<br /><span>this much care.</span></h2><p>Bring the topic and the people you need to reach. We can work out the right format together.</p></div>
    <div class="gallery-cta-actions"><a href="/training/?inquire=1" class="btn-draw">Discuss your project</a><a href="/training/team/" class="gallery-team-link">Meet the team <span aria-hidden="true">↗</span></a></div>
  </section>
  <style>
    .gallery-intro { padding-top: 10rem; padding-bottom: 3rem; }
    .gallery-eyebrow { font-family: var(--font-mono); font-size: .7rem; line-height: 1.7; letter-spacing: .15em; text-transform: uppercase; color: var(--color-accent); }
    .gallery-eyebrow a { text-decoration: none; }
    .gallery-eyebrow a:hover { text-decoration: underline; text-underline-offset: 4px; }
    .gallery-intro-copy { display: grid; gap: 1.5rem 3rem; margin-top: 1.3rem; align-items: end; }
    .gallery-intro h1 { max-width: 12ch; font-family: var(--font-display); font-size: clamp(2.8rem,5.5vw,4.6rem); font-weight: 700; letter-spacing: -.045em; line-height: 1.04; }
    .gallery-intro h1 span, .gallery-cta h2 span { color: var(--color-accent); }
    .gallery-intro-copy > p { max-width: 34rem; font-size: 1.1rem; line-height: 1.7; color: var(--color-muted); }
    .gallery-collection { padding-top: 2.5rem; padding-bottom: 4.5rem; }
    .gallery-filter { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 2rem; }
    .gallery-filter[hidden] { display: none; }
    .gallery-filter fieldset { border: 0; min-width: 0; padding: 0; margin: 0; }
    .gallery-filter-options { display: flex; flex-wrap: wrap; gap: .35rem 1.5rem; }
    .gallery-filter button { min-height: 44px; padding: .6rem 0; border: 0; border-bottom: 2px solid transparent; font-family: var(--font-heading); font-size: .9rem; line-height: 1.5; color: var(--color-muted); background: none; cursor: pointer; transition: color .2s, border-color .2s; }
    .gallery-filter button[aria-pressed='true'] { color: var(--color-accent); border-bottom-color: var(--color-accent); font-weight: 650; }
    .gallery-filter button:hover { color: var(--color-ink); }
    .gallery-filter button:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
    .gallery-filter button span { margin-left: .4rem; font-size: .7rem; color: var(--color-muted); }
    .gallery-filter > p { font-family: var(--font-mono); font-size: .65rem; color: var(--color-muted); }
    .gallery-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; list-style: none; padding: 0; margin: 0; }
    .gallery-grid > li { min-width: 0; }
    .gallery-grid > li[hidden] { display: none; }
    .gallery-coming { display: flex; align-items: center; gap: 1.5rem; margin-top: 3rem; padding: 2rem 0; border-top: 1px solid rgb(34 28 21 / .15); border-bottom: 1px solid rgb(34 28 21 / .15); }
    .gallery-coming-mark { display: none; width: 4rem; height: 4rem; flex: 0 0 auto; color: var(--color-accent); }
    .gallery-coming h2 { margin-top: .5rem; font-family: var(--font-display); font-size: 1.25rem; font-weight: 650; line-height: 1.3; }
    .gallery-coming p:not(.gallery-eyebrow) { max-width: 44rem; margin-top: .5rem; color: var(--color-muted); line-height: 1.6; }
    .gallery-coming-status { display: none; margin-left: auto; flex: 0 0 auto; font-size: .8rem; color: var(--color-muted); }
    .gallery-cta { display: grid; gap: 2rem; padding-bottom: 5rem; }
    .gallery-cta h2 { margin-top: 1rem; font-family: var(--font-display); font-weight: 700; font-size: clamp(2rem,4vw,3.4rem); line-height: 1.08; letter-spacing: -.03em; }
    .gallery-cta p:not(.gallery-eyebrow) { max-width: 34rem; margin-top: 1.25rem; color: var(--color-muted); line-height: 1.7; }
    .gallery-cta-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; }
    .gallery-team-link { color: var(--color-accent); font-weight: 650; text-underline-offset: 4px; }
    @media (min-width: 640px) { .gallery-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } .gallery-coming-mark { display: block; } }
    @media (min-width: 900px) { .gallery-intro-copy { grid-template-columns: 1.1fr 1fr; } .gallery-coming-status { display: block; } .gallery-cta { grid-template-columns: 1fr auto; align-items: center; } }
    @media (min-width: 1100px) { .gallery-grid { grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1.5rem; } }
    @media (prefers-reduced-motion: reduce) { .gallery-filter button { transition: none; } }
  </style>
  <script>
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    function initCourseFilter() {
      const panel = document.getElementById('tr-filter');
      const grid = document.getElementById('tr-grid');
      if (!panel || !grid || panel.dataset.bound) return;
      panel.dataset.bound = 'true';
      panel.hidden = false;
      const buttons = Array.from(panel.querySelectorAll<HTMLButtonElement>('button[data-value]'));
      const courses = Array.from(grid.querySelectorAll<HTMLElement>('li[data-vertical]'));
      const status = document.getElementById('tr-filter-state');
      for (const button of buttons) button.addEventListener('click', () => {
        const chosen = button.dataset.value;
        let shown = 0;
        for (const course of courses) { course.hidden = Boolean(chosen && course.dataset.vertical !== chosen); if (!course.hidden) shown++; }
        for (const option of buttons) option.setAttribute('aria-pressed', String(option === button));
        if (status) status.textContent = chosen ? `${shown} of ${courses.length} courses` : `${courses.length} courses to explore`;
        const motion = (window as any).__motion;
        motion?.lenis?.resize();
        ScrollTrigger.refresh();
      });
    }
    initCourseFilter();
    document.addEventListener('astro:page-load', initCourseFilter);
  </script>
</BaseLayout>
