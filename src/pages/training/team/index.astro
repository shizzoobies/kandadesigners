---
// The bench: /training/team/. Placeholder-structure roster page for the
// training content service line. See src/data/training.js for why every
// designer and SME entry renders as a placeholder (`named: false`) and for
// the combined-years figure this page is not allowed to state as an exact
// number. Do not add names, photos, throughput numbers, or dollar signs here;
// see the file header in training.js and the build brief for the full list
// of hard constraints this page must satisfy.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TrainingSubnav from '../../../components/TrainingSubnav.astro';
import { bench, smes, combinedYears } from '../../../data/training.js';

const PAGE_URL = 'https://ka-performancefl.com/training/team/';

// FLAGGED FOR CONFIRMATION (see training.js): combinedYears must render as a
// rounded, spelled-out figure, never the precise number. Extend this map if
// the figure in training.js ever changes.
const YEARS_AS_WORDS = { 60: 'sixty' };
const combinedYearsWord = YEARS_AS_WORDS[combinedYears] ?? String(combinedYears);

// Small stroke-only glyphs, one per bench focus area / SME field, purely
// decorative (aria-hidden). Same idiom as the outcome cards on /ai-launch:
// viewBox 40, 1.6 stroke, currentColor via text-accent.
const benchIcons = [
  // Curriculum architecture and assessment design: a structure being framed.
  'M6 34 H34 M10 34 V22 L20 6 L30 22 V34 M16 34 V26 H24 V34',
  // Visual design and illustrated learning: a drawing tool mid-stroke.
  'M8 32 L26 8 L32 14 L14 36 Z M26 8 L32 14 M8 32 L6 36 L10 34',
  // Interactive and scenario-based learning: a branching path.
  'M20 5 V14 M20 14 L9 25 M9 25 V35 M20 14 L31 25 M31 25 V35',
  // Technical and compliance training: a shield with a check.
  'M20 4 L34 10 V19 C34 29 28 35 20 38 C12 35 6 29 6 19 V10 Z M13 20 L18 25 L28 13',
];

const smeIcons = [
  // Accounting and finance: a ledger.
  'M11 4 H25 L31 10 V36 H11 Z M25 4 V10 H31 M16 18 H26 M16 24 H26 M16 30 H22',
  // Construction and industrial project management: a hard hat.
  'M6 27 C6 16 12 8 20 8 C28 8 34 16 34 27 M3 27 H37 M3 27 V31 H37 V27 M17 8 V4 H23 V8',
];

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://ka-performancefl.com/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://ka-performancefl.com/services/' },
    { '@type': 'ListItem', position: 3, name: 'Training content', item: 'https://ka-performancefl.com/training/' },
    { '@type': 'ListItem', position: 4, name: 'The bench', item: PAGE_URL },
  ],
};
---
<BaseLayout
  title="The Instructional Design Bench | K & A Performance"
  description="A bench of senior instructional designers and two credentialed subject matter experts, working under written agreement with a single point of contact."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} />

  <section class="mx-auto max-w-4xl px-6 pt-40 pb-16 md:pt-48">
    <p data-animate="type-settle" class="font-mono text-sm uppercase tracking-[0.3em] text-muted">
      <a href="/training/" class="transition-colors hover:text-accent">Training content</a>
      <span class="text-accent" aria-hidden="true">&middot;</span> The bench
    </p>
    <h1 data-animate="type-settle" data-animate-delay="0.1" class="mt-6 font-display text-[clamp(2.25rem,6vw,4.5rem)] leading-[1.04]">
      Senior instructional designers, <span class="text-accent">roughly {combinedYearsWord} years combined</span>
    </h1>
    <p data-animate="type-settle" data-animate-delay="0.2" class="mt-8 max-w-2xl text-lg leading-relaxed text-muted">
      Every project runs under a written agreement, with a named lead and a
      single point of contact from the first call to final delivery. The
      roster itself is not the differentiator. Senior judgment, a
      subject matter expert validating the field details, and a production
      pipeline behind all of it are.
    </p>
  </section>

  <TrainingSubnav />

  <section class="mx-auto max-w-3xl border-t border-ink/10 px-6 py-20 md:py-24">
    <h2 data-animate="type-settle" class="font-display text-3xl leading-tight md:text-5xl">How the bench works</h2>
    <ul data-animate="type-settle" class="mt-6 flex list-disc list-outside flex-col gap-3 pl-5 leading-relaxed text-muted marker:text-accent">
      <li>We sell, scope, and manage the engagement. You are never handed off to someone you have not agreed to work with.</li>
      <li>A senior instructional designer builds the course, from outline through final delivery, not a rotating pool of contractors.</li>
      <li>A subject matter expert validates that the content is correct in the field before it ships.</li>
      <li>Every project has a named lead and a written scope, so there is one person accountable for the work.</li>
      <li>The designer who storyboards a module is the same one who builds it. Your team never has to manage a freelancer directly.</li>
    </ul>
  </section>

  <section class="mx-auto max-w-6xl border-t border-ink/10 px-6 py-20 md:py-24">
    <h2 data-animate="type-settle" class="font-display text-3xl leading-tight md:text-5xl">The instructional designers</h2>
    <p data-animate="type-settle" class="mt-6 max-w-2xl leading-relaxed text-muted">
      Four designers, each carrying a distinct part of the build so a project
      never waits on a single specialty.
    </p>
    <div class="mt-10 grid gap-8 sm:grid-cols-2">
      {bench.map((designer, i) => (
        <div data-animate="frame-lift" class="glow-frame flex flex-col p-8">
          <svg class="h-10 w-10 text-accent" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={benchIcons[i]} />
          </svg>
          {designer.named ? (
            <>
              <p class="mt-5 font-mono text-xs uppercase tracking-[0.2em] text-accent">{designer.focus}</p>
              <h3 class="mt-2 font-display text-2xl leading-tight">{designer.name}</h3>
              <p class="mt-3 font-heading text-sm font-semibold tracking-wide text-ink/80">{designer.years} years</p>
              <p class="mt-3 leading-relaxed text-muted">{designer.background}</p>
              {designer.photo && (
                <img src={designer.photo} alt={designer.name} class="mt-5 rounded-lg" />
              )}
            </>
          ) : (
            <>
              <p class="mt-5 font-mono text-xs uppercase tracking-[0.2em] text-accent">Instructional designer</p>
              <h3 class="mt-2 font-display text-2xl leading-tight">{designer.focus}</h3>
              <p class="mt-4 leading-relaxed text-muted">Name and background to follow.</p>
              <p class="mt-2 leading-relaxed text-muted">Years of experience to follow.</p>
            </>
          )}
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl border-t border-ink/10 px-6 py-20 md:py-24">
    <h2 data-animate="type-settle" class="font-display text-3xl leading-tight md:text-5xl">Subject matter experts</h2>
    <p data-animate="type-settle" class="mt-6 max-w-2xl leading-relaxed text-muted">
      This is a separate bench from the instructional designers on purpose.
      Their job is not to write the course, it is to confirm that what the
      course teaches is technically correct in their field, so credentials
      matter here more than design background.
    </p>
    <div class="mt-10 grid gap-8 sm:grid-cols-2">
      {smes.map((sme, i) => (
        <div data-animate="frame-lift" class="glow-frame flex flex-col p-8">
          <svg class="h-10 w-10 text-accent" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={smeIcons[i]} />
          </svg>
          {sme.named ? (
            <>
              <p class="mt-5 font-mono text-xs uppercase tracking-[0.2em] text-accent">{sme.field}</p>
              <h3 class="mt-2 font-display text-2xl leading-tight">{sme.name}</h3>
              <p class="mt-3 font-heading text-sm font-semibold tracking-wide text-ink/80">{sme.credentialLine}</p>
              <p class="mt-3 leading-relaxed text-muted">{sme.bio}</p>
              {sme.photo && (
                <img src={sme.photo} alt={sme.name} class="mt-5 rounded-lg" />
              )}
            </>
          ) : (
            <>
              <p class="mt-5 font-mono text-xs uppercase tracking-[0.2em] text-accent">{sme.field}</p>
              <h3 class="mt-2 font-display text-2xl leading-tight">{sme.credentialLine}</h3>
              <p class="mt-4 leading-relaxed text-muted">Name and bio to follow.</p>
            </>
          )}
        </div>
      ))}
    </div>
    <p data-animate="type-settle" class="mt-10 max-w-2xl leading-relaxed text-muted">
      Subject matter experts validate the accuracy of content. They do not
      advise your business, provide professional services to your
      organization, or endorse it.
    </p>
  </section>

  <section class="mx-auto max-w-3xl border-t border-ink/10 px-6 py-20 md:py-24">
    <h2 data-animate="type-settle" class="font-display text-3xl leading-tight md:text-5xl">Who runs the engagement</h2>
    <p data-animate="type-settle" class="mt-6 leading-relaxed text-muted">
      The studio owner leads every engagement personally, with prior
      experience building training for the construction and skilled trades
      sector and a working understanding of what a jobsite audience actually
      needs from a course. They are currently pursuing IAAP CPACC
      certification in accessibility.
    </p>
  </section>

  <section class="px-6 pb-40 pt-16 md:pt-24">
    <div class="mx-auto max-w-4xl text-center">
      <p data-animate="type-settle" class="font-display text-[clamp(2.25rem,5.5vw,4.5rem)] leading-[1.05]">
        Talk to the person who will <span class="text-accent">actually run your project</span>
      </p>
      <p data-animate="type-settle" data-animate-delay="0.1" class="mx-auto mt-8 max-w-2xl text-lg leading-relaxed text-muted">
        No account manager relaying to a contractor you never meet. Tell us
        what you need built, and see the samples first if you want proof
        before you ask.
      </p>
      <div data-animate="type-settle" data-animate-delay="0.2" class="mt-10 flex flex-wrap items-center justify-center gap-6">
        <a href="/training/?inquire=1" class="btn-draw">Ask about a project</a>
        <a href="/training/samples/" class="font-heading text-sm font-semibold tracking-wide text-accent hover:text-accent-hot">
          See the samples <span class="inline-block transition-transform group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
