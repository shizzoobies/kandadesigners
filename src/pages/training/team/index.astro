---
// Meet the team: /training/team/. One org chart: the two owners on top,
// the instructional design bench below them, the subject matter experts
// below that. Every person is a round portrait with a name and a title,
// and opens a bio dialog. People come from src/data/training.js (`team`);
// the bench's four focus areas come from `bench`. A person with no photo
// shows the drawn placeholder and an empty bio shows the "to follow" line,
// so the layout is final while headshots and approved wording arrive.
//
// House rules: no em dashes, no pills, no numbered kickers, no employer
// names, no pricing, no throughput numbers. Never name an SME's employer.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TrainingSubnav from '../../../components/TrainingSubnav.astro';
import { team, bench, combinedYears } from '../../../data/training.js';

const PAGE_URL = 'https://ka-performancefl.com/training/team/';
const PLACEHOLDER = '/images/training/sme-placeholder.svg';

// Rendered as a rounded, spelled-out figure, never the precise number.
const YEARS_AS_WORDS = { 60: 'sixty' };
const combinedYearsWord = YEARS_AS_WORDS[combinedYears] ?? String(combinedYears);

const tiers = [
  { id: 'owners', label: 'Owners', people: team.owners, size: 'lg' },
  { id: 'designers', label: 'Instructional designers', people: team.designers, size: 'md' },
  { id: 'smes', label: 'Subject matter experts', people: team.smes, size: 'md' },
];

// One flat list so every dialog gets a stable index.
const people = tiers.flatMap((t) => t.people.map((p) => ({ ...p, tier: t.id })));
const indexOf = (p) => people.findIndex((x) => x.name === p.name);

const bioFor = (p) =>
  p.bio ||
  'The approved bio goes here once this person has signed off on the wording. It will cover their field, what they carry on a K & A project, and the work they are proudest of.';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://ka-performancefl.com/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://ka-performancefl.com/services/' },
    { '@type': 'ListItem', position: 3, name: 'Training content', item: 'https://ka-performancefl.com/training/' },
    { '@type': 'ListItem', position: 4, name: 'Meet the team', item: PAGE_URL },
  ],
};
---
<BaseLayout
  clientRouter
  title="Meet the Training Team | K & A Performance"
  description="The people behind K & A's training content: the two owners, the instructional design bench, and the credentialed subject matter experts who check the field details."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} />

  <section class="mx-auto max-w-4xl px-6 pt-40 pb-16 md:pt-48">
    <p data-animate="type-settle" class="font-mono text-sm uppercase tracking-[0.3em] text-muted">
      <a href="/training/" class="transition-colors hover:text-accent">Training content</a>
      <span class="text-accent" aria-hidden="true">&middot;</span> Meet the team
    </p>
    <h1 data-animate="type-settle" data-animate-delay="0.1" class="mt-6 font-display text-[clamp(2.25rem,6vw,4.5rem)] leading-[1.04]">
      The people who <span class="text-accent">actually build it</span>
    </h1>
    <p data-animate="type-settle" data-animate-delay="0.2" class="mt-8 max-w-2xl text-lg leading-relaxed text-muted">
      Every project runs under a written agreement, with a named lead and a
      single point of contact from the first call to final delivery. Two owners
      you deal with directly, a bench with roughly {combinedYearsWord} years of
      combined experience behind them, and the experts who check the field
      details before anything ships. Select anyone to read their bio.
    </p>
  </section>

  <TrainingSubnav />

  <!-- The org chart. Connector rules are decorative and drawn with CSS on
       the tier rows; the structure itself is three labelled lists. -->
  <section class="mx-auto max-w-6xl border-t border-ink/10 px-6 py-20 md:py-24" aria-labelledby="team-heading">
    <h2 id="team-heading" class="sr-only">The team</h2>
    <div class="org">
      {tiers.map((t, ti) => (
        <div class:list={['org-tier', `org-tier-${t.size}`, { 'org-tier-first': ti === 0 }]} style={`--n: ${t.people.length}`}>
          <p class="org-label" id={`tier-${t.id}`}>{t.label}</p>
          <ul class="org-row" aria-labelledby={`tier-${t.id}`}>
            {t.people.map((p) => {
              const i = indexOf(p);
              return (
                <li class="org-node">
                  <button type="button" class="org-person" data-person-open={i} aria-haspopup="dialog" aria-controls={`person-bio-${i}`}>
                    <span class="org-portrait">
                      <img src={p.photo || PLACEHOLDER} alt="" width="400" height="500" loading="lazy" />
                    </span>
                    <span class="org-name">{p.name}</span>
                    <span class="org-title">{p.line}</span>
                  </button>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>
    <p data-animate="type-settle" class="mx-auto mt-14 max-w-2xl text-center text-sm leading-relaxed text-muted">
      Subject matter experts validate the accuracy of content. They do not
      advise your business, provide professional services to your
      organization, or endorse it.
    </p>
  </section>

  <section class="mx-auto max-w-6xl border-t border-ink/10 px-6 py-20 md:py-24">
    <h2 data-animate="type-settle" class="font-display text-3xl leading-tight md:text-5xl">What the bench covers</h2>
    <p data-animate="type-settle" class="mt-6 max-w-2xl leading-relaxed text-muted">
      Four kinds of work, each carried by someone who does it first, so a
      project never waits on a single specialty.
    </p>
    <div class="mt-10 grid gap-8 sm:grid-cols-2">
      {bench.map((b) => (
        <div data-animate="frame-lift" class="glow-frame tr-frame backdrop-card flex min-h-[11rem] flex-col justify-end p-8" style={`--bd: url('${b.backdrop}')`}>
          <h3 class="max-w-[22ch] font-display text-2xl leading-tight">{b.focus}</h3>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-32 pt-8 text-center md:pb-40">
    <h2 data-animate="type-settle" class="font-display text-3xl leading-tight md:text-5xl">
      Talk to the person who will <span class="text-accent">actually run your project</span>
    </h2>
    <p data-animate="type-settle" class="mx-auto mt-6 max-w-xl leading-relaxed text-muted">
      No account manager relaying to a contractor you never meet. Tell us what
      you need built, and see the samples first if you want proof before you ask.
    </p>
    <div data-animate="type-settle" class="mt-10 flex flex-wrap items-center justify-center gap-6">
      <a href="/training/?inquire=1" class="btn-draw">Ask about a project</a>
      <a href="/training/samples/" class="font-heading text-sm font-semibold tracking-wide text-accent hover:text-accent-hot">See the samples <span aria-hidden="true">&rarr;</span></a>
    </div>
  </section>

  {people.map((p, i) => (
    <dialog id={`person-bio-${i}`} class="person-dialog" aria-labelledby={`person-bio-title-${i}`}>
      <div class="glow-frame tr-frame person-dialog-card">
        <button type="button" class="person-dialog-close" data-person-close aria-label="Close">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><line x1="5" y1="5" x2="15" y2="15" /><line x1="15" y1="5" x2="5" y2="15" /></svg>
        </button>
        <div class="person-dialog-grid">
          <img src={p.photo || PLACEHOLDER} alt="" width="400" height="500" class="person-dialog-photo" />
          <div>
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">{p.role}</p>
            <h3 id={`person-bio-title-${i}`} tabindex="-1" class="mt-2 font-display text-3xl leading-tight">{p.name}</h3>
            <p class="mt-2 font-heading text-sm font-semibold tracking-wide text-ink/80">{p.line}</p>
            <p class="mt-5 leading-relaxed text-muted">{bioFor(p)}</p>
            {p.link && (
              <p class="mt-5"><a href={p.link} data-astro-reload class="font-heading text-sm font-semibold tracking-wide text-accent underline underline-offset-4 hover:text-accent-hot">See their art</a></p>
            )}
            {p.tier === 'smes' && (
              <p class="mt-5 border-t border-ink/10 pt-4 text-sm leading-relaxed text-muted">
                Subject matter experts validate the accuracy of course content. They do not advise K &amp; A clients, provide professional services to them, or endorse them.
              </p>
            )}
          </div>
        </div>
      </div>
    </dialog>
  ))}
</BaseLayout>

<style>
  /* ---------- the org chart ---------- */
  .org {
    --line: rgb(34 28 21 / 0.16);
    --stub: 1.6rem;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }
  .org-tier {
    position: relative;
    padding-top: calc(var(--stub) + 1.6rem);
  }
  .org-tier-first {
    padding-top: 0;
  }
  /* A vertical drop from the tier above into this tier's rail. */
  .org-tier:not(.org-tier-first)::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    width: 1px;
    height: var(--stub);
    background: var(--line);
  }
  .org-label {
    position: relative;
    margin: 0 0 1.6rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .org-row {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 1rem;
    margin: 0 auto;
    padding: var(--stub) 0 0;
    list-style: none;
    width: min(100%, calc(var(--n) * 15rem));
  }
  .org-tier-lg .org-row {
    width: min(100%, calc(var(--n) * 17rem));
  }
  /* The rail across the row, from the first node's centre to the last's. */
  .org-row::before {
    content: '';
    position: absolute;
    top: 0;
    left: calc(50% / var(--n));
    right: calc(50% / var(--n));
    height: 1px;
    background: var(--line);
  }
  /* Each node's stub up to the rail. */
  .org-node {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .org-node::before {
    content: '';
    position: absolute;
    left: 50%;
    top: calc(-1 * var(--stub));
    width: 1px;
    height: var(--stub);
    background: var(--line);
  }
  /* A single-node row has no rail to speak of; the stub alone connects it. */
  .org-row[style*='--n: 1']::before {
    display: none;
  }

  .org-person {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    width: 100%;
    padding: 0.75rem 0.5rem 0.5rem;
    background: none;
    border: 0;
    border-radius: 12px;
    text-align: center;
    cursor: pointer;
    color: var(--color-ink);
  }
  .org-portrait {
    position: relative;
    display: block;
    width: 7.25rem;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-canvas);
    box-shadow:
      0 0 0 3px var(--color-surface),
      0 0 0 4px rgb(34 28 21 / 0.12),
      0 14px 30px -16px rgb(34 28 21 / 0.35);
    transition: transform var(--dur-fast) var(--ease-out-expo), box-shadow var(--dur-fast) var(--ease-out-expo);
  }
  .org-tier-lg .org-portrait {
    width: 9.5rem;
  }
  .org-portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .org-person:hover .org-portrait,
  .org-person:focus-visible .org-portrait {
    transform: translateY(-3px);
    box-shadow:
      0 0 0 3px var(--color-surface),
      0 0 0 5px var(--color-accent),
      0 18px 34px -16px rgb(34 28 21 / 0.4);
  }
  .org-name {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    line-height: 1.15;
  }
  .org-tier-lg .org-name {
    font-size: 1.45rem;
  }
  .org-title {
    display: block;
    margin-top: 0.15rem;
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-muted);
    max-width: 16ch;
  }

  /* Narrow screens: rows wrap two across and the rail no longer lines up
     with the nodes, so the connectors go and the labels carry the tiers. */
  @media (max-width: 640px) {
    .org-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
      padding-top: 0;
    }
    .org-row::before,
    .org-node::before,
    .org-tier::before {
      display: none;
    }
    .org-tier {
      padding-top: 2.5rem;
    }
    .org-portrait { width: 6.25rem; }
    .org-tier-lg .org-portrait { width: 7.5rem; }
  }

  /* ---------- the bio dialog ---------- */
  .person-dialog {
    margin: auto;
    width: min(44rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 2.5rem);
    overflow-y: auto;
    background: transparent;
    border: none;
    padding: 0;
    border-radius: 1rem;
  }
  .person-dialog::backdrop {
    background: rgb(34 28 21 / 0.45);
    backdrop-filter: blur(5px);
  }
  .person-dialog-card {
    position: relative;
    padding: 2rem;
  }
  .person-dialog-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.5rem;
    color: var(--color-muted);
    transition: color var(--dur-fast) var(--ease-out-expo);
  }
  .person-dialog-close:hover { color: var(--color-ink); }
  .person-dialog-grid {
    display: grid;
    gap: 1.75rem;
    grid-template-columns: 9rem 1fr;
    align-items: start;
  }
  .person-dialog-photo {
    width: 9rem;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    box-shadow: 0 0 0 3px var(--color-surface), 0 0 0 4px rgb(34 28 21 / 0.12);
  }
  @media (max-width: 560px) {
    .person-dialog-grid { grid-template-columns: 1fr; }
    .person-dialog-photo { width: 7.5rem; }
  }
  .person-dialog[open] {
    animation: person-in 0.4s var(--ease-out-expo);
  }
  .person-dialog[open]::backdrop {
    animation: person-fade 0.3s ease;
  }
  @keyframes person-in {
    from { transform: translateY(14px) scale(0.985); }
  }
  @keyframes person-fade {
    from { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .org-portrait { transition: none; }
    .person-dialog[open], .person-dialog[open]::backdrop { animation: none; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  // Bio dialogs: native <dialog> gives Esc and focus containment. Focus goes
  // to the heading on open and back to the opener on close; a click on the
  // backdrop targets the dialog element itself. Re-run after every
  // client-side navigation; the data-bound guard skips a DOM already wired.
  // The org chart's entrance. It used to be one type-settle on the whole
  // chart, which slid a thousand-pixel block up by sixty percent and only
  // once its top crossed 85% of the viewport, so on a laptop the team looked
  // missing until the reader scrolled past the hero (Alex, 2026-09-04). Now
  // the owners tier arrives on load with no scroll gate, and each lower tier
  // staggers in on its own as it enters. Set-then-to rather than from(), so
  // nothing paints in its resting state and then jumps back (see motion.js).
  const revealTeam = (root: HTMLElement) => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    gsap.registerPlugin(ScrollTrigger);
    root.querySelectorAll<HTMLElement>('.org-tier').forEach((tier, i) => {
      const parts = tier.querySelectorAll<HTMLElement>('.org-label, .org-node');
      gsap.set(parts, { y: 26, opacity: 0, willChange: 'transform, opacity' });
      const show = () =>
        gsap.to(parts, {
          y: 0, opacity: 1, duration: 0.85, ease: 'expo.out',
          stagger: 0.07, overwrite: true, clearProps: 'transform,willChange',
        });
      if (i === 0) show();
      else ScrollTrigger.create({ trigger: tier, start: 'top 92%', once: true, onEnter: show });
    });
  };

  const initTeam = () => {
    const root = document.querySelector('.org') as HTMLElement | null;
    if (!root || root.dataset.bound) return;
    root.dataset.bound = '1';
    revealTeam(root);

    let opener: HTMLElement | null = null;
    const lockScroll = (on: boolean) => { document.documentElement.style.overflow = on ? 'hidden' : ''; };

    document.querySelectorAll<HTMLElement>('[data-person-open]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const d = document.getElementById('person-bio-' + btn.dataset.personOpen) as HTMLDialogElement | null;
        if (!d) return;
        opener = btn;
        d.showModal();
        lockScroll(true);
        (d.querySelector('h3[tabindex="-1"]') as HTMLElement | null)?.focus();
      });
    });

    document.querySelectorAll<HTMLDialogElement>('dialog.person-dialog').forEach((d) => {
      d.querySelector('[data-person-close]')?.addEventListener('click', () => d.close());
      d.addEventListener('click', (e) => { if (e.target === d) d.close(); });
      d.addEventListener('close', () => {
        lockScroll(false);
        opener?.focus();
        opener = null;
      });
    });
  };
  initTeam();
  document.addEventListener('astro:page-load', initTeam);
</script>
