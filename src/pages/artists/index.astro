---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { artists } from '../../data/artists.js';
---
<BaseLayout
  title="Commissioned Artwork & Illustration | K & A Performance"
  description="Original illustration, brand artwork, and merchandise design from our collaborating artists, commissioned and art-directed through K & A Performance."
>
  <!-- Editorial header -->
  <section class="mx-auto max-w-6xl px-6 pt-40 pb-20 md:pt-48">
    <p data-animate="type-settle" class="font-mono text-sm uppercase tracking-[0.3em] text-muted">Artists</p>
    <h1 data-animate="type-settle" data-animate-delay="0.1" class="mt-6 font-display text-[clamp(2.75rem,8vw,6rem)] leading-[1.02]">
      In-house <span class="text-accent">artistry</span>
    </h1>
    <p data-animate="type-settle" data-animate-delay="0.2" class="mt-8 max-w-2xl text-lg leading-relaxed text-muted">
      Original illustration and artwork through our collaborating artists, available on request. Every artist is commissioned and art-directed through K &amp;
      A, so you get one point of contact and one consistent standard across the whole build. Most new builds include budget for a custom logo if you want one.
    </p>
    <p data-animate="type-settle" data-animate-delay="0.3" class="mt-6 max-w-2xl leading-relaxed text-muted">
      Commissioning through us means you are not left managing an artist. You
      tell us what the piece has to do, we turn that into a brief, and we carry
      the back and forth about revisions, file formats, print bleed, and the
      awkward question of whether a mark still reads at the size it will really
      be used. One contract, one invoice, one person answering email.
    </p>
    <p data-animate="type-settle" data-animate-delay="0.4" class="mt-5 max-w-2xl leading-relaxed text-muted">
      The three of them do genuinely different work, so the first conversation
      is usually about which one fits. Bobbie illustrates, picture books
      included. Jon Marc works in graphic design and visual identity. Nicole,
      who is based in Jacksonville, designs brand identity and merchandise:
      coins, apparel, caps, invitation suites, the things that have to survive
      being worn and handed out rather than just posted. Artwork can ride along
      with a website build or stand completely on its own.
    </p>
  </section>

  <!-- Two large cards -->
  <section class="mx-auto max-w-6xl px-6 pb-32 md:pb-40">
    <div class="grid gap-12 md:grid-cols-3 md:gap-10">
      {artists.map((artist) => (
        <div data-animate="frame-lift">
          {artist.live ? (
            <a href={`/artists/${artist.slug}/`} class="group block">
              <figure class="glow-frame relative">
                <img
                  src={artist.portrait}
                  alt={artist.portraitAlt || `${artist.name}, ${artist.discipline}`}
                  class="aspect-[4/3] w-full object-cover"
                  loading="lazy"
                />
              </figure>
              <h2 class="mt-6 font-display text-3xl transition-colors group-hover:text-accent md:text-4xl">{artist.name}</h2>
              <p class="mt-2 font-mono text-sm uppercase tracking-[0.3em] text-muted">{artist.discipline}</p>
            </a>
          ) : (
            <>
              <figure class="glow-frame relative">
                <img
                  src={artist.portrait}
                  alt={artist.portraitAlt || `${artist.name}, ${artist.discipline}`}
                  class="aspect-[4/3] w-full object-cover"
                  loading="lazy"
                />
                <span class="coming-ribbon">Portfolio coming soon</span>
              </figure>
              <h2 class="mt-6 font-display text-3xl md:text-4xl">{artist.name}</h2>
              <p class="mt-2 font-mono text-sm uppercase tracking-[0.3em] text-muted">{artist.discipline}</p>
            </>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- CTA band -->
  <section class="border-y border-ink/10 bg-surface">
    <div class="mx-auto max-w-4xl px-6 py-28 text-center md:py-36">
      <p data-animate="type-settle" class="font-display text-[clamp(2.25rem,6vw,4.5rem)] leading-[1.05]">
        Original art, <span class="text-accent">commissioned through us</span>
      </p>
      <p data-animate="type-settle" data-animate-delay="0.1" class="mx-auto mt-8 max-w-2xl text-lg leading-relaxed text-muted">
        Don't need a website? If you want one of our artists for something
        else, reach out. We'll make it happen.
      </p>
      <div data-animate="type-settle" data-animate-delay="0.2" class="mt-10">
        <a href="/contact/" class="btn-accent">Start a commission</a>
      </div>
    </div>
  </section>
</BaseLayout>
