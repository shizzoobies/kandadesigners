---
import BaseLayout from './BaseLayout.astro';
import BookFlip from '../components/BookFlip.astro';

const { artist } = Astro.props;
---
<BaseLayout
  title={`${artist.name} | Artist Collaborations | K & A Performance`}
  description={`${artist.name}: ${artist.discipline}. Original artwork commissioned and art-directed through K & A Performance.`}
>
  <!-- Portrait hero -->
  <section class="mx-auto max-w-6xl px-6 pt-40 pb-20 md:pt-48">
    <div class="grid items-center gap-12 md:grid-cols-2 md:gap-16">
      <figure data-animate="frame-lift" class="glow-frame">
        <img
          src={artist.portrait}
          alt={artist.portraitAlt || `${artist.name}, ${artist.discipline}`}
          class="aspect-[4/5] w-full object-cover"
        />
      </figure>
      <div>
        <p data-animate="type-settle" class="font-mono text-sm uppercase tracking-[0.3em] text-accent">
          Collaborating artist
        </p>
        <h1 data-animate="type-settle" data-animate-delay="0.1" class="mt-6 font-display text-[clamp(3rem,9vw,6.5rem)] leading-[0.98]">
          {artist.name}
        </h1>
        <p data-animate="type-settle" data-animate-delay="0.2" class="mt-6 font-mono text-sm uppercase tracking-[0.3em] text-muted">
          {artist.discipline}
        </p>
      </div>
    </div>
  </section>

  <!-- Bio -->
  <section class="mx-auto max-w-3xl px-6 pb-8">
    <p data-animate="type-settle" class="text-lg leading-relaxed text-muted">
      {artist.bio}
    </p>
  </section>

  <!-- Style statement pull-quote -->
  <section class="mx-auto max-w-4xl px-6 py-20 md:py-28">
    <blockquote data-animate="type-settle" class="border-l-2 border-accent pl-8">
      <p class="font-display text-3xl leading-tight md:text-5xl">
        {artist.statement}
      </p>
    </blockquote>
  </section>

  <!-- Featured book: readable, page-turnable, sits ahead of the tile work -->
  {artist.book && (
    <section class="border-y border-ink/10 bg-surface">
      <div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
        <p data-animate="type-settle" class="font-mono text-sm uppercase tracking-[0.3em] text-accent">
          {artist.book.eyebrow}
        </p>
        <h2 data-animate="type-settle" data-animate-delay="0.1" class="mt-6 font-display text-3xl md:text-5xl">
          {artist.book.title}
        </h2>
        <p data-animate="type-settle" data-animate-delay="0.2" class="mt-6 max-w-3xl text-lg leading-relaxed text-muted">
          {artist.book.blurb}
        </p>
        <div data-animate="frame-lift" class="mt-14">
          <BookFlip book={artist.book} />
        </div>
      </div>
    </section>
  )}

  <!-- Categorised body of work (artists whose portfolio is organised by discipline) -->
  {artist.sections?.length > 0 && (
    <section class="mx-auto max-w-6xl px-6 pb-8">
      {artist.sections.map((sec) => (
        <div id={sec.id} class="pb-20 md:pb-28">
          <div class="flex items-baseline justify-between gap-6 border-b border-ink/10 pb-5">
            <h2 data-animate="type-settle" class="font-display text-3xl md:text-5xl">{sec.title}</h2>
            <span class="hidden shrink-0 font-mono text-xs uppercase tracking-[0.25em] text-muted sm:block">
              {sec.items.length} pieces
            </span>
          </div>
          {sec.blurb && (
            <p data-animate="type-settle" data-animate-delay="0.1" class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">
              {sec.blurb}
            </p>
          )}
          <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {sec.items.slice(0, 3).map((item) => (
              <figure data-animate="tile-settle" class="glow-frame">
                <img
                  src={item.src}
                  alt={item.alt}
                  class:list={[
                    'aspect-square w-full',
                    item.fit === 'contain' ? 'bg-[#F8F5F2] object-contain p-5' : 'object-cover',
                  ]}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            ))}
          </div>

          {sec.items.length > 3 && (
            <>
              <div class="mt-8">
                <button
                  type="button"
                  data-archive-open={`archive-${sec.id}`}
                  class="cursor-pointer font-mono text-sm uppercase tracking-[0.3em] text-accent transition-colors hover:text-accent-hot"
                >
                  <span aria-hidden="true" class="mr-3 font-bold">+</span>See {sec.items.length - 3} more
                </button>
              </div>

              <dialog id={`archive-${sec.id}`} class="archive-modal" aria-label={`More ${sec.title} work by ${artist.name}`}>
                <div class="archive-head">
                  <p class="font-mono text-xs uppercase tracking-[0.25em] text-muted">
                    <span class="text-accent">{sec.title}</span> &middot; {artist.name}
                  </p>
                  <button type="button" data-archive-close class="archive-x" aria-label="Close gallery">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m3 3 10 10M13 3 3 13"/></svg>
                  </button>
                </div>
                <div data-lenis-prevent class="mt-5 min-h-0 flex-1 overflow-y-auto pr-1">
                  <div class="grid grid-cols-2 gap-5 md:grid-cols-3">
                    {sec.items.slice(3).map((item, i) => (
                      <figure class="glow-frame tile-pop" style={`--i:${i}`}>
                        <img
                          src={item.src}
                          alt={item.alt}
                          class:list={[
                            'aspect-square w-full',
                            item.fit === 'contain' ? 'bg-[#F8F5F2] object-contain p-4' : 'object-cover',
                          ]}
                          loading="lazy"
                          decoding="async"
                        />
                      </figure>
                    ))}
                  </div>
                </div>
              </dialog>
            </>
          )}
        </div>
      ))}
    </section>
  )}

  <!-- Case study -->
  {artist.caseStudy && (
    <section class="border-y border-ink/10 bg-surface">
      <div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
        <p data-animate="type-settle" class="font-mono text-sm uppercase tracking-[0.3em] text-accent">
          {artist.caseStudy.eyebrow}
        </p>
        <h2 data-animate="type-settle" data-animate-delay="0.1" class="mt-6 font-display text-3xl md:text-5xl">
          {artist.caseStudy.heading}
        </h2>
        <p data-animate="type-settle" data-animate-delay="0.2" class="mt-6 max-w-3xl text-lg leading-relaxed text-muted">
          {artist.caseStudy.body}
        </p>
        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {artist.caseStudy.items.map((item) => (
            <figure data-animate="tile-settle" class="glow-frame">
              <img src={item.src} alt={item.alt} class="aspect-square w-full bg-[#F8F5F2] object-contain p-5" loading="lazy" decoding="async" />
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Gallery (artists with a single curated set) -->
  {artist.gallery?.length > 0 && (
  <section class="mx-auto max-w-6xl px-6 pb-24 md:pb-32">
    <h2 data-animate="type-settle" class="font-display text-3xl md:text-5xl">Selected work</h2>
    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {artist.gallery.map((item) => (
        <figure data-animate="tile-settle" class="glow-frame">
          <img
            src={item.src}
            alt={item.alt}
            class:list={[
              'aspect-[4/5] w-full',
              item.fit === 'contain' ? 'bg-[#F8F5F2] object-contain p-6' : 'object-cover',
            ]}
            loading="lazy"
          />
        </figure>
      ))}
    </div>

    {artist.archive?.length > 0 && (
      <>
        <div class="mt-16">
          <button
            type="button"
            data-archive-open="archive-modal"
            class="cursor-pointer font-mono text-sm uppercase tracking-[0.3em] text-accent transition-colors hover:text-accent-hot"
          >
            <span aria-hidden="true" class="mr-3 font-bold">+</span>See more of {artist.name}&rsquo;s work
          </button>
        </div>

        <dialog id="archive-modal" class="archive-modal" aria-label={`More of ${artist.name}'s work`}>
          <div class="archive-head">
            <p class="font-mono text-xs uppercase tracking-[0.25em] text-muted">
              More of <span class="text-accent">{artist.name}&rsquo;s</span> work
            </p>
            <button type="button" data-archive-close class="archive-x" aria-label="Close gallery">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m3 3 10 10M13 3 3 13"/></svg>
            </button>
          </div>
          <div data-lenis-prevent class="mt-5 min-h-0 flex-1 overflow-y-auto pr-1">
            <div class="grid grid-cols-2 gap-5 md:grid-cols-3">
              {artist.archive.map((item, i) => (
                <figure class="glow-frame tile-pop" style={`--i:${i}`}>
                  <img
                    src={item.src}
                    alt={item.alt}
                    class="aspect-square w-full object-cover"
                    loading="lazy"
                  />
                </figure>
              ))}
            </div>
          </div>
        </dialog>
      </>
    )}
  </section>
  )}

  <!-- CTA band: every engagement routes through K & A -->
  <section class="border-y border-ink/10 bg-surface">
    <div class="mx-auto max-w-4xl px-6 py-28 text-center md:py-36">
      <p data-animate="type-settle" class="font-mono text-sm uppercase tracking-[0.3em] text-accent">
        Commission through K &amp; A
      </p>
      <p data-animate="type-settle" data-animate-delay="0.1" class="mt-8 font-display text-[clamp(2.25rem,6vw,4.5rem)] leading-[1.05]">
        Want work like this in your <span class="text-accent">build?</span>
      </p>
      <p data-animate="type-settle" data-animate-delay="0.2" class="mx-auto mt-8 max-w-2xl text-lg leading-relaxed text-muted">
        Every collaboration is commissioned, art-directed, and delivered through
        K &amp; A: one point of contact, one standard, one invoice. Tell us what
        you have in mind and we&rsquo;ll bring the right artist to your project.
      </p>
      <div data-animate="type-settle" data-animate-delay="0.3" class="mt-10">
        <a href="/contact/" class="btn-accent">Start a commission</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .archive-modal {
    margin: auto;
    width: 64rem;
    max-width: calc(100vw - 2rem);
    max-height: calc(100vh - 3rem);
    display: none;
    flex-direction: column;
    border: 1px solid rgb(34 28 21 / 0.1);
    border-radius: 16px;
    background: var(--color-surface);
    padding: 1.4rem 1.5rem;
    box-shadow:
      0 24px 80px -24px rgb(34 28 21 / 0.4),
      0 0 60px -20px rgb(154 52 18 / 0.25);
    color: var(--color-ink);
  }
  .archive-modal[open] {
    display: flex;
  }
  .archive-modal::backdrop {
    background: rgb(34 28 21 / 0.4);
    backdrop-filter: blur(6px);
  }
  .archive-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .archive-x {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    color: var(--color-muted);
    transition: color var(--dur-fast) ease, background var(--dur-fast) ease;
  }
  .archive-x:hover {
    color: var(--color-ink);
    background: rgb(34 28 21 / 0.06);
  }
</style>

<script>
  // One artist page can now hold several archive dialogs (one per section), so
  // wire them generically by data attribute rather than by a single hardcoded id.
  document.querySelectorAll<HTMLButtonElement>('[data-archive-open]').forEach((btn) => {
    const dlg = document.getElementById(btn.dataset.archiveOpen!) as HTMLDialogElement | null;
    btn.addEventListener('click', () => dlg?.showModal());
  });
  document.querySelectorAll<HTMLDialogElement>('dialog.archive-modal').forEach((dlg) => {
    dlg.querySelector('[data-archive-close]')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close(); // backdrop click
    });
  });
</script>
