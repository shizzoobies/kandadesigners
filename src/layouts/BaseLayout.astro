---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SiteGuide from '../components/SiteGuide.astro';
import StartProjectModal from '../components/StartProjectModal.astro';
import { phone, email, hours } from '../data/contact.js';
import { socials } from '../data/social.js';
import { locations, regions, citiesServed } from '../data/locations.js';
import { ClientRouter } from 'astro:transitions';

const onContactPage = Astro.url.pathname.startsWith('/contact');

interface Props {
  title: string;
  description: string;
  /** Page-specific OG card, absolute path with its ?v= cache key. */
  ogImage?: string;
  /** Opt this page into Astro's ClientRouter (see the head comment). */
  clientRouter?: boolean;
  /**
   * Keep this page out of the index. Static files under public/ get the same
   * treatment from the X-Robots-Tag rules in public/_headers, but an Astro
   * route needs the meta tag, and until this prop existed no page on the site
   * emitted one at all. The canonical stays in place either way: a noindexed
   * page still declaring which URL it is is what stops a duplicate being
   * picked in its place. Plain `noindex`, no `nofollow`: where a page should
   * also not pass links, public/_headers already says so, and the two sources
   * should not disagree about the same page.
   */
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = '/images/og-card.png?v=2',
  clientRouter = false,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Sitewide identity for search engines. ProfessionalService (a LocalBusiness
// subtype) because the studio is a real service-area business in Gainesville.
// The address is deliberately city-level only: there is no public street
// address, and claiming less beats asserting something a searcher could turn
// up at. Do not add `streetAddress` until one is genuinely published. The
// phone has been published since 2026-09-25 (header, footer, contact page),
// so `telephone` is here, read from src/data/contact.js like every tel: link.
// The hours have been published since 2026-10-06 (footer and contact page,
// copied from the Google Business Profile), so openingHoursSpecification is
// here too, read from the same file. No `aggregateRating` either: our reviews live on Google, and marking up
// someone else's reviews as our own violates their structured-data guidelines.
const ORG_ID = 'https://ka-performancefl.com/#organization';
const MAP_URL = 'https://g.page/r/CbVcBGWcGmNzEBM';
// Canonical spellings, approved 2026-08-09, now kept in src/data/locations.js
// (`citiesServed`, fifteen towns in three regions). Keep that list and the
// copy on the site saying the same thing; a schema that claims towns the
// pages never mention is the definition of a doorway signal.
//
// The Ellenton office gets its own node, a child of the organization. It is
// city-only until `locations.ellenton.published` flips on the day the lease
// is signed; only then do streetAddress and postalCode appear. No
// openingHours on this node until the office's own hours are known (the
// published hours belong to the organization, above). This is the node the office's
// Google, Apple and Bing listings will point at.
const ellenton = locations.ellenton;
const officeRegion = regions.find((r) => r.key === 'bradenton-sarasota');
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': ORG_ID,
      name: 'K & A Performance',
      alternateName: 'K&A Performance',
      url: 'https://ka-performancefl.com/',
      email,
      telephone: phone.schema,
      description:
        'Web design and AI integration studio in Gainesville, Florida, building fast, accessible, animated websites for businesses that refuse to blend in.',
      logo: {
        '@type': 'ImageObject',
        url: 'https://ka-performancefl.com/images/logo-lockup.webp',
        width: 800,
        height: 303,
      },
      image: 'https://ka-performancefl.com/images/og-card.png',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Gainesville',
        addressRegion: 'FL',
        addressCountry: 'US',
      },
      hasMap: MAP_URL,
      // Closed days carry no `opens` and are left out: an absent day is how
      // schema.org, and Google, read closed.
      openingHoursSpecification: hours
        .filter((h) => h.opens)
        .map((h) => ({
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: h.days,
          opens: h.opens,
          closes: h.closes,
        })),
      // Free-text by design; matches the public budget bands on the services
      // pages and the Launch's published price, nothing invented.
      priceRange: 'Under $2,000 to $10,000+',
      areaServed: citiesServed.map((name) => ({
        '@type': 'City',
        name,
        containedInPlace: { '@type': 'State', name: 'Florida' },
      })),
      knowsAbout: [
        'Web design',
        'AI integration',
        'Web accessibility',
        'Search engine optimization',
        'Brand identity',
      ],
      founder: [
        {
          '@type': 'Person',
          name: 'Alex Anderson',
          // LinkedIn belongs to Alex, not the studio, so it hangs off his node
          // rather than the organisation's sameAs.
          sameAs: ['https://www.linkedin.com/in/alexander-anderson-73a870252/'],
        },
        { '@type': 'Person', name: 'Kristina Anderson' },
      ],
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'sales',
        email,
        telephone: phone.schema,
        areaServed: 'US',
        availableLanguage: 'English',
      },
      // Only profiles we actually own and can point at. No placeholders.
      sameAs: [MAP_URL, ...socials.map((s) => s.href)],
    },
    {
      '@type': 'ProfessionalService',
      '@id': 'https://ka-performancefl.com/#ellenton',
      parentOrganization: { '@id': ORG_ID },
      name: 'K & A Performance, Ellenton',
      url: new URL(ellenton.page, 'https://ka-performancefl.com/').href,
      areaServed: officeRegion.cities.map((name) => ({
        '@type': 'City',
        name,
        containedInPlace: { '@type': 'State', name: 'Florida' },
      })),
      address: {
        '@type': 'PostalAddress',
        ...(ellenton.published ? { streetAddress: ellenton.street } : {}),
        addressLocality: ellenton.name,
        addressRegion: ellenton.region,
        ...(ellenton.published ? { postalCode: ellenton.postalCode } : {}),
        addressCountry: 'US',
      },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://ka-performancefl.com/#website',
      url: 'https://ka-performancefl.com/',
      // The WebSite node, not the Organization, is what Google's site-name
      // feature reads. Without alternateName here Google was deriving the
      // SERP site name from the domain ("Ka performancefl"). The name string
      // must match the GBP exactly: "K & A Performance", spaces and all.
      name: 'K & A Performance',
      alternateName: ['K&A Performance', 'KA Performance'],
      publisher: { '@id': ORG_ID },
      inLanguage: 'en-US',
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical.href}#webpage`,
      url: canonical.href,
      name: title,
      description,
      isPartOf: { '@id': 'https://ka-performancefl.com/#website' },
      about: { '@id': ORG_ID },
      inLanguage: 'en-US',
    },
  ],
};
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- The two faces every page paints above the fold: Schibsted Grotesk is
         .font-display (the h1), Atkinson Hyperlegible Next is body and heading
         text. The italic cuts, Fraunces (logo lockup only) and Lenia Mono
         (which ships as .woff, not .woff2) are deliberately not preloaded:
         preloading a face nothing above the fold uses just delays these two. -->
    <link rel="preload" href="/fonts/Schibsted-VF.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/AtkinsonNext-VF.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Meta domain verification. Must stay in place permanently: Meta re-checks
         periodically and un-verifies the domain if the tag disappears. -->
    <meta name="facebook-domain-verification" content="2go7mrp4qq77ardj8lsayydn6879x4" />
    <link rel="stylesheet" href="/privacy-consent.css" />
    <script is:inline src="/privacy-consent.js"></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <!-- ?v= bumps whenever the artwork changes: /images/* carries a 24h
         max-age, so reusing a bare filename would serve the old mark for a
         day, and social scrapers cache their copy far longer than that. -->
    <!-- transition:persist on the icons: on ClientRouter pages Astro removes
         and re-appends every head element it does not recognise as persisted,
         and Chrome drops the tab icon whenever the icon link leaves the
         document, so the favicon vanished on training tab clicks. -->
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png?v=2" transition:persist="icon-32" />
    <link rel="icon" type="image/png" sizes="192x192" href="/images/favicon-192.png?v=2" transition:persist="icon-192" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png?v=2" transition:persist="icon-apple" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="K & A Performance" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    <!-- Client-side navigation, opted into per page (the training section).
         Both ends of a navigation must carry it, so a training tab click swaps
         content in place while the nav, the chat orb, the modal, and the
         ambient background persist below. Pages without it load normally. -->
    {clientRouter && <ClientRouter />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="bg-ambient" aria-hidden="true" transition:persist="ambient">
      <span class="blob blob-a"></span>
      <span class="blob blob-b"></span>
      <span class="blob blob-c"></span>
    </div>
    <Nav />
    <main id="main-content" tabindex="-1" class="scroll-mt-24">
      <slot />
    </main>
    <Footer />
    <SiteGuide />
    {!onContactPage && <StartProjectModal />}
    <script>
      import '../scripts/motion.js';
    </script>

  </body>
</html>
