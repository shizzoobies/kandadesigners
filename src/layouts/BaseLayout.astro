---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SiteGuide from '../components/SiteGuide.astro';
import StartProjectModal from '../components/StartProjectModal.astro';

const onContactPage = Astro.url.pathname.startsWith('/contact');

interface Props {
  title: string;
  description: string;
  /** Page-specific OG card, absolute path with its ?v= cache key. */
  ogImage?: string;
}

const { title, description, ogImage = '/images/og-card.png?v=2' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Sitewide identity for search engines. ProfessionalService (a LocalBusiness
// subtype) because the studio is a real service-area business in Gainesville.
// The address is deliberately city-level only: there is no public street
// address and no published phone number, and claiming less beats asserting
// something a searcher could turn up at. Do not add `streetAddress` or
// `telephone` until both are genuinely published on the site.
// No `aggregateRating` either: our reviews live on Google, and marking up
// someone else's reviews as our own violates their structured-data guidelines.
const ORG_ID = 'https://ka-performancefl.com/#organization';
const MAP_URL = 'https://g.page/r/CbVcBGWcGmNzEBM';
// Canonical spellings, approved 2026-08-09. Keep this list and the copy on the
// site saying the same thing; a schema that claims towns the pages never
// mention is the definition of a doorway signal.
const CITIES_SERVED = [
  'Gainesville',
  'Jacksonville',
  'Fleming Island',
  'Orange Park',
  'Ocala',
  'St. Augustine',
  'High Springs',
  'Alachua',
  'Newberry',
];
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': ORG_ID,
      name: 'K & A Performance',
      alternateName: 'K&A Performance',
      url: 'https://ka-performancefl.com/',
      email: 'alex@ka-performancefl.com',
      description:
        'Web design and AI integration studio in Gainesville, Florida, building fast, accessible, animated websites for businesses that refuse to blend in.',
      logo: {
        '@type': 'ImageObject',
        url: 'https://ka-performancefl.com/images/logo-lockup.webp',
        width: 800,
        height: 303,
      },
      image: 'https://ka-performancefl.com/images/og-card.png',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Gainesville',
        addressRegion: 'FL',
        addressCountry: 'US',
      },
      hasMap: MAP_URL,
      areaServed: CITIES_SERVED.map((name) => ({
        '@type': 'City',
        name,
        containedInPlace: { '@type': 'State', name: 'Florida' },
      })),
      knowsAbout: [
        'Web design',
        'AI integration',
        'Web accessibility',
        'Search engine optimisation',
        'Brand identity',
      ],
      founder: [
        {
          '@type': 'Person',
          name: 'Alex Anderson',
          // LinkedIn belongs to Alex, not the studio, so it hangs off his node
          // rather than the organisation's sameAs.
          sameAs: ['https://www.linkedin.com/in/alexander-anderson-73a870252/'],
        },
        { '@type': 'Person', name: 'Kristina Anderson' },
      ],
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'sales',
        email: 'alex@ka-performancefl.com',
        areaServed: 'US',
        availableLanguage: 'English',
      },
      // Only profiles we actually own and can point at. No placeholders.
      sameAs: [
        MAP_URL,
        'https://www.facebook.com/profile.php?id=61592711216301',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://ka-performancefl.com/#website',
      url: 'https://ka-performancefl.com/',
      // The WebSite node, not the Organization, is what Google's site-name
      // feature reads. Without alternateName here Google was deriving the
      // SERP site name from the domain ("Ka performancefl"). The name string
      // must match the GBP exactly: "K & A Performance", spaces and all.
      name: 'K & A Performance',
      alternateName: ['K&A Performance', 'KA Performance'],
      publisher: { '@id': ORG_ID },
      inLanguage: 'en-US',
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical.href}#webpage`,
      url: canonical.href,
      name: title,
      description,
      isPartOf: { '@id': 'https://ka-performancefl.com/#website' },
      about: { '@id': ORG_ID },
      inLanguage: 'en-US',
    },
  ],
};
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Meta domain verification. Must stay in place permanently: Meta re-checks
         periodically and un-verifies the domain if the tag disappears. -->
    <meta name="facebook-domain-verification" content="2go7mrp4qq77ardj8lsayydn6879x4" />
    <!-- Meta Pixel Code -->
    <script is:inline>
      /* is:inline is required. Without it Astro hands this to Vite, which bundles it
         as a deferred ES module and the pixel fails to initialise. Do not remove it,
         and do not convert this to an imported module or component. */
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1584105763055085');
      fbq('track', 'PageView');
    </script>
    <!-- alt="" on purpose: a 1x1 hidden tracking beacon, nothing to describe.
         It was the one image on the site with no alt attribute at all. -->
    <noscript><img height="1" width="1" style="display:none" alt=""
      src="https://www.facebook.com/tr?id=1584105763055085&ev=PageView&noscript=1"/></noscript>
    <!-- End Meta Pixel Code -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- ?v= bumps whenever the artwork changes: /images/* carries a 24h
         max-age, so reusing a bare filename would serve the old mark for a
         day, and social scrapers cache their copy far longer than that. -->
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png?v=2" />
    <link rel="icon" type="image/png" sizes="192x192" href="/images/favicon-192.png?v=2" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png?v=2" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="K & A Performance" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="bg-ambient" aria-hidden="true">
      <span class="blob blob-a"></span>
      <span class="blob blob-b"></span>
      <span class="blob blob-c"></span>
    </div>
    <Nav />
    <main id="main-content" tabindex="-1" class="scroll-mt-24">
      <slot />
    </main>
    <Footer />
    <SiteGuide />
    {!onContactPage && <StartProjectModal />}
    <script>
      import '../scripts/motion.js';
    </script>
    <script>
      // First-touch attribution, sitewide: a partner link can land on any
      // page (?src=synovial on the homepage, a location page, wherever), and
      // the AI Launch intake form reads this cookie later. First touch wins:
      // never overwrite an existing value. Fully guarded, because breaking
      // every page over a malformed cookie would be a bad trade.
      try {
        const src = new URLSearchParams(location.search).get('src');
        const existing = document.cookie.match(/(?:^|;\s*)ka_src=/);
        if (src && !existing) {
          document.cookie = `ka_src=${encodeURIComponent(src)}; Max-Age=7776000; Path=/; SameSite=Lax; Secure`;
        }
      } catch {
        /* attribution is best-effort */
      }
    </script>
  </body>
</html>
