---
// Floating site guide: a small AI concierge in the bottom-right corner,
// backed by /api/guide (Haiku — quick, cheap answers about the studio).
// Fully keyboard-operable: Escape closes, focus moves into the panel on
// open and back to the launcher on close.
---
<div id="sg-root" class="fixed bottom-6 right-6 z-50">
  <!-- panel -->
  <section
    id="sg-panel"
    class="glow-frame ai-alive absolute bottom-[4.5rem] right-0 hidden w-[22rem] max-w-[calc(100vw-3rem)] flex-col"
    role="dialog"
    aria-modal="false"
    aria-label="Site guide chat"
  >
    <header class="flex items-center justify-between border-b border-ink/10 px-5 py-4">
      <p class="font-mono text-sm font-semibold uppercase tracking-[0.2em] text-ink">Site <span class="ai-pulse text-accent">guide</span></p>
      <button type="button" id="sg-close" class="sg-icon-btn" aria-label="Close site guide">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m3 3 10 10M13 3 3 13"/></svg>
      </button>
    </header>
    <div id="sg-messages" class="flex h-[19rem] flex-col gap-3 overflow-y-auto px-5 py-4" aria-live="polite">
      <div class="sg-bub sg-bot">Hi! I'm the K &amp; A site guide. Ask me anything: services, accessibility checks, our work, how to start a project.</div>
    </div>
    <form id="sg-form" class="flex items-center gap-2 border-t border-ink/10 p-3">
      <label for="sg-input" class="sr-only">Ask the site guide</label>
      <input
        type="text"
        id="sg-input"
        placeholder="Ask about our services…"
        autocomplete="off"
        maxlength="900"
        class="min-w-0 flex-1 rounded-full border border-ink/15 bg-canvas px-4 py-2 text-sm text-ink placeholder:text-muted focus:border-accent focus:outline-none"
      />
      <button type="submit" id="sg-send" class="btn-accent shrink-0 px-4! py-2! text-sm">Send</button>
    </form>
  </section>

  <!-- launcher -->
  <button
    type="button"
    id="sg-open"
    class="sg-fab"
    aria-expanded="false"
    aria-controls="sg-panel"
    aria-label="Open the site guide chat"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 11.5a8.38 8.38 0 0 1-9 8.36 8.5 8.5 0 0 1-3.4-.71L3 21l1.85-4.6A8.38 8.38 0 0 1 3.5 11.5a8.5 8.5 0 0 1 8.5-8.5 8.5 8.5 0 0 1 9 8.5Z"/>
    </svg>
  </button>
</div>

<style is:global>
  /* Global on purpose: chat bubbles are created at runtime, so Astro's
     scoped-style attributes would never reach them. Everything here is
     sg-namespaced. */
  #sg-panel {
    /* .ai-alive sets position:relative (unlayered) which outranks the
       `absolute` utility — pin it back with id specificity. */
    position: absolute;
  }
  .sg-fab {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 9999px;
    background: var(--color-accent);
    color: #fffdf9;
    box-shadow: 0 10px 30px -8px rgb(154 52 18 / 0.5);
    transition: background var(--dur-fast) var(--ease-out-expo), transform var(--dur-fast) var(--ease-out-expo);
  }
  .sg-fab:hover {
    background: var(--color-accent-hot);
    transform: translateY(-2px);
  }
  .sg-icon-btn {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    color: var(--color-muted);
    transition: color var(--dur-fast) ease, background var(--dur-fast) ease;
  }
  .sg-icon-btn:hover {
    color: var(--color-ink);
    background: rgb(34 28 21 / 0.06);
  }
  #sg-panel.sg-visible {
    display: flex;
  }
  .sg-bub {
    border-radius: 14px;
    padding: 0.6rem 0.9rem;
    font-size: 0.9rem;
    line-height: 1.5;
    max-width: 88%;
    width: fit-content;
    color: var(--color-ink);
    overflow-wrap: anywhere;
  }
  .sg-bot {
    background: rgb(154 52 18 / 0.08);
    border: 1px solid rgb(154 52 18 / 0.14);
    align-self: flex-start;
    border-bottom-left-radius: 4px;
  }
  .sg-user {
    background: rgb(34 28 21 / 0.06);
    align-self: flex-end;
    border-bottom-right-radius: 4px;
  }
  .sg-typing span {
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-right: 3px;
    border-radius: 9999px;
    background: var(--color-accent);
    animation: sg-dot 1.3s ease-in-out infinite;
  }
  .sg-typing span:nth-child(2) { animation-delay: 0.18s; }
  .sg-typing span:nth-child(3) { animation-delay: 0.36s; }
  @keyframes sg-dot {
    0%, 60%, 100% { opacity: 0.3; transform: translateY(0); }
    30% { opacity: 1; transform: translateY(-3px); }
  }
  .motion-reduced .sg-typing span { animation: none; }
  @media (max-width: 480px) {
    #sg-panel { width: calc(100vw - 3rem); }
  }
</style>

<script>
  const panel = document.getElementById('sg-panel');
  const openBtn = document.getElementById('sg-open');
  const closeBtn = document.getElementById('sg-close');
  const form = document.getElementById('sg-form') as HTMLFormElement;
  const input = document.getElementById('sg-input') as HTMLInputElement;
  const sendBtn = document.getElementById('sg-send') as HTMLButtonElement;
  const messagesEl = document.getElementById('sg-messages');

  const history: { role: 'user' | 'assistant'; content: string }[] = [];
  let busy = false;

  const setOpen = (open: boolean) => {
    panel?.classList.toggle('sg-visible', open);
    panel?.classList.toggle('hidden', !open);
    openBtn?.setAttribute('aria-expanded', String(open));
    if (open) input?.focus();
    else openBtn?.focus();
  };

  openBtn?.addEventListener('click', () => setOpen(!panel?.classList.contains('sg-visible')));
  closeBtn?.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel?.classList.contains('sg-visible')) setOpen(false);
  });

  const addBubble = (cls: string, text?: string) => {
    const div = document.createElement('div');
    div.className = `sg-bub ${cls}`;
    if (text) div.textContent = text;
    messagesEl?.appendChild(div);
    if (messagesEl) messagesEl.scrollTop = messagesEl.scrollHeight;
    return div;
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const text = input.value.trim();
    if (!text || busy) return;

    input.value = '';
    addBubble('sg-user', text);
    history.push({ role: 'user', content: text });

    busy = true;
    sendBtn.disabled = true;
    const typing = addBubble('sg-bot sg-typing');
    typing.innerHTML = '<span></span><span></span><span></span>';

    try {
      const res = await fetch('/api/guide', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: history.slice(-20) }),
      });
      const data = await res.json();
      typing.remove();
      if (res.ok && data.reply) {
        addBubble('sg-bot', data.reply);
        history.push({ role: 'assistant', content: data.reply });
      } else {
        throw new Error('unavailable');
      }
    } catch {
      typing.remove();
      addBubble('sg-bot', "I'm having trouble right now. You can reach Alex & Kristina directly on the contact page.");
    } finally {
      busy = false;
      sendBtn.disabled = false;
      input.focus();
    }
  });
</script>
