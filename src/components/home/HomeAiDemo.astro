<section class="ai-demo dark-band" aria-labelledby="ai-demo-title">
  <div class="ai-layout">
    <div class="ai-intro">
      <p class="eyebrow">AI, with a useful job to do</p>
      <h2 id="ai-demo-title">Less sorting.<br /><span>More starting.</span></h2>
      <p class="intro-copy">A good inquiry can arrive as a very messy message. AI can organize the details, spot what's missing, and give your team a clearer place to start.</p>
      <a class="ai-link" href="/contact/#scope">Try it with Kai, our project guide <span aria-hidden="true">↗</span></a>
      <a class="service-link" href="/services/ai-integration/">Explore AI integration</a>
    </div>
    <home-ai-demo class="demo-workspace">
      <div class="workspace-label"><span class="signal" aria-hidden="true"></span> From message to working brief <span class="sample-label">Fictional example</span></div>
      <div class="stage-controls" aria-label="Explore the example" hidden>
        <button type="button" data-stage="message" aria-controls="ai-message" aria-pressed="true">The message</button>
        <button type="button" data-stage="details" aria-controls="ai-details" aria-pressed="false">Find the details</button>
        <button type="button" data-stage="brief" aria-controls="ai-brief" aria-pressed="false">The working brief</button>
      </div>
      <div class="stage-window">
        <article id="ai-message" class="demo-stage" data-panel="message" aria-labelledby="ai-message-title">
          <div class="document-top"><span class="document-type">Incoming inquiry</span><span class="document-mark" aria-hidden="true">↙</span></div>
          <h3 id="ai-message-title">“We need an easier way to book.”</h3>
          <blockquote>“Hi! We run a small landscaping business. People mostly message us on Facebook, and sometimes we lose track. We'd love a site with photos of our work and a way to request an estimate. Hoping to have it ready before spring. Not sure what something like that costs.”</blockquote>
          <p class="stage-footnote">Useful information. Just not organized yet.</p>
        </article>
        <article id="ai-details" class="demo-stage" data-panel="details" aria-labelledby="ai-details-title">
          <div class="document-top"><span class="document-type">Details pulled from the message</span><span class="document-mark" aria-hidden="true">⌕</span></div>
          <h3 id="ai-details-title">Keep what matters.</h3>
          <dl class="extracted-details">
            <div><dt>The business</dt><dd>Local landscaping team</dd></div>
            <div><dt>The problem</dt><dd>Estimate requests get lost in messages</dd></div>
            <div><dt>The essentials</dt><dd>Work photos and an estimate request form</dd></div>
            <div><dt>The timing</dt><dd>Before spring, exact date to confirm</dd></div>
          </dl>
          <p class="stage-footnote">The budget wasn't provided. Keep it as a question.</p>
        </article>
        <article id="ai-brief" class="demo-stage" data-panel="brief" aria-labelledby="ai-brief-title">
          <div class="document-top"><span class="document-type">Draft for a person to review</span><span class="document-mark" aria-hidden="true">✓</span></div>
          <h3 id="ai-brief-title">A more useful first conversation.</h3>
          <p class="brief-summary">Create a website that shows the team's work and brings estimate requests into one place.</p>
          <div class="brief-question"><span>Ask next</span><p>What budget are you considering, and who will follow up on new requests?</p></div>
          <p class="stage-footnote">A clear starting point. Your team still checks the details and decides what happens next.</p>
        </article>
      </div>
      <p class="demo-note">A prepared walkthrough, not a live AI response. Nothing is submitted.</p>
      <p class="sr-only" data-stage-status aria-live="polite" aria-atomic="true"></p>
    </home-ai-demo>
  </div>
</section>

<script>
  class HomeAiDemo extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      const controls = this.querySelector<HTMLElement>('.stage-controls');
      const buttons = Array.from(this.querySelectorAll<HTMLButtonElement>('[data-stage]'));
      const panels = Array.from(this.querySelectorAll<HTMLElement>('[data-panel]'));
      const status = this.querySelector<HTMLElement>('[data-stage-status]');
      const select = (button: HTMLButtonElement, announce = true) => {
        buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        panels.forEach((panel) => {
          const inactive = panel.dataset.panel !== button.dataset.stage;
          panel.hidden = inactive;
          panel.inert = inactive;
          panel.setAttribute('aria-hidden', String(inactive));
        });
        if (announce && status) status.textContent = `Showing ${button.textContent?.trim().toLowerCase()}.`;
      };
      buttons.forEach((button) => button.addEventListener('click', () => select(button)));
      if (controls) controls.hidden = false;
      if (buttons[0]) select(buttons[0], false);
    }
  }
  if (!customElements.get('home-ai-demo')) customElements.define('home-ai-demo', HomeAiDemo);
</script>

