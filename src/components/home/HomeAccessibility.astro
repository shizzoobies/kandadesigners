<section id="a11y-home" class="accessibility-home" aria-labelledby="home-accessibility-title">
  <div class="accessibility-layout">
    <home-accessibility-demo class="accessibility-workbench">
      <div class="browser-top"><span aria-hidden="true" class="browser-dots"><i></i><i></i><i></i></span><span>A small usability check</span></div>
      <div class="contrast-example">
        <div class="example-label"><span>Read it at a glance</span><span class="sample-tag">Sample</span></div>
        <div class="contrast-preview" data-preview aria-hidden="true">
          <span class="preview-eyebrow">Your next project</span>
          <span class="preview-heading">Let's make<br />something good.</span>
          <span class="preview-caption">A little more clarity goes a long way.</span>
          <span class="preview-button">Get in touch <span>↗</span></span>
        </div>
        <div class="contrast-toolbar" hidden>
          <button type="button" data-contrast-toggle aria-pressed="true"><span class="toggle-track" aria-hidden="true"><span></span></span>Stronger contrast</button>
        </div>
        <p class="contrast-description" data-contrast-status aria-live="polite" aria-atomic="true">Dark text on a light background makes the example easier to read.</p>
      </div>
      <div class="keyboard-example">
        <div class="keyboard-heading"><h3>Now try your keyboard.</h3><kbd>Tab</kbd></div>
        <p>Use Tab to move between these links. The outline shows where you are. Enter opens the page.</p>
        <div class="keyboard-links"><a href="/services/web-design/">Web design <span aria-hidden="true">↗</span></a><a href="/contact/">Contact us <span aria-hidden="true">↗</span></a></div>
      </div>
    </home-accessibility-demo>
    <div class="accessibility-copy">
      <p class="eyebrow">Good design includes more people</p>
      <h2 id="home-accessibility-title">Easy to use.<br /><span>Hard to overlook.</span></h2>
      <p class="intro-copy">Readable text. A clear path with a keyboard. Room for the way someone actually uses the web.</p>
      <p>These are two small examples. We also check screen reader support, motion preferences, forms, and the details that make a site work for more people.</p>
      <a class="accessibility-link" href="/services/accessibility/">See what an accessibility audit covers <span aria-hidden="true">↗</span></a>
      <a class="statement-link" href="/accessibility/">Read our own accessibility statement</a>
    </div>
  </div>
</section>

<script>
  class HomeAccessibilityDemo extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      const button = this.querySelector<HTMLButtonElement>('[data-contrast-toggle]');
      const toolbar = this.querySelector<HTMLElement>('.contrast-toolbar');
      const preview = this.querySelector<HTMLElement>('[data-preview]');
      const status = this.querySelector<HTMLElement>('[data-contrast-status]');
      if (!button || !preview || !status || !toolbar) return;
      toolbar.hidden = false;
      button.addEventListener('click', () => {
        const stronger = button.getAttribute('aria-pressed') !== 'true';
        button.setAttribute('aria-pressed', String(stronger));
        preview.classList.toggle('low-contrast', !stronger);
        status.textContent = stronger
          ? 'Dark text on a light background makes the example easier to read.'
          : 'The pale lettering in this example blends into the background. Turn stronger contrast back on to compare.';
      });
    }
  }
  if (!customElements.get('home-accessibility-demo')) customElements.define('home-accessibility-demo', HomeAccessibilityDemo);
</script>

