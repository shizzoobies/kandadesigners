---
const work = [
  { id:'makeover', name:'Project Makeover', category:'Community / nonprofit', image:'/images/work-pmbuild.webp?v=2', headline:'Give a big mission a place to grow.', brief:'A nonprofit transforming school spaces needed a home for the people, projects, and support behind each makeover.', feature:'Explore the school makeovers, then find a clear path to donate or get involved.', url:'https://projectmakeover.org' },
  { id:'osteen', name:'Osteen & Sons', category:'Local services', image:'/images/work-osteens.webp?v=1', headline:'Turn a property question into a next step.', brief:'A Gainesville lawn, brush, and junk crew needed a useful way to start a conversation about a property.', feature:'An address lookup brings in county lot details and leads into booking a free walkthrough.', url:'https://osteenandsons.com' },
  { id:'bbq', name:"David’s BBQ", category:'Food / hospitality', image:'/images/work-davidsbbq.webp?v=1', headline:'Make the next meal easy to find.', brief:'A Gainesville barbecue restaurant needed its menu, catering, and ordering to be easy to reach.', feature:'Browse the full menu and prices, explore catering, or head straight to online ordering.', url:'https://davidsbbq.com' },
];
---
<section class="home-work" aria-labelledby="home-work-title">
  <div class="work-intro">
    <div><p class="eyebrow">Independent studio / Gainesville, Florida</p><h2 id="home-work-title">Built around<br /><span>your kind of business.</span></h2></div>
    <div class="intro-copy"><p>We create <a href="/services/web-design/">custom websites</a>, <a href="/services/ai-integration/">useful AI integrations</a>, and <a href="/training/">training people can use</a>. Every project starts with what you need it to do.</p><a class="text-link" href="/services/web-design/what-it-costs/">What goes into a website’s cost</a></div>
  </div>
  <home-work-switcher>
    <div class="project-tabs" aria-label="Explore a project">
      {work.map(p=><a id={`work-tab-${p.id}`} href={`#work-panel-${p.id}`} data-work-tab>{p.name}</a>)}
    </div>
    <div class="project-panels">
    {work.map(p=><article id={`work-panel-${p.id}`} class="project-panel" data-work-panel aria-labelledby={`work-tab-${p.id}`}>
      <a href={p.url} target="_blank" rel="noopener" class="project-window" aria-label={`Visit ${p.name} website, opens in a new tab`}>
        <div class="window-bar" aria-hidden="true"><span></span><span></span><span></span><b>{new URL(p.url).hostname}</b></div>
        <img src={p.image} alt={`${p.name} website designed by K & A Performance`} width="1440" height="900" loading="lazy" />
      </a>
      <div class="project-story"><p class="eyebrow">{p.category}</p><h3>{p.headline}</h3><p>{p.brief}</p><div class="feature"><p><strong>A useful detail</strong>{p.feature}</p></div><a href={p.url} target="_blank" rel="noopener" class="text-link">Explore {p.name}<span class="sr-only"> (opens in a new tab)</span></a></div>
    </article>)}
    </div>
  </home-work-switcher>
</section>
<style>
  .home-work{max-width:1152px;margin:auto;padding:64px 24px 88px;position:relative;scroll-margin-top:110px}.work-intro{display:grid;gap:28px;margin-bottom:40px}.eyebrow{font-family:var(--font-mono);font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;color:var(--color-accent);margin-bottom:18px}h2{font-family:var(--font-display);font-weight:700;font-size:clamp(2rem,4.2vw,3.55rem);line-height:1.08;letter-spacing:-.035em}h2 span{color:var(--color-accent)}.intro-copy{max-width:430px;align-self:end}.intro-copy p{font-size:1.12rem;line-height:1.65;margin-bottom:18px}.intro-copy p a{text-decoration:underline;text-decoration-color:#9a341255;text-underline-offset:4px}.text-link{font-weight:600;text-decoration:underline;text-underline-offset:5px;color:var(--color-accent);line-height:1.5}.project-tabs{display:flex;flex-wrap:wrap;border-bottom:1px solid #221c1528;gap:6px 26px;margin-bottom:28px}.project-tabs a{padding:15px 0;min-height:48px;font-size:.95rem;font-weight:600;border-bottom:3px solid transparent}.project-tabs a[aria-selected=true]{border-color:var(--color-accent);color:var(--color-accent)}.project-panel{display:grid;gap:30px;margin-top:32px}[data-ready] .project-panels{display:grid}[data-ready] .project-panel{grid-area:1/1}[data-ready] .project-panel[data-inactive]{display:grid;visibility:hidden;pointer-events:none}.project-window{display:block;border:1px solid #221c1533;border-radius:9px;overflow:hidden;background:var(--color-surface);box-shadow:0 18px 45px -25px #221c1560;align-self:start}.window-bar{display:flex;gap:5px;align-items:center;padding:12px 14px;border-bottom:1px solid #221c1520;background:#eeebe5}.window-bar span{width:7px;height:7px;border:1px solid #6c635a;border-radius:50%}.window-bar b{font:normal .67rem var(--font-mono);margin-left:9px;overflow-wrap:anywhere}.project-window img{width:100%;aspect-ratio:1.6;object-fit:cover;object-position:top;display:block}.project-story{align-self:center}.project-story h3{font-family:var(--font-display);font-size:clamp(1.65rem,2.7vw,2.25rem);font-weight:650;line-height:1.16;margin-bottom:18px;letter-spacing:-.025em}.project-story>p:not(.eyebrow){color:var(--color-muted);line-height:1.65}.feature{padding:23px 0;margin:12px 0 6px;border-bottom:1px solid #221c1520}.feature p{line-height:1.55;font-size:.95rem}.feature strong{display:block;margin-bottom:5px}.project-story>.text-link{display:inline-block;padding-top:14px}.project-window:focus-visible{outline-offset:5px}home-work-switcher{display:block}
  @media(min-width:768px){.work-intro{grid-template-columns:1.15fr 1fr;gap:50px}.project-panel{grid-template-columns:1.55fr 1fr;gap:40px}}
  @media(min-width:1024px){.home-work{padding-top:64px;padding-bottom:104px}.project-tabs{margin-top:48px}.project-panel{gap:52px}}
  @media(min-width:1024px) and (prefers-reduced-motion:no-preference){.home-work{margin-top:-34vh}}
  @media(prefers-reduced-motion:no-preference){.project-panel:not([data-inactive]){animation:work-appear .3s ease-out}@keyframes work-appear{from{opacity:.35;transform:translateY(6px)}to{opacity:1;transform:none}}}
</style>
<script>
  class HomeWorkSwitcher extends HTMLElement {
    connectedCallback(){
      if(this.dataset.ready)return;
      this.dataset.ready='true';
      const tabs=[...this.querySelectorAll<HTMLAnchorElement>('[data-work-tab]')];
      const panels=[...this.querySelectorAll<HTMLElement>('[data-work-panel]')];
      this.querySelector('.project-tabs')?.setAttribute('role','tablist');
      const select=(index:number,focus=false)=>{tabs.forEach((tab,i)=>{tab.setAttribute('aria-selected',String(i===index));tab.tabIndex=i===index?0:-1;panels[i].toggleAttribute('data-inactive',i!==index);panels[i].inert=i!==index;panels[i].setAttribute('aria-hidden',String(i!==index));});if(focus)tabs[index].focus();};
      tabs.forEach((tab,i)=>{tab.setAttribute('role','tab');tab.setAttribute('aria-controls',panels[i].id);panels[i].setAttribute('role','tabpanel');panels[i].tabIndex=0;tab.addEventListener('click',e=>{e.preventDefault();select(i);});tab.addEventListener('keydown',e=>{if(e.key===' '){e.preventDefault();select(i);return;}let next=i;if(e.key==='ArrowRight')next=(i+1)%tabs.length;else if(e.key==='ArrowLeft')next=(i+tabs.length-1)%tabs.length;else if(e.key==='Home')next=0;else if(e.key==='End')next=tabs.length-1;else return;e.preventDefault();select(next,true);});});
      select(0);
    }
  }
  if(!customElements.get('home-work-switcher'))customElements.define('home-work-switcher',HomeWorkSwitcher);
</script>
