---
import TrainingSubnav from './TrainingSubnav.astro';
import TrainingCourseCard from './TrainingCourseCard.astro';
import CapabilityExplorer from './CapabilityExplorer.astro';
import { trainingPresentation } from '../data/trainingPresentation.js';
import { section, liveSamples, team, delivery, pipeline, accessibility, aiTransparency, engagementModels } from '../data/training.js';
const { faqs } = Astro.props;
const featured = ['hazard-recognition', 'reading-the-pnl', 'build-the-plate']
  .map((slug) => liveSamples.find((sample) => sample.slug === slug));
const hero = trainingPresentation['hazard-recognition'];
---

<section class="studio-hero studio-wrap" aria-labelledby="training-title">
  <div class="hero-copy">
    <p class="eyebrow"><a href="/services/">Services</a><span aria-hidden="true"> / </span>Training studio</p>
    <h1 id="training-title">Training worth <span>paying <span class="headline-last">attention to.</span></span></h1>
    <p class="hero-intro">Custom courses that turn your team's knowledge into something people can use.</p>
    <div class="hero-actions"><a href="/training/samples/" class="studio-primary">Explore the courses <span aria-hidden="true">↗</span></a><button type="button" data-inquire class="text-link" aria-label="Let's talk about your training project">Let's talk</button></div>
    <p class="hero-note">Six original courses. Open them and try the work.</p>
  </div>
  <a class="hero-feature" href="/training/samples/hazard-recognition/" aria-label="Explore Spot it before it hurts someone">
    <div class="feature-topline"><span>Inside the learning studio</span><span>Construction &amp; trades</span></div>
    <img src={hero.cover} alt={hero.coverAlt} width="1200" height="750" fetchpriority="high" />
    <div class="feature-caption"><div><span class="feature-kicker">A scene to explore. A decision to make.</span><strong>Spot it before it hurts someone</strong></div><span class="feature-arrow" aria-hidden="true">↗</span></div>
  </a>
</section>

<TrainingSubnav />

<section id="course-selection" class="studio-wrap studio-section" aria-labelledby="selection-heading">
  <div class="section-heading"><div><p class="eyebrow">See what learning can look like</p><h2 id="selection-heading">Made for the subject.<br />Built for the person.</h2></div><div class="section-aside"><p>Different topics, different worlds. Each course gives you something to explore, try and take away.</p><a class="text-link" href="/training/samples/">Explore all six courses <span aria-hidden="true">↗</span></a></div></div>
  <div class="featured-courses">{featured.map((sample) => sample && <TrainingCourseCard sample={sample} headingLevel={3} />)}</div>
  <p class="selection-footnote">Original K &amp; A demonstration courses. Construction, finance, nutrition, movement and wellness.</p>
</section>

<section class="practice-band" aria-labelledby="practice-heading">
  <div class="studio-wrap studio-section">
    <div class="section-heading"><div><p class="eyebrow">The details make the experience</p><h2 id="practice-heading">Something to do.<br />Someone to learn with.</h2></div><p class="section-aside">Clear writing is the start. Thoughtful activities, illustrated guides and optional narration help carry the lesson.</p></div>
    <div class="practice-grid">
      <a class="practice-card" href="/training/samples/strong-is-a-skill/"><div class="practice-image"><img src="/images/training/showcase/movement-practice.webp" width="536" height="340" loading="lazy" alt="An everyday strength task card: rising from a low chair" /></div><div class="practice-copy"><p class="eyebrow">Practice a decision</p><h3>Move beyond remembering.</h3><p>Sort a movement, find a hazard or work through a financial decision. Learners try the idea and see what happens.</p><span class="text-link">Try the strength workshop <span aria-hidden="true">↗</span></span></div></a>
      <a class="practice-card guide-card" href="/training/samples/build-the-plate/"><div class="guide-image"><img src="/training-samples/nutrition/assets/img/kitchen-guide.webp" width="640" height="533" loading="lazy" alt="The illustrated kitchen guide from Build the plate, skip the diet" /></div><div class="practice-copy"><p class="eyebrow">A familiar guide</p><h3>A human thread through the lesson.</h3><p>Characters, scenes and examples belong to the course's world. They give the experience personality and continuity.</p><span class="text-link">Meet the kitchen guide <span aria-hidden="true">↗</span></span></div></a>
      <a class="practice-card" href="/training/samples/heat-done-well/"><div class="practice-image audio-image"><img src="/images/training/showcase/listen-and-read.webp" width="360" height="224" loading="lazy" alt="A close-up of the sauna guide beside the transcript and narration controls" /></div><div class="practice-copy"><p class="eyebrow">Listen and follow along</p><h3>Audio with room to read.</h3><p>Optional narration and a matching transcript sit alongside the learning. The learner controls the pace.</p><span class="text-link">Explore the sauna workshop <span aria-hidden="true">↗</span></span></div></a>
    </div>
  </div>
</section>

<section class="studio-wrap studio-section" aria-labelledby="capabilities-heading">
  <div class="section-heading"><div><p class="eyebrow">What we build</p><h2 id="capabilities-heading">The right shape<br />for what needs to change.</h2></div><p class="section-aside">Bring the topic, the audience and the material you have. We will work out the learning experience with you.</p></div>
  <CapabilityExplorer />
</section>

<section class="process-section studio-wrap studio-section" aria-labelledby="process-heading">
  <div class="section-heading"><div><p class="eyebrow">Working together</p><h2 id="process-heading">A clear next step.<br />At every step.</h2></div><p class="section-aside">Your review points and turnarounds are agreed before production begins, so everyone knows what the next stage needs.</p></div>
  <ol class="process-list">{pipeline.map((step) => <li><h3>{step.label}</h3><p>{step.note}</p></li>)}</ol>
</section>

<section class="delivery-section dark-band" aria-labelledby="delivery-heading">
  <div class="studio-wrap studio-section">
    <div class="section-heading"><div><p class="eyebrow">Ready for your environment</p><h2 id="delivery-heading">Your LMS.<br />Your learners. Your content.</h2></div><p class="section-aside">The delivery format, accessibility requirements and source handoff are part of the scope from the start.</p></div>
    <ul class="format-list" aria-label="Delivery formats">{delivery.formats.map((format) => <li>{format}</li>)}</ul>
    <div class="delivery-columns"><div><h3>A handoff you can use</h3><ul class="delivery-notes">{delivery.notes.map((note) => <li>{note}</li>)}</ul><a href={section.pdf} download class="text-link">Download our capabilities <span aria-hidden="true">↓</span><span class="file-type">PDF</span></a></div><div><h3>Accessibility throughout the build</h3><p>Client delivery targets {accessibility.standard}, with checks in the environment your learners use.</p><ul class="quality-list"><li>Keyboard paths and visible focus</li><li>Screen-reader labels and reading order</li><li>Measured contrast and reduced motion</li><li>Testing inside your LMS</li></ul><a href="/services/accessibility/" class="text-link">Our accessibility approach <span aria-hidden="true">↗</span></a></div></div>
    <details class="ai-note"><summary>How AI fits into production<span aria-hidden="true">+</span></summary><div>{aiTransparency.map((line) => <p>{line}</p>)}</div></details>
  </div>
</section>

<section class="studio-wrap studio-section people-section" aria-labelledby="people-heading">
  <div class="people-portraits">{team.owners.map((person) => <figure><img src={person.photo} alt={person.name} width="400" height="500" loading="lazy" /><figcaption><strong>{person.name}</strong><span>{person.line}</span></figcaption></figure>)}</div>
  <div><p class="eyebrow">People behind the work</p><h2 id="people-heading">A direct line to<br />the people building it.</h2><p>Alex leads design and development. Kristina leads strategy and content. Instructional designers and subject matter experts bring the visual craft and field knowledge each project needs.</p><a href="/training/team/" class="text-link">Meet the team <span aria-hidden="true">↗</span></a></div>
</section>

<section class="studio-wrap studio-section engagement-section" aria-labelledby="engagement-heading">
  <div class="section-heading"><div><p class="eyebrow">Choose the working relationship</p><h2 id="engagement-heading">One project.<br />Or room for the whole backlog.</h2></div></div>
  <div class="engagement-list">{engagementModels.map((model) => <article><h3>{model.title}</h3><p>{model.shape}</p><button type="button" data-inquire class="text-link" aria-label={`Let's talk about the ${model.title.toLowerCase()} option`}>Let's talk <span aria-hidden="true">↗</span></button></article>)}</div>
</section>

<section class="studio-wrap studio-section faq-section" aria-labelledby="questions-heading">
  <div><p class="eyebrow">A few practical details</p><h2 id="questions-heading">Before we begin.</h2></div>
  <div class="faq-list">{faqs.map((faq) => <details><summary>{faq.q}<span aria-hidden="true">+</span></summary><p>{faq.a}</p></details>)}</div>
</section>

<section id="inquire" class="studio-wrap inquiry-section" aria-labelledby="inquiry-heading">
  <p class="eyebrow">Tell us what you have in mind</p><h2 id="inquiry-heading">Your knowledge.<br /><span>A course worth opening.</span></h2><p>A new topic, an old deck or a backlog that needs attention. Tell us where you are starting.</p><button type="button" data-inquire class="studio-primary">Discuss your project <span aria-hidden="true">↗</span></button><p class="inquiry-note">Alex reads every inquiry and replies within one business day.</p><noscript><p>Write to <a href={'mailto:' + section.email}>{section.email}</a> with the topic, audience and timing.</p></noscript>
</section>

<style>
  .studio-wrap { width: min(100% - 48px, 1152px); margin-inline: auto; }
  .studio-section { padding-block: clamp(56px, 7vw, 96px); }
  .eyebrow { margin: 0 0 20px; color: var(--color-accent); font: 0.7rem/1.6 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; }
  .eyebrow a { text-decoration: none; }
  h1, h2, h3 { font-family: var(--font-display); font-weight: 700; letter-spacing: -.04em; margin: 0; }
  h1 { font-size: clamp(2.65rem, 4.6vw, 4.15rem); line-height: 1.02; max-width: 13ch; }
  h1 > span { display: block; }
  .headline-last { display: block; }
  h1 span, .inquiry-section h2 span { color: var(--color-accent); }
  h2 { font-size: clamp(2rem, 3.35vw, 3rem); line-height: 1.1; }
  h3 { font-size: 1.3rem; line-height: 1.22; }
  #capabilities-heading { scroll-margin-top: 125px; }
  p { line-height: 1.65; }
  .studio-hero { display: grid; grid-template-columns: .92fr 1.08fr; gap: 54px; align-items: center; padding-block: 170px 64px; }
  .hero-intro { font-size: 1.18rem; line-height: 1.55; margin: 25px 0 14px; max-width: 35ch; }
  .hero-detail { max-width: 43ch; font-size: 1rem; color: var(--color-muted); margin: 0; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 24px; margin-top: 28px; }
  .studio-primary { display: inline-flex; align-items: center; justify-content: center; gap: 22px; padding: 15px 20px; border: 1px solid var(--color-accent); background: var(--color-accent); color: var(--color-surface); text-decoration: none; font: 700 .92rem/1.35 var(--font-heading); cursor: pointer; min-height: 48px; transition: background .2s; }
  .studio-primary:hover { background: var(--color-accent-hot); }
  .text-link { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; font: 700 .92rem/1.4 var(--font-heading); color: var(--color-accent); background: transparent; border: 0; padding: 4px 0; text-decoration: underline; text-underline-offset: 5px; cursor: pointer; }
  .text-link:hover { color: var(--color-accent-hot); }
  .hero-note { margin: 18px 0 0; color: var(--color-muted); font-size: .8rem; }
  .hero-feature { display: block; color: var(--color-ink); background: var(--color-surface); border: 1px solid color-mix(in srgb, var(--color-ink) 25%, transparent); box-shadow: 10px 10px 0 color-mix(in srgb, var(--color-accent) 8%, var(--color-canvas)); text-decoration: none; overflow: hidden; }
  .feature-topline { display: flex; flex-wrap: wrap; gap: 4px 16px; justify-content: space-between; padding: 14px 18px; font: .65rem/1.5 var(--font-mono); text-transform: uppercase; letter-spacing: .05em; border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent); }
  .hero-feature > img { width: 100%; height: auto; aspect-ratio: 8/5; display: block; object-fit: cover; }
  .feature-caption { padding: 22px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .feature-kicker { display: block; color: var(--color-muted); font-size: .78rem; margin-bottom: 8px; }
  .feature-caption strong { display: block; font: 700 1.3rem/1.2 var(--font-display); letter-spacing: -.02em; max-width: 21ch; }
  .feature-arrow { width: 44px; height: 44px; border: 1px solid var(--color-accent); color: var(--color-accent); display: grid; place-items: center; flex: 0 0 auto; font-size: 1.4rem; }
  .section-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 30px 60px; margin-bottom: 38px; }
  .section-aside { max-width: 37ch; color: var(--color-muted); margin: 0; }
  .section-aside p { margin: 0 0 12px; }
  .featured-courses { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .selection-footnote { font-size: .8rem; color: var(--color-muted); margin: 24px 0 0; }
  .practice-band { background: color-mix(in srgb, var(--color-accent) 5%, var(--color-canvas)); border-block: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent); }
  .practice-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
  .practice-card { text-decoration: none; color: var(--color-ink); min-width: 0; }
  .practice-image, .guide-image { height: 206px; overflow: hidden; background: var(--color-surface); border: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent); }
  .practice-image img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .audio-image img { object-position: bottom; }
  .guide-image { background: color-mix(in srgb, var(--color-accent) 9%, var(--color-surface)); display: flex; align-items: flex-start; justify-content: center; }
  .guide-image img { display: block; width: auto; height: 275px; margin-top: 10px; object-fit: contain; }
  .practice-copy { padding-top: 24px; }
  .practice-copy .eyebrow { margin-bottom: 12px; }
  .practice-copy > p:not(.eyebrow) { color: var(--color-muted); font-size: .95rem; margin: 15px 0 12px; }
  .process-section, .engagement-section, .faq-section { border-top: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent); }
  .process-list { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px 40px; padding: 0; margin: 0; }
  .process-list li { border-left: 2px solid color-mix(in srgb, var(--color-accent) 35%, transparent); padding: 0 0 0 20px; }
  .process-list h3 { font-size: 1.05rem; letter-spacing: -.015em; }
  .process-list p { font-size: .88rem; margin: 10px 0 0; color: var(--color-muted); }
  .format-list { list-style: none; margin: 0 0 44px; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
  .format-list li { padding: 16px 0; border-block: 1px solid color-mix(in srgb, var(--color-ink) 30%, transparent); font-family: var(--font-mono); font-size: .88rem; }
  .delivery-columns { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; }
  .delivery-columns p, .delivery-columns li { color: var(--color-muted); font-size: .95rem; }
  .delivery-notes { margin: 20px 0; padding: 0; list-style: none; display: grid; gap: 14px; line-height: 1.65; }
  .quality-list { list-style: none; padding: 0; margin: 20px 0; }
  .quality-list li { padding: 7px 0 7px 20px; position: relative; }
  .quality-list li::before { content: ''; width: 5px; height: 5px; background: var(--color-accent); position: absolute; left: 0; top: 17px; }
  .file-type { font: .65rem var(--font-mono); text-decoration: none; }
  summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 20px; font-weight: 700; padding: 20px 0; }
  summary::-webkit-details-marker { display: none; }
  summary > span { color: var(--color-accent); font-size: 1.2rem; flex: 0 0 auto; }
  details[open] summary > span { transform: rotate(45deg); }
  .ai-note { margin-top: 38px; border-top: 1px solid color-mix(in srgb, var(--color-ink) 25%, transparent); }
  .ai-note > div { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .ai-note p { font-size: .9rem; color: var(--color-muted); margin: 0; }
  .people-section { display: grid; grid-template-columns: 1fr 1fr; gap: 70px; align-items: center; }
  .people-section > div > p:not(.eyebrow) { color: var(--color-muted); margin: 24px 0 18px; }
  .people-portraits { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  .people-portraits figure { margin: 0; min-width: 0; }
  .people-portraits img { width: 100%; height: auto; aspect-ratio: 4/5; object-fit: cover; object-position: center; background: var(--color-surface); border: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent); }
  figcaption strong { display: block; margin-top: 12px; font-size: .95rem; }
  figcaption span { display: block; margin-top: 4px; font-size: .78rem; line-height: 1.5; color: var(--color-muted); }
  .engagement-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 38px; }
  .engagement-list article { display: flex; flex-direction: column; align-items: flex-start; border-top: 1px solid color-mix(in srgb, var(--color-ink) 20%, transparent); padding-top: 24px; }
  .engagement-list p { flex: 1; color: var(--color-muted); font-size: .95rem; margin: 16px 0; }
  .faq-section { display: grid; grid-template-columns: .8fr 1.2fr; gap: 70px; }
  .faq-list details { border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent); }
  .faq-list details:first-child { border-top: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent); }
  .faq-list p { color: var(--color-muted); margin: 0 0 22px; font-size: .95rem; }
  .inquiry-section { text-align: center; padding-block: 64px 100px; border-top: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent); scroll-margin-top: 100px; }
  .inquiry-section h2 { font-size: clamp(2.4rem, 4.8vw, 4.2rem); }
  .inquiry-section > p:not(.eyebrow) { max-width: 47ch; margin: 24px auto; color: var(--color-muted); }
  .inquiry-section > p.inquiry-note { font-size: .8rem; margin-top: 18px; }
  a:focus-visible, button:focus-visible, summary:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 5px; }
  @media (max-width: 1000px) { .studio-hero { gap: 28px; } .feature-topline { font-size: .6rem; } .hero-actions { gap: 10px 18px; } .featured-courses, .practice-grid { gap: 18px; } .section-heading { gap: 30px; } .people-section { gap: 35px; } .delivery-columns { gap: 40px; } }
  @media (max-width: 800px) { .studio-hero { grid-template-columns: 1fr; padding-top: 145px; gap: 36px; } h1 { max-width: 13ch; font-size: clamp(2.8rem, 7vw, 4rem); } .hero-intro, .hero-detail { max-width: 48ch; } .hero-feature { max-width: 650px; } .section-heading { display: block; } .section-aside { max-width: 54ch; margin-top: 22px; } .featured-courses { grid-template-columns: repeat(3, minmax(0, 1fr)); } .practice-grid { grid-template-columns: 1fr; gap: 34px; } .practice-card { display: grid; grid-template-columns: .85fr 1.15fr; gap: 24px; align-items: center; } .practice-copy { padding-top: 0; } .practice-image, .guide-image { height: 220px; } .people-section { grid-template-columns: 1fr; } .people-portraits { max-width: 480px; } .faq-section { grid-template-columns: 1fr; gap: 30px; } }
  @media (max-width: 600px) { .featured-courses { grid-template-columns: 1fr; } .hero-note { display: none; } .studio-wrap { width: calc(100% - 40px); } .studio-section { padding-block: 52px; } .studio-hero { padding-top: 132px; padding-bottom: 44px; } h1 { font-size: 2.8rem; } .eyebrow { font-size: .65rem; margin-bottom: 16px; } .hero-intro { font-size: 1.1rem; } .hero-detail { font-size: .95rem; } .hero-feature { box-shadow: 6px 6px 0 color-mix(in srgb, var(--color-accent) 8%, var(--color-canvas)); } .feature-topline { padding: 12px; } .feature-caption { padding: 18px 14px; gap: 14px; } .feature-caption strong { font-size: 1.1rem; } .feature-kicker { font-size: .7rem; } .hero-actions { gap: 14px 20px; } .engagement-list, .delivery-columns, .ai-note > div { grid-template-columns: 1fr; gap: 30px; } .process-list { grid-template-columns: 1fr; gap: 24px; } .format-list { grid-template-columns: 1fr 1fr; gap: 0 20px; } .practice-card { display: block; } .practice-copy { padding-top: 22px; } .practice-image, .guide-image { height: 205px; } .people-portraits { gap: 14px; } .people-section { gap: 34px; } .inquiry-section { padding-block: 50px 72px; } .selection-footnote { line-height: 1.6; } }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition: none !important; } }
</style>
