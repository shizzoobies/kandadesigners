---
// The training section's own navigation: Overview, Samples, Meet the team,
// and the capabilities PDF. Centered under the hero of every /training/*
// page. Each stop is a mono kicker with a rust rule that draws in underneath
// on hover; the current page's rule is already drawn and carries a small
// square marker. aria-current does the work for assistive technology.
//
// The training pages use Astro's ClientRouter, so a tab click swaps content
// in place. The script below keeps the tabs at the same spot on screen
// across the swap, so the hero above and the content below change while
// the tabs hold still. transition:name lets the view transition morph the
// strip rather than fade it.
import { sectionLinks } from '../data/training.js';

const path = Astro.url.pathname;
const isCurrent = (href) => !href.endsWith('.pdf') && path === href;
---
<nav aria-label="Training section" class="tr-subnav mx-auto max-w-6xl px-6" transition:name="training-tabs">
  <ul class="tr-subnav-list">
    {sectionLinks.map((l) => (
      <li>
        <a
          href={l.href}
          download={l.download ? '' : undefined}
          data-astro-reload={l.download ? '' : undefined}
          aria-current={isCurrent(l.href) ? 'page' : undefined}
          class:list={['tr-stop', { 'is-current': isCurrent(l.href), 'is-file': l.download }]}
        >
          <span class="tr-stop-label">{l.label}</span>
          {l.download && (
            <svg class="tr-stop-glyph" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M8 2.5v8M4.5 7 8 10.5 11.5 7M3 13.5h10" />
            </svg>
          )}
          <span class="tr-stop-rule" aria-hidden="true"></span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  // Keep the tabs where they were across a client-side swap. Before Astro
  // prepares the next page we note the strip's viewport offset if the click
  // came from a tab. After the swap, and for the first moments after
  // astro:page-load, we re-measure every frame and scroll so the new strip
  // sits at that offset: the hero above it is still settling its entrance
  // animation, so a single measurement lands a few pixels off. The loop
  // stops early the moment the reader scrolls. Lenis is told the same number
  // so it does not ease back. Document-level listeners survive swaps; the
  // guard keeps a second module evaluation from doubling them.
  const w = window as any;
  if (!w.__trTabsBound) {
    w.__trTabsBound = true;
    let keepTop: number | null = null;
    let settling = 0;

    document.addEventListener('astro:before-preparation', (e: any) => {
      const from = e.sourceElement as Element | null;
      const fromTab = from?.closest?.('.tr-subnav a.tr-stop');
      const strip = document.querySelector('.tr-subnav');
      keepTop = fromTab && strip ? strip.getBoundingClientRect().top : null;
    });

    const place = () => {
      if (keepTop === null) return false;
      const strip = document.querySelector('.tr-subnav');
      if (!strip) return false;
      const delta = strip.getBoundingClientRect().top - keepTop;
      if (Math.abs(delta) < 1) return true;
      const y = Math.max(0, window.pageYOffset + delta);
      window.scrollTo(0, y);
      try {
        const lenis = w.__motion?.lenis;
        if (lenis?.scrollTo) lenis.scrollTo(y, { immediate: true, force: true });
      } catch {}
      return true;
    };

    const stop = () => { settling = 0; keepTop = null; };
    ['wheel', 'touchstart', 'keydown'].forEach((ev) => document.addEventListener(ev, stop, { passive: true }));

    document.addEventListener('astro:after-swap', () => { place(); });
    document.addEventListener('astro:page-load', () => {
      const token = ++settling;
      const started = performance.now();
      const tick = () => {
        if (settling !== token) return;
        place();
        if (performance.now() - started < 900) requestAnimationFrame(tick);
        else stop();
      };
      tick();
    });
  }
</script>

<style>
  .tr-subnav-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 2.75rem;
    margin: 0;
    padding: 1.1rem 0;
    list-style: none;
    border-top: 1px solid rgb(34 28 21 / 0.1);
    border-bottom: 1px solid rgb(34 28 21 / 0.1);
  }
  .tr-stop {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out-expo);
  }
  .tr-stop:hover,
  .tr-stop:focus-visible {
    color: var(--color-ink);
  }
  .tr-stop.is-current {
    color: var(--color-accent);
  }
  .tr-stop-glyph {
    width: 0.9rem;
    height: 0.9rem;
  }
  .tr-stop-rule {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--dur-fast) var(--ease-out-expo);
  }
  .tr-stop:hover .tr-stop-rule,
  .tr-stop:focus-visible .tr-stop-rule,
  .tr-stop.is-current .tr-stop-rule {
    transform: scaleX(1);
  }
  .tr-stop.is-current .tr-stop-rule::before {
    content: '';
    position: absolute;
    left: 0;
    top: -3px;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: currentColor;
  }
  @media (prefers-reduced-motion: reduce) {
    .tr-stop,
    .tr-stop-rule { transition: none; }
  }
</style>
