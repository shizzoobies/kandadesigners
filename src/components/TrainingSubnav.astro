---
// The training section's own navigation: Overview, Samples, The bench, and
// the capabilities PDF. Centered under the hero of every /training/* page.
// Each stop is a mono kicker with a rust rule that draws in underneath on
// hover; the current page's rule is already drawn and carries a small
// square marker, the same drawn language as the services process rail.
// aria-current does the work for assistive technology.
import { sectionLinks } from '../data/training.js';

const path = Astro.url.pathname;
const isCurrent = (href) => !href.endsWith('.pdf') && path === href;
---
<nav aria-label="Training section" class="tr-subnav mx-auto max-w-6xl px-6">
  <ul class="tr-subnav-list">
    {sectionLinks.map((l) => (
      <li>
        <a
          href={l.href}
          download={l.download ? '' : undefined}
          aria-current={isCurrent(l.href) ? 'page' : undefined}
          class:list={['tr-stop', { 'is-current': isCurrent(l.href), 'is-file': l.download }]}
        >
          <span class="tr-stop-label">{l.label}</span>
          {l.download && (
            <svg class="tr-stop-glyph" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M8 2.5v8M4.5 7 8 10.5 11.5 7M3 13.5h10" />
            </svg>
          )}
          <span class="tr-stop-rule" aria-hidden="true"></span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<script is:inline>
  // Arrival half: runs as soon as this nav is parsed, before first paint of
  // anything below it. If the previous page was a training tab, place the
  // tabs at the exact viewport position they had when clicked, then reveal.
  (function () {
    var html = document.documentElement;
    if (!html.classList.contains('tr-arrive')) return;
    var top = parseFloat(sessionStorage.getItem('tr-top') || '');
    sessionStorage.removeItem('tr-top');
    // The document is not scrollable until the whole body has parsed, so
    // the placement waits for DOMContentLoaded (main is still invisible),
    // then reveals. Lenis, if it has started, is told the same position so
    // it does not ease back toward wherever it woke up.
    var place = function () {
      var nav = document.querySelector('.tr-subnav');
      if (nav && !isNaN(top)) {
        var y = Math.max(0, nav.getBoundingClientRect().top + window.pageYOffset - top);
        window.scrollTo(0, y);
        try {
          var lenis = window.__motion && window.__motion.lenis;
          if (lenis && lenis.scrollTo) lenis.scrollTo(y, { immediate: true, force: true });
        } catch (e) {}
      }
    };
    var reveal = function () {
      place();
      requestAnimationFrame(function () { html.classList.add('tr-arrive-in'); });
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', reveal);
    else reveal();
    // Fonts and images can still shift the hero height a little after the
    // reveal; settle once more on load unless the reader has scrolled.
    var startY = null;
    window.addEventListener('load', function () {
      if (startY === null || Math.abs(window.pageYOffset - startY) < 2) place();
    });
    document.addEventListener('DOMContentLoaded', function () { startY = window.pageYOffset; });
  })();
</script>

<script>
  // Departure half: on a tab click, remember where the tabs sit on screen,
  // fade the page out, then navigate. Modified clicks and the PDF download
  // are left to the browser.
  const nav = document.querySelector('.tr-subnav');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  nav?.querySelectorAll<HTMLAnchorElement>('a.tr-stop').forEach((a) => {
    a.addEventListener('click', (e) => {
      if (a.hasAttribute('download') || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
      if (a.getAttribute('aria-current') === 'page') { e.preventDefault(); return; }
      e.preventDefault();
      try {
        sessionStorage.setItem('tr-arrive', '1');
        sessionStorage.setItem('tr-top', String(nav.getBoundingClientRect().top));
      } catch {}
      const go = () => { location.href = a.href; };
      if (reduced) return go();
      document.documentElement.classList.add('tr-leave');
      setTimeout(go, 170);
    });
  });
</script>

<style>
  .tr-subnav-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 2.75rem;
    margin: 0;
    padding: 1.1rem 0;
    list-style: none;
    border-top: 1px solid rgb(34 28 21 / 0.1);
    border-bottom: 1px solid rgb(34 28 21 / 0.1);
  }
  .tr-stop {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out-expo);
  }
  .tr-stop:hover,
  .tr-stop:focus-visible {
    color: var(--color-ink);
  }
  .tr-stop.is-current {
    color: var(--color-accent);
  }
  .tr-stop-glyph {
    width: 0.9rem;
    height: 0.9rem;
  }
  /* The rule: drawn from the left on hover, already drawn for the current
     stop, which also gets the square marker at its head. */
  .tr-stop-rule {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--dur-fast) var(--ease-out-expo);
  }
  .tr-stop:hover .tr-stop-rule,
  .tr-stop:focus-visible .tr-stop-rule,
  .tr-stop.is-current .tr-stop-rule {
    transform: scaleX(1);
  }
  .tr-stop.is-current .tr-stop-rule::before {
    content: '';
    position: absolute;
    left: 0;
    top: -3px;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: currentColor;
  }
  @media (prefers-reduced-motion: reduce) {
    .tr-stop,
    .tr-stop-rule { transition: none; }
  }
</style>
