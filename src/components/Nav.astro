---
import LogoLockup from './LogoLockup.astro';
import { phone } from '../data/contact.js';

const links = [
  { href: '/', label: 'Home' },
  { href: '/services/', label: 'Services' },
  // Label is "Mentorship" by Alex's call (2026-08-29): the professional
  // development lean, warm enough to carry the $10k apprenticeship. The
  // program itself keeps its 90-Day AI Launch name on the page.
  { href: '/ai-launch/', label: 'Mentorship' },
  // Training took the Free Course slot on 2026-09-03 by Alex's call: the
  // training content service line has its own buyers (L&D, HR, procurement)
  // and needs a front door. The course stays linked from the Mentorship
  // page, the home band, and the footer.
  { href: '/training/', label: 'Training' },
  { href: '/artists/', label: 'Artists' },
  // Contact left the nav 2026-08-31: the "Start a project" CTA beside these
  // links opens the same modal /contact/ hosts, so the two were one intent
  // spending two slots in a six-link bar. The page is unchanged and still
  // reachable from the footer's Studio column, which keeps it internally
  // linked sitewide for search.
];
---
<header data-nav class="fixed inset-x-0 top-0 z-50" transition:persist="site-nav">
  {/* relative z-50 keeps this bar, and the menu's close button, above the
      z-40 phone overlay instead of underneath it. */}
  <div class="relative z-50 mx-auto flex h-20 max-w-6xl items-center justify-between px-6">
    <a href="/" class="nav-logo flex items-center text-2xl" aria-label="K & A Performance home">
      <LogoLockup variant="nav" intro={Astro.url.pathname === '/'} />
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Primary">
      {links.map((l) => (
        <a
          href={l.href}
          data-no-modal
          class:list={[
            'nav-link font-heading text-base font-semibold tracking-wide transition-colors',
            Astro.url.pathname === l.href ? 'text-accent' : 'text-ink/80 hover:text-ink',
          ]}
        >
          {l.label}
        </a>
      ))}
      {/* Tap-to-call, approved by Alex 2026-09-25. On desktop it stays a
          quiet text link so the CTA keeps the weight. */}
      <a href={phone.href} class="font-heading text-sm font-semibold tracking-wide whitespace-nowrap text-ink/80 transition-colors hover:text-accent">
        {phone.display}
      </a>
      <a href="/contact/#scope" class="btn-accent">Start a project</a>
    </nav>

    <div class="flex items-center gap-3 lg:hidden">
      {/* Phones get a visible Call link beside the menu button, so dialing
          never takes opening the menu first. The accessible name starts with
          the visible word (WCAG 2.5.3) and carries the number. */}
      <a
        href={phone.href}
        aria-label={`Call ${phone.display}`}
        class="inline-flex min-h-11 items-center gap-2 px-1 font-heading text-base font-semibold tracking-wide text-ink transition-colors hover:text-accent"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
        Call
      </a>
      <button
        id="nav-toggle"
        class="group inline-flex min-h-11 min-w-11 items-center justify-center"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-overlay"
      >
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" class="text-ink group-aria-expanded:hidden" aria-hidden="true">
          <line x1="4" y1="9" x2="24" y2="9" />
          <line x1="4" y1="19" x2="24" y2="19" />
        </svg>
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="hidden text-ink group-aria-expanded:block" aria-hidden="true">
          <line x1="7" y1="7" x2="21" y2="21" />
          <line x1="21" y1="7" x2="7" y2="21" />
        </svg>
      </button>
    </div>
  </div>

  <div
    id="nav-overlay"
    class="fixed inset-0 z-40 hidden flex-col items-center justify-center gap-8 bg-canvas/95 backdrop-blur-md lg:hidden!"
  >
    {links.map((l) => (
      <a href={l.href} data-no-modal class="font-heading text-3xl text-ink">{l.label}</a>
    ))}
    <a href="/contact/#scope" class="btn-accent mt-4">Start a project</a>
    <a href={phone.href} class="font-heading text-lg text-ink underline underline-offset-4 transition-colors hover:text-accent">
      Call <span class="whitespace-nowrap">{phone.display}</span>
    </a>
  </div>
</header>

<script>
  // Phone menu. Esc closes it and hands focus back to the toggle; while it is
  // open, Tab and Shift+Tab cycle through the header only (the bar plus the
  // overlay links), and everything outside the header is inert, so neither
  // keyboard nor screen reader can wander into the page behind.
  const header = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = document.getElementById('nav-toggle');
  const overlay = document.getElementById('nav-overlay');
  let open = false;
  let inerted: HTMLElement[] = [];

  const focusables = () =>
    [...(header?.querySelectorAll<HTMLElement>('a[href], button:not([disabled])') ?? [])].filter(
      (el) => el.getClientRects().length > 0,
    );

  const setMenu = (next: boolean, returnFocus = false) => {
    if (!toggle || !overlay || next === open) return;
    open = next;
    overlay.classList.toggle('hidden', !open);
    overlay.classList.toggle('flex', open);
    header?.classList.toggle('menu-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) {
      inerted = [...document.body.children].filter(
        (el): el is HTMLElement => el instanceof HTMLElement && el !== header && !el.contains(header) && !el.inert,
      );
      inerted.forEach((el) => (el.inert = true));
    } else {
      inerted.forEach((el) => (el.inert = false));
      inerted = [];
      if (returnFocus) toggle.focus();
    }
  };

  toggle?.addEventListener('click', () => setMenu(!open));
  // Following a menu link closes the menu (matters on ClientRouter pages,
  // where the header persists across the navigation).
  overlay?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setMenu(false);
  });
  document.addEventListener('keydown', (e) => {
    if (!open) return;
    if (e.key === 'Escape') {
      e.preventDefault();
      setMenu(false, true);
    } else if (e.key === 'Tab') {
      const items = focusables();
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      const i = items.indexOf(document.activeElement as HTMLElement);
      if (e.shiftKey && (i <= 0)) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && (i === -1 || i === items.length - 1)) {
        e.preventDefault();
        first.focus();
      }
    }
  });
  // The overlay is phone-only; widening past lg with it open would leave the
  // page inert behind a menu that no longer shows.
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
    if (e.matches) setMenu(false);
  });
</script>
