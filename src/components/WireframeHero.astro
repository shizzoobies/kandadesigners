---
// Hero intro: a client site develops through four phases that dissolve
// into one another in place — sketch, blocking, styled, finished — with
// overlapping fades (two phases visible mid-transition). The frame itself
// never moves; the only life after settle is a very slow ken-burns inside
// the photograph. Finished mock is an editorial page for fictional client
// "Atelier North" (pine/brass, Pixabay photography): full-bleed image,
// vertical section rail, stacked display type, a "now showing" editorial
// row (no floating cards), press quote, mixed-scale strip, hairline footer.
---
<section class="relative flex min-h-screen items-center overflow-hidden px-6">
  <div
    id="wf-scene"
    class="pointer-events-none absolute bottom-[4%] right-[-4%] top-[-6%] hidden w-[66%] lg:block"
    aria-hidden="true"
  >
    <!-- Uneven stack of client-site windows behind the build frame.
         Mixed chrome: some macOS traffic lights, some Windows controls. -->
    <div data-bwin class="bwin absolute right-[4%] top-[-4%] z-[1] w-[34%] -rotate-[5deg] opacity-90">
      <div class="bwin-chrome">
        <span class="h-[9px] w-[9px] rounded-full bg-[#EC6A5E]"></span>
        <span class="h-[9px] w-[9px] rounded-full bg-[#F4BF4F]"></span>
        <span class="h-[9px] w-[9px] rounded-full bg-[#61C554]"></span>
      </div>
      <img src="/images/work-pbjsa.webp" alt="" class="aspect-[16/10] w-full object-cover object-top" loading="eager" />
    </div>
    <div data-bwin class="bwin absolute right-[-9%] top-[30%] z-[2] w-[38%] rotate-[6deg]">
      <div class="bwin-chrome justify-end gap-[14px]">
        <span class="bwin-glyph">&#8213;</span>
        <span class="bwin-glyph">&#9633;</span>
        <span class="bwin-glyph">&#10005;</span>
      </div>
      <img src="/images/work-fdaaf.webp" alt="" class="aspect-[16/10] w-full object-cover object-top" loading="eager" />
    </div>
    <div data-bwin class="bwin absolute bottom-[-4%] left-[14%] z-[1] w-[38%] rotate-3 opacity-95">
      <div class="bwin-chrome">
        <span class="h-[9px] w-[9px] rounded-full bg-[#EC6A5E]"></span>
        <span class="h-[9px] w-[9px] rounded-full bg-[#F4BF4F]"></span>
        <span class="h-[9px] w-[9px] rounded-full bg-[#61C554]"></span>
      </div>
      <img src="/images/work-mbsdoc.webp" alt="" class="aspect-[16/10] w-full object-cover object-top" loading="lazy" />
    </div>
    <div id="wf-frame" class="wf-lit absolute right-0 top-[14%] z-10 aspect-[800/540] w-[76%] overflow-hidden rounded-[14px] border border-ink/10 bg-[#FBF9F4]">

      <!-- PHASE 1 — wireframe sketch -->
      <div data-stage="1" class="absolute inset-0">
        <div class="absolute inset-x-0 top-0 h-[7%] border-b border-ink/25"></div>
        <div class="absolute bottom-[9%] left-[2.5%] top-[10%] w-[3%] border border-ink/20"></div>
        <div class="absolute bottom-[9%] right-0 top-[7%] w-[48%] border border-ink/25">
          <span class="absolute left-0 top-0 h-[1px] w-[152%] origin-top-left rotate-[52deg] bg-ink/20"></span>
          <span class="absolute bottom-0 left-0 h-[1px] w-[152%] origin-bottom-left -rotate-[52deg] bg-ink/20"></span>
        </div>
        <div class="absolute left-[9%] top-[12%] h-[3.5%] w-[20%] border border-ink/20"></div>
        <div class="absolute left-[9%] top-[20%] h-[9%] w-[34%] border border-ink/25"></div>
        <div class="absolute left-[9%] top-[30%] h-[9%] w-[26%] border border-ink/25"></div>
        <div class="absolute left-[9%] top-[42%] h-[2.5%] w-[36%] border border-ink/20"></div>
        <div class="absolute left-[9%] top-[47.5%] h-[4.5%] w-[14%] rounded-full border border-ink/25"></div>
        <div class="absolute left-[9%] top-[56%] h-[1px] w-[34%] bg-ink/25"></div>
        <div class="absolute left-[9%] top-[60%] h-[8%] w-[8%] border border-ink/25"></div>
        <div class="absolute left-[19%] top-[60%] h-[8%] w-[24%] border border-ink/20"></div>
        <div class="absolute left-[9%] top-[73%] h-[6%] w-[26%] border border-ink/20"></div>
        <div class="absolute bottom-[11%] left-[9%] h-[10%] w-[19%] border border-ink/20"></div>
        <div class="absolute bottom-[11%] left-[30%] h-[10%] w-[11%] border border-ink/20"></div>
        <div class="absolute bottom-[11%] left-[43%] h-[10%] w-[7%] border border-ink/20"></div>
        <div class="absolute inset-x-0 bottom-0 h-[8%] border-t border-ink/25"></div>
      </div>

      <!-- PHASE 2 — gray blocking -->
      <div data-stage="2" class="absolute inset-0 opacity-0">
        <div class="absolute inset-x-0 top-0 h-[7%] bg-ink/10"></div>
        <div class="absolute bottom-[9%] left-[2.5%] top-[10%] w-[3%] bg-ink/15"></div>
        <div class="absolute bottom-[9%] right-0 top-[7%] w-[48%] bg-ink/15"></div>
        <div class="absolute left-[9%] top-[12%] h-[3.5%] w-[20%] bg-ink/15"></div>
        <div class="absolute left-[9%] top-[20%] h-[9%] w-[34%] bg-ink/25"></div>
        <div class="absolute left-[9%] top-[30%] h-[9%] w-[26%] bg-ink/20"></div>
        <div class="absolute left-[9%] top-[42%] h-[2.5%] w-[36%] bg-ink/10"></div>
        <div class="absolute left-[9%] top-[47.5%] h-[4.5%] w-[14%] rounded-full bg-ink/20"></div>
        <div class="absolute left-[9%] top-[56%] h-[1px] w-[34%] bg-ink/20"></div>
        <div class="absolute left-[9%] top-[60%] h-[8%] w-[8%] bg-ink/20"></div>
        <div class="absolute left-[19%] top-[60%] h-[8%] w-[24%] bg-ink/10"></div>
        <div class="absolute left-[9%] top-[73%] h-[6%] w-[26%] bg-ink/10"></div>
        <div class="absolute bottom-[11%] left-[9%] h-[10%] w-[19%] bg-ink/15"></div>
        <div class="absolute bottom-[11%] left-[30%] h-[10%] w-[11%] bg-ink/15"></div>
        <div class="absolute bottom-[11%] left-[43%] h-[10%] w-[7%] bg-ink/15"></div>
        <div class="absolute inset-x-0 bottom-0 h-[8%] bg-ink/20"></div>
      </div>

      <!-- PHASE 3 — styled pass -->
      <div data-stage="3" class="absolute inset-0 opacity-0">
        <div class="absolute inset-x-0 top-0 flex h-[7%] items-center gap-[0.9%] border-b border-[#21423A]/10 bg-white/85 px-[3%]">
          <span class="h-[28%] aspect-square rounded-full bg-[#21423A]/20"></span>
          <span class="h-[28%] aspect-square rounded-full bg-[#21423A]/20"></span>
          <span class="h-[28%] aspect-square rounded-full bg-[#21423A]/20"></span>
        </div>
        <div class="absolute bottom-[9%] left-[2.5%] top-[10%] flex w-[3%] items-center justify-center bg-[#21423A]">
          <span class="rotate-180 font-heading text-[8px] tracking-[0.4em] text-[#FBF9F4]/80 [writing-mode:vertical-lr]">EXHIBITS · ARTISTS · VISIT</span>
        </div>
        <div class="absolute bottom-[9%] right-0 top-[7%] w-[48%] bg-gradient-to-br from-[#DCE8DE] to-[#B9CDBD]"></div>
        <div class="absolute left-[9%] top-[12%] flex items-center gap-[6px]">
          <span class="h-[9px] w-[9px] rounded-full bg-[#B9822E]"></span>
          <span class="font-heading text-[10px] font-semibold tracking-[0.16em] text-[#21423A]">ATELIER NORTH</span>
        </div>
        <div class="absolute left-[9%] top-[19%] w-[38%]">
          <p class="font-display text-[clamp(26px,3vw,44px)] leading-[0.98] text-[#21423A]">Craft,<br /><span class="italic text-[#B9822E]">curated.</span></p>
          <span class="mt-[10px] block h-[5px] w-[80%] rounded-full bg-[#21423A]/20"></span>
          <span class="mt-[12px] inline-block rounded-full bg-[#B9822E] px-[14px] py-[6px] font-heading text-[9px] text-white">Plan a visit</span>
        </div>
        <div class="absolute left-[9%] top-[56%] h-[1px] w-[34%] bg-[#21423A]/20"></div>
        <div class="absolute left-[9%] top-[60%] h-[8%] w-[8%] rounded-[4px] bg-[#CBDCCF]"></div>
        <div class="absolute left-[19%] top-[60%] h-[8%] w-[24%]">
          <span class="block h-[6px] w-[40%] rounded-full bg-[#B9822E]/50"></span>
          <span class="mt-[6px] block h-[8px] w-[60%] rounded-full bg-[#21423A]/25"></span>
        </div>
        <div class="absolute left-[9%] top-[73%] h-[6%] w-[26%]">
          <span class="block h-[6px] w-[90%] rounded-full bg-[#21423A]/20"></span>
          <span class="mt-[5px] block h-[4px] w-[40%] rounded-full bg-[#21423A]/15"></span>
        </div>
        <div class="absolute bottom-[11%] left-[9%] h-[10%] w-[19%] rounded-[4px] bg-[#CBDCCF]"></div>
        <div class="absolute bottom-[11%] left-[30%] h-[10%] w-[11%] rounded-[4px] bg-[#CBDCCF]"></div>
        <div class="absolute bottom-[11%] left-[43%] h-[10%] w-[7%] rounded-[4px] bg-[#CBDCCF]"></div>
        <div class="absolute inset-x-0 bottom-0 h-[8%] border-t border-[#21423A]/15 bg-[#FBF9F4]"></div>
      </div>

      <!-- PHASE 4 — the finished editorial page -->
      <div data-stage="4" class="absolute inset-0 opacity-0">
        <div class="absolute inset-x-0 top-0 z-20 flex h-[7%] items-center gap-[0.9%] border-b border-[#21423A]/10 bg-white/90 px-[3%]">
          <span class="h-[28%] aspect-square rounded-full bg-[#21423A]/15"></span>
          <span class="h-[28%] aspect-square rounded-full bg-[#21423A]/15"></span>
          <span class="h-[28%] aspect-square rounded-full bg-[#21423A]/15"></span>
          <span class="ml-auto flex h-[54%] w-[28%] items-center rounded-full border border-[#21423A]/10 bg-[#FBF9F4] px-[2%] font-heading text-[8.5px] text-[#6E7A72]">ateliernorth.com</span>
        </div>

        <div class="absolute bottom-[9%] right-0 top-[7%] w-[48%] overflow-hidden">
          <img id="wf-photo" src="/images/mock/pottery-hero.webp" alt="" class="h-full w-full object-cover" loading="eager" fetchpriority="high" />
          <span class="absolute inset-0 bg-gradient-to-t from-[#21423A]/40 via-transparent to-transparent"></span>
          <span class="absolute bottom-[4%] left-[6%] font-heading text-[8px] tracking-[0.22em] text-[#FBF9F4]/90">TERRA — NEW CERAMICS, OPENING MAY 4</span>
        </div>

        <div class="absolute bottom-[9%] left-[2.5%] top-[10%] flex w-[3%] items-center justify-center bg-[#21423A]">
          <span class="rotate-180 font-heading text-[8px] tracking-[0.4em] text-[#FBF9F4]/80 [writing-mode:vertical-lr]">EXHIBITS · ARTISTS · VISIT</span>
        </div>

        <div class="absolute left-[9%] top-[12%] flex items-center gap-[6px]">
          <span class="h-[9px] w-[9px] rounded-full bg-[#B9822E]"></span>
          <span class="font-heading text-[10px] font-semibold tracking-[0.16em] text-[#21423A]">ATELIER NORTH</span>
        </div>

        <div class="absolute left-[9%] top-[19%] w-[40%]">
          <p class="font-display text-[clamp(26px,3vw,44px)] leading-[0.98] text-[#21423A]">
            Craft,<br /><span class="italic text-[#B9822E]">curated.</span>
          </p>
          <p class="mt-[9px] max-w-[92%] font-body text-[9.5px] leading-relaxed text-[#6E7A72]">
            Forty makers. One converted mill. Ceramics, fiber, glass, and
            light — rotating seasonally.
          </p>
          <span class="mt-[11px] inline-flex items-center gap-[10px]">
            <span class="rounded-full bg-[#B9822E] px-[14px] py-[6px] font-heading text-[9px] text-white">Plan a visit</span>
            <span class="font-heading text-[8.5px] tracking-[0.12em] text-[#21423A]/80">THIS SEASON →</span>
          </span>
        </div>

        <!-- hairline divider -->
        <div class="absolute left-[9%] top-[56%] h-[1px] w-[34%] bg-[#21423A]/20"></div>

        <!-- "now showing" editorial row: stamp image + text, no card -->
        <div class="absolute left-[9%] top-[60%] flex w-[36%] items-center gap-[10px]">
          <span class="h-[44px] w-[44px] shrink-0 overflow-hidden rounded-[4px]">
            <img src="/images/mock/teaset.webp" alt="" class="h-full w-full object-cover" loading="lazy" />
          </span>
          <span>
            <span class="block font-heading text-[7.5px] font-semibold tracking-[0.18em] text-[#B9822E]">NOW SHOWING</span>
            <span class="mt-[2px] block font-display text-[13px] italic leading-tight text-[#21423A]">Terra — new ceramics</span>
            <span class="mt-[1px] block font-heading text-[7.5px] tracking-[0.1em] text-[#6E7A72]">MAY 4 — AUG 30</span>
          </span>
        </div>

        <!-- press quote -->
        <p class="absolute left-[9%] top-[73%] w-[28%] font-display text-[11px] italic leading-snug text-[#21423A]/85">
          “The most alive room in the city.”
          <span class="mt-[3px] block font-heading text-[7px] not-italic tracking-[0.14em] text-[#6E7A72]">COASTLINE JOURNAL</span>
        </p>

        <!-- mixed-scale strip -->
        <div class="absolute bottom-[11%] left-[9%] h-[10%] w-[19%] overflow-hidden rounded-[4px]">
          <img src="/images/mock/loom.webp" alt="" class="h-full w-full object-cover" loading="lazy" />
        </div>
        <div class="absolute bottom-[11%] left-[30%] h-[10%] w-[11%] overflow-hidden rounded-[4px]">
          <img src="/images/mock/exhibit.webp" alt="" class="h-full w-full object-cover" loading="lazy" />
        </div>
        <div class="absolute bottom-[11%] left-[43%] h-[10%] w-[7%] overflow-hidden rounded-[4px]">
          <img src="/images/mock/vase.webp" alt="" class="h-full w-full object-cover" loading="lazy" />
        </div>

        <div class="absolute inset-x-0 bottom-0 flex h-[8%] items-center justify-between border-t border-[#21423A]/15 bg-[#FBF9F4] px-[4%]">
          <span class="font-heading text-[8px] tracking-[0.1em] text-[#6E7A72]">&copy; ATELIER NORTH &middot; THU–SUN 10–6</span>
          <span class="flex gap-[12px]">
            <span class="font-heading text-[8px] tracking-[0.1em] text-[#21423A]/70">NEWSLETTER</span>
            <span class="font-heading text-[8px] tracking-[0.1em] text-[#21423A]/70">INSTAGRAM</span>
            <span class="font-heading text-[8px] tracking-[0.1em] text-[#21423A]/70">MAPS</span>
          </span>
        </div>
      </div>

    </div>
  </div>

  <div class="relative mx-auto w-full max-w-6xl pt-20">
    <h1
      data-animate="type-settle"
      class="font-display max-w-4xl text-[clamp(3.25rem,9vw,7.5rem)] leading-[0.95] tracking-tight"
    >
      Built to <span class="text-accent italic">perform.</span>
    </h1>
    <p
      data-animate="type-settle"
      data-animate-delay="0.15"
      class="mt-8 max-w-xl text-lg leading-relaxed text-muted"
    >
      K &amp; A Performance crafts fast, animated, AI-ready websites for
      businesses that refuse to blend in.
    </p>
    <div data-animate="type-settle" data-animate-delay="0.3" class="mt-10 flex flex-wrap gap-4">
      <a href="/contact/#scope" class="btn-accent">Start a project</a>
      <a href="/work/" class="btn-ghost">See the work</a>
    </div>
  </div>

  <div
    id="scroll-cue"
    class="absolute bottom-8 left-1/2 flex -translate-x-1/2 flex-col items-center gap-3 text-muted transition-opacity duration-500"
    aria-hidden="true"
  >
    <span class="font-heading text-[0.65rem] uppercase tracking-[0.35em]">Scroll</span>
    <span class="cue-line"></span>
  </div>
</section>

<style>
  .bwin {
    border-radius: 10px;
    border: 1px solid rgb(34 28 21 / 0.1);
    background: white;
    overflow: hidden;
    box-shadow: 0 12px 34px -14px rgb(34 28 21 / 0.28);
  }
  .bwin-chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 22px;
    padding: 0 10px;
    background: rgb(251 249 244 / 0.95);
    border-bottom: 1px solid rgb(34 28 21 / 0.08);
  }
  .bwin-glyph {
    font-size: 8px;
    line-height: 1;
    color: rgb(34 28 21 / 0.45);
  }
  #wf-frame.wf-lit {
    box-shadow:
      0 1px 2px rgb(34 28 21 / 0.05),
      0 16px 40px -14px rgb(34 28 21 / 0.18),
      0 32px 80px -32px rgb(108 92 231 / 0.3);
  }
  .cue-line {
    position: relative;
    width: 1px;
    height: 2.75rem;
    background: rgb(34 28 21 / 0.15);
    overflow: hidden;
  }
  .cue-line::after {
    content: '';
    position: absolute;
    left: 0;
    top: -50%;
    width: 100%;
    height: 50%;
    background: var(--color-accent);
    animation: cue-drop 1.8s ease-in-out infinite;
  }
  @keyframes cue-drop {
    0% { transform: translateY(0); }
    100% { transform: translateY(300%); }
  }
  #scroll-cue.cue-hidden {
    opacity: 0;
    pointer-events: none;
  }
  :global(.motion-reduced) .cue-line::after {
    animation: none;
    top: 0;
    height: 100%;
  }
</style>

<script>
  import gsap from 'gsap';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const frame = document.getElementById('wf-frame');
  const photo = document.getElementById('wf-photo');
  const stage = (n) => frame?.querySelector(`[data-stage="${n}"]`);

  if (frame && !reduced) {
    gsap.set(frame, { autoAlpha: 0 });
    gsap.set([stage(2), stage(3), stage(4)], { autoAlpha: 0 });

    const tl = gsap.timeline({
      delay: 0.35,
      onComplete: () => {
        // The only life after settle: a very slow drift inside the photo.
        gsap.to(photo, { scale: 1.05, duration: 14, ease: 'sine.inOut', yoyo: true, repeat: -1 });
      },
    });

    // The window stack drifts in first, then the front frame's phases
    // dissolve in place with overlap — two visible mid-transition.
    tl.from('#wf-scene [data-bwin]', { opacity: 0, y: 46, scale: 0.94, duration: 0.8, stagger: 0.14, ease: 'expo.out' }, 0)
      .to(frame, { autoAlpha: 1, duration: 0.6, ease: 'power2.out' }, 0.5)
      .to(stage(2), { autoAlpha: 1, duration: 1.0, ease: 'power1.inOut' }, '+=0.7')
      .to(stage(1), { autoAlpha: 0, duration: 1.1, ease: 'power1.inOut' }, '<40%')
      .to(stage(3), { autoAlpha: 1, duration: 1.0, ease: 'power1.inOut' }, '+=0.55')
      .to(stage(2), { autoAlpha: 0, duration: 1.1, ease: 'power1.inOut' }, '<40%')
      .to(stage(4), { autoAlpha: 1, duration: 1.1, ease: 'power1.inOut' }, '+=0.55')
      .to(stage(3), { autoAlpha: 0, duration: 0.85, ease: 'power1.inOut' }, '<25%');
  } else if (frame) {
    gsap.set([stage(1), stage(2), stage(3)], { autoAlpha: 0 });
    gsap.set(stage(4), { autoAlpha: 1 });
  }

  const cue = document.getElementById('scroll-cue');
  const hideCue = () => {
    if (window.scrollY > 60) {
      cue?.classList.add('cue-hidden');
      window.removeEventListener('scroll', hideCue);
    }
  };
  window.addEventListener('scroll', hideCue, { passive: true });
</script>
