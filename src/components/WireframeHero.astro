---
// Hero intro: a client site is built through four visible stages, each at a
// different spot and angle in the hero space — wireframe sketch, gray
// blocking, styled pass, then the finished page — before settling into its
// final position. The finished mock is a dense, real-feeling site for a
// fictional gallery ("Atelier North") with its own pine/brass palette
// (deliberately not ours) and Pixabay photography. Cinematic settle:
// shadow bloom, ken-burns photo, breathing float. No auto-scroll.
---
<section class="relative flex min-h-screen items-center overflow-hidden px-6">
  <div
    id="wf-scene"
    class="pointer-events-none absolute right-[-6%] top-1/2 hidden w-[60%] -translate-y-1/2 lg:block"
    aria-hidden="true"
  >
    <div id="wf-mover">
      <div id="wf-frame" class="relative aspect-[800/540] w-full overflow-hidden rounded-[14px] border border-ink/10 bg-[#FBF9F4]">

        <!-- STAGE 1 — wireframe sketch -->
        <div data-stage="1" class="absolute inset-0">
          <div class="absolute inset-x-0 top-0 h-[8%] border-b border-ink/25"></div>
          <div class="absolute left-[4%] top-[9.5%] h-[4%] w-[22%] rounded-sm border border-ink/25"></div>
          <div class="absolute right-[4%] top-[9.5%] h-[4%] w-[34%] rounded-sm border border-ink/25"></div>
          <div class="absolute left-[4%] top-[20%] h-[6%] w-[38%] border border-ink/25"></div>
          <div class="absolute left-[4%] top-[28%] h-[3%] w-[30%] border border-ink/20"></div>
          <div class="absolute left-[4%] top-[34%] h-[5%] w-[18%] rounded-full border border-ink/25"></div>
          <div class="absolute right-[4%] top-[18%] h-[32%] w-[45%] border border-ink/25">
            <span class="absolute left-0 top-0 h-full w-full">
              <span class="absolute left-0 top-0 h-[1px] w-[141%] origin-top-left rotate-[36deg] bg-ink/20"></span>
              <span class="absolute bottom-0 left-0 h-[1px] w-[141%] origin-bottom-left -rotate-[36deg] bg-ink/20"></span>
            </span>
          </div>
          <div class="absolute bottom-[30%] left-[4%] h-[14%] w-[28%] border border-ink/25"></div>
          <div class="absolute bottom-[30%] left-[36%] h-[14%] w-[28%] border border-ink/25"></div>
          <div class="absolute bottom-[30%] right-[4%] h-[14%] w-[28%] border border-ink/25"></div>
          <div class="absolute bottom-[14%] left-[4%] h-[10%] w-[21.5%] border border-ink/20"></div>
          <div class="absolute bottom-[14%] left-[28.5%] h-[10%] w-[21.5%] border border-ink/20"></div>
          <div class="absolute bottom-[14%] left-[53%] h-[10%] w-[21.5%] border border-ink/20"></div>
          <div class="absolute bottom-[14%] right-[4%] h-[10%] w-[21.5%] border border-ink/20"></div>
          <div class="absolute inset-x-0 bottom-0 h-[10%] border-t border-ink/25"></div>
        </div>

        <!-- STAGE 2 — gray blocking -->
        <div data-stage="2" class="absolute inset-0 opacity-0">
          <div class="absolute inset-x-0 top-0 h-[8%] bg-ink/10"></div>
          <div class="absolute left-[4%] top-[9.5%] h-[4%] w-[22%] rounded-sm bg-ink/15"></div>
          <div class="absolute right-[4%] top-[9.5%] h-[4%] w-[34%] rounded-sm bg-ink/10"></div>
          <div class="absolute left-[4%] top-[20%] h-[6%] w-[38%] bg-ink/20"></div>
          <div class="absolute left-[4%] top-[28%] h-[3%] w-[30%] bg-ink/10"></div>
          <div class="absolute left-[4%] top-[34%] h-[5%] w-[18%] rounded-full bg-ink/20"></div>
          <div class="absolute right-[4%] top-[18%] h-[32%] w-[45%] bg-ink/15"></div>
          <div class="absolute bottom-[30%] left-[4%] h-[14%] w-[28%] bg-ink/10"></div>
          <div class="absolute bottom-[30%] left-[36%] h-[14%] w-[28%] bg-ink/10"></div>
          <div class="absolute bottom-[30%] right-[4%] h-[14%] w-[28%] bg-ink/10"></div>
          <div class="absolute bottom-[14%] left-[4%] h-[10%] w-[21.5%] bg-ink/15"></div>
          <div class="absolute bottom-[14%] left-[28.5%] h-[10%] w-[21.5%] bg-ink/15"></div>
          <div class="absolute bottom-[14%] left-[53%] h-[10%] w-[21.5%] bg-ink/15"></div>
          <div class="absolute bottom-[14%] right-[4%] h-[10%] w-[21.5%] bg-ink/15"></div>
          <div class="absolute inset-x-0 bottom-0 h-[10%] bg-ink/20"></div>
        </div>

        <!-- STAGE 3 — styled pass (palette + type, images still swatches) -->
        <div data-stage="3" class="absolute inset-0 opacity-0">
          <div class="absolute inset-x-0 top-0 flex h-[8%] items-center gap-[0.9%] border-b border-[#21423A]/10 bg-white/80 px-[3%]">
            <span class="h-[26%] aspect-square rounded-full bg-[#21423A]/20"></span>
            <span class="h-[26%] aspect-square rounded-full bg-[#21423A]/20"></span>
            <span class="h-[26%] aspect-square rounded-full bg-[#21423A]/20"></span>
          </div>
          <div class="absolute left-[4%] top-[9.5%] flex items-center gap-[6px]">
            <span class="h-[10px] w-[10px] rounded-full bg-[#B9822E]"></span>
            <span class="font-heading text-[10px] font-semibold tracking-[0.14em] text-[#21423A]">ATELIER NORTH</span>
          </div>
          <div class="absolute left-[4%] top-[20%] w-[40%]">
            <p class="font-display text-[clamp(15px,1.5vw,22px)] leading-[1.08] text-[#21423A]">Contemporary craft, <span class="italic text-[#B9822E]">curated.</span></p>
            <span class="mt-[8px] block h-[5px] w-[86%] rounded-full bg-[#21423A]/20"></span>
            <span class="mt-[5px] block h-[5px] w-[62%] rounded-full bg-[#21423A]/20"></span>
            <span class="mt-[12px] inline-block rounded-full bg-[#B9822E] px-[14px] py-[6px] font-heading text-[9px] text-white">Visit the gallery</span>
          </div>
          <div class="absolute right-[4%] top-[18%] h-[32%] w-[45%] rounded-[8px] bg-gradient-to-br from-[#E8EFE9] to-[#CBDCCF]"></div>
          <div class="absolute bottom-[30%] left-[4%] h-[14%] w-[28%] rounded-[8px] bg-[#E8EFE9]"></div>
          <div class="absolute bottom-[30%] left-[36%] h-[14%] w-[28%] rounded-[8px] bg-[#E8EFE9]"></div>
          <div class="absolute bottom-[30%] right-[4%] h-[14%] w-[28%] rounded-[8px] bg-[#E8EFE9]"></div>
          <div class="absolute bottom-[14%] left-[4%] h-[10%] w-[21.5%] rounded-[6px] bg-[#CBDCCF]"></div>
          <div class="absolute bottom-[14%] left-[28.5%] h-[10%] w-[21.5%] rounded-[6px] bg-[#CBDCCF]"></div>
          <div class="absolute bottom-[14%] left-[53%] h-[10%] w-[21.5%] rounded-[6px] bg-[#CBDCCF]"></div>
          <div class="absolute bottom-[14%] right-[4%] h-[10%] w-[21.5%] rounded-[6px] bg-[#CBDCCF]"></div>
          <div class="absolute inset-x-0 bottom-0 h-[10%] bg-[#21423A]"></div>
        </div>

        <!-- STAGE 4 — the finished site (dense, real content, photos) -->
        <div data-stage="4" class="absolute inset-0 opacity-0">
          <div class="absolute inset-x-0 top-0 z-10 flex h-[8%] items-center gap-[0.9%] border-b border-[#21423A]/10 bg-white/85 px-[3%]">
            <span class="h-[26%] aspect-square rounded-full bg-[#21423A]/15"></span>
            <span class="h-[26%] aspect-square rounded-full bg-[#21423A]/15"></span>
            <span class="h-[26%] aspect-square rounded-full bg-[#21423A]/15"></span>
            <span class="ml-auto flex h-[52%] w-[30%] items-center rounded-full border border-[#21423A]/10 bg-[#FBF9F4] px-[2%] font-heading text-[8.5px] text-[#6E7A72]">ateliernorth.com</span>
          </div>
          <div class="absolute left-[4%] right-[4%] top-[9.5%] flex items-center justify-between">
            <span class="flex items-center gap-[6px]">
              <span class="h-[10px] w-[10px] rounded-full bg-[#B9822E]"></span>
              <span class="font-heading text-[10.5px] font-semibold tracking-[0.14em] text-[#21423A]">ATELIER NORTH</span>
            </span>
            <span class="flex items-center gap-[13px]">
              <span class="font-heading text-[8.5px] tracking-wide text-[#6E7A72]">Exhibits</span>
              <span class="font-heading text-[8.5px] tracking-wide text-[#6E7A72]">Artists</span>
              <span class="font-heading text-[8.5px] tracking-wide text-[#6E7A72]">Shop</span>
              <span class="font-heading text-[8.5px] tracking-wide text-[#6E7A72]">Visit</span>
              <span class="rounded-full bg-[#B9822E] px-[10px] py-[4px] font-heading text-[8px] text-white">Plan a visit</span>
            </span>
          </div>
          <div class="absolute left-[4%] top-[19%] w-[41%]">
            <p class="font-heading text-[8px] font-semibold tracking-[0.22em] text-[#B9822E]">SPRING SEASON</p>
            <p class="mt-[5px] font-display text-[clamp(15px,1.5vw,22px)] leading-[1.08] text-[#21423A]">
              Contemporary craft, <span class="italic text-[#B9822E]">curated.</span>
            </p>
            <p class="mt-[7px] font-body text-[9.5px] leading-relaxed text-[#6E7A72]">
              Rotating exhibitions from forty makers — ceramics, fiber, glass,
              and light. Open Thursday through Sunday in the old mill district.
            </p>
            <span class="mt-[10px] inline-flex gap-[8px]">
              <span class="rounded-full bg-[#B9822E] px-[13px] py-[6px] font-heading text-[8.5px] text-white">Visit the gallery</span>
              <span class="rounded-full border border-[#21423A]/30 px-[13px] py-[6px] font-heading text-[8.5px] text-[#21423A]">This season</span>
            </span>
          </div>
          <div class="absolute right-[4%] top-[17%] h-[33%] w-[45%] overflow-hidden rounded-[8px]">
            <img id="wf-photo" src="/images/mock/pottery-hero.webp" alt="" class="h-full w-full object-cover" loading="eager" fetchpriority="high" />
          </div>
          <div class="absolute bottom-[29%] left-[4%] h-[15%] w-[28%] rounded-[8px] bg-[#E8EFE9] px-[1.6%] py-[1.2%]">
            <p class="font-heading text-[8px] font-semibold tracking-[0.12em] text-[#B9822E]">EXHIBITS</p>
            <p class="mt-[4px] font-body text-[8.5px] leading-snug text-[#21423A]/85">Now showing: Terra — new ceramics from the north coast.</p>
          </div>
          <div class="absolute bottom-[29%] left-[36%] h-[15%] w-[28%] rounded-[8px] bg-[#E8EFE9] px-[1.6%] py-[1.2%]">
            <p class="font-heading text-[8px] font-semibold tracking-[0.12em] text-[#B9822E]">ARTISTS</p>
            <p class="mt-[4px] font-body text-[8.5px] leading-snug text-[#21423A]/85">Forty studios under one roof, from throwers to weavers.</p>
          </div>
          <div class="absolute bottom-[29%] right-[4%] h-[15%] w-[28%] rounded-[8px] bg-[#E8EFE9] px-[1.6%] py-[1.2%]">
            <p class="font-heading text-[8px] font-semibold tracking-[0.12em] text-[#B9822E]">VISIT</p>
            <p class="mt-[4px] font-body text-[8.5px] leading-snug text-[#21423A]/85">Thu–Sun, 10–6. Coffee cart on weekends.</p>
          </div>
          <div class="absolute bottom-[13.5%] left-[4%] right-[4%]">
            <div class="flex h-full gap-[1.5%]">
              <span class="h-[52px] w-1/4 overflow-hidden rounded-[6px]"><img src="/images/mock/teaset.webp" alt="" class="h-full w-full object-cover" loading="lazy" /></span>
              <span class="h-[52px] w-1/4 overflow-hidden rounded-[6px]"><img src="/images/mock/loom.webp" alt="" class="h-full w-full object-cover" loading="lazy" /></span>
              <span class="h-[52px] w-1/4 overflow-hidden rounded-[6px]"><img src="/images/mock/exhibit.webp" alt="" class="h-full w-full object-cover" loading="lazy" /></span>
              <span class="h-[52px] w-1/4 overflow-hidden rounded-[6px]"><img src="/images/mock/vase.webp" alt="" class="h-full w-full object-cover" loading="lazy" /></span>
            </div>
          </div>
          <div class="absolute inset-x-0 bottom-0 flex h-[10%] items-center justify-between bg-[#21423A] px-[4%]">
            <span class="font-heading text-[8.5px] text-[#FBF9F4]/90">&copy; Atelier North &middot; Craft, curated.</span>
            <span class="flex gap-[12px]">
              <span class="font-heading text-[8px] text-[#FBF9F4]/60">Newsletter</span>
              <span class="font-heading text-[8px] text-[#FBF9F4]/60">Instagram</span>
              <span class="font-heading text-[8px] text-[#FBF9F4]/60">Maps</span>
            </span>
          </div>
        </div>

      </div>
    </div>
  </div>

  <div class="relative mx-auto w-full max-w-6xl pt-20">
    <h1
      data-animate="type-settle"
      class="font-display max-w-4xl text-[clamp(3.25rem,9vw,7.5rem)] leading-[0.95] tracking-tight"
    >
      Built to <span class="text-accent italic">perform.</span>
    </h1>
    <p
      data-animate="type-settle"
      data-animate-delay="0.15"
      class="mt-8 max-w-xl text-lg leading-relaxed text-muted"
    >
      K &amp; A Performance crafts fast, animated, AI-ready websites for
      businesses that refuse to blend in.
    </p>
    <div data-animate="type-settle" data-animate-delay="0.3" class="mt-10 flex flex-wrap gap-4">
      <a href="/contact/#scope" class="btn-accent">Start a project</a>
      <a href="/work/" class="btn-ghost">See the work</a>
    </div>
  </div>

  <div
    id="scroll-cue"
    class="absolute bottom-8 left-1/2 flex -translate-x-1/2 flex-col items-center gap-3 text-muted transition-opacity duration-500"
    aria-hidden="true"
  >
    <span class="font-heading text-[0.65rem] uppercase tracking-[0.35em]">Scroll</span>
    <span class="cue-line"></span>
  </div>
</section>

<style>
  #wf-frame {
    transition: box-shadow 0.8s var(--ease-out-expo);
  }
  #wf-frame.wf-lit {
    box-shadow:
      0 1px 2px rgb(34 28 21 / 0.05),
      0 16px 40px -14px rgb(34 28 21 / 0.18),
      0 32px 80px -32px rgb(108 92 231 / 0.3);
  }
  .cue-line {
    position: relative;
    width: 1px;
    height: 2.75rem;
    background: rgb(34 28 21 / 0.15);
    overflow: hidden;
  }
  .cue-line::after {
    content: '';
    position: absolute;
    left: 0;
    top: -50%;
    width: 100%;
    height: 50%;
    background: var(--color-accent);
    animation: cue-drop 1.8s ease-in-out infinite;
  }
  @keyframes cue-drop {
    0% { transform: translateY(0); }
    100% { transform: translateY(300%); }
  }
  #scroll-cue.cue-hidden {
    opacity: 0;
    pointer-events: none;
  }
  :global(.motion-reduced) .cue-line::after {
    animation: none;
    top: 0;
    height: 100%;
  }
</style>

<script>
  import gsap from 'gsap';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const mover = document.getElementById('wf-mover');
  const frame = document.getElementById('wf-frame');
  const photo = document.getElementById('wf-photo');
  const stage = (n) => frame?.querySelector(`[data-stage="${n}"]`);

  // Waypoints for the build journey: each stage lives at a different spot
  // and angle in the hero space before the site settles home.
  const SPOTS = {
    sketch:  { x: -560, y: -150, rotation: -7, scale: 0.55 },
    blocks:  { x: -430, y: 170,  rotation: 5,  scale: 0.68 },
    styled:  { x: -150, y: -110, rotation: -3, scale: 0.84 },
    settled: { x: 0,    y: 0,    rotation: 0,  scale: 1 },
  };

  if (frame && !reduced) {
    gsap.set(mover, SPOTS.sketch);
    gsap.set(frame, { autoAlpha: 0 });
    gsap.set([stage(2), stage(3), stage(4)], { autoAlpha: 0 });

    const tl = gsap.timeline({
      delay: 0.3,
      onComplete: () => {
        frame.classList.add('wf-lit');
        gsap.to(mover, { y: '+=10', duration: 5.5, ease: 'sine.inOut', yoyo: true, repeat: -1 });
        gsap.to(photo, { scale: 1.07, duration: 11, ease: 'sine.inOut', yoyo: true, repeat: -1 });
      },
    });

    tl.to(frame, { autoAlpha: 1, duration: 0.45, ease: 'power2.out' })
      .to(mover, { ...SPOTS.blocks, duration: 0.95, ease: 'power2.inOut' }, '+=0.55')
      .to(stage(1), { autoAlpha: 0, duration: 0.3 }, '<45%')
      .to(stage(2), { autoAlpha: 1, duration: 0.3 }, '<')
      .to(mover, { ...SPOTS.styled, duration: 0.95, ease: 'power2.inOut' }, '+=0.5')
      .to(stage(2), { autoAlpha: 0, duration: 0.3 }, '<45%')
      .to(stage(3), { autoAlpha: 1, duration: 0.3 }, '<')
      .to(mover, { ...SPOTS.settled, duration: 1.05, ease: 'expo.inOut' }, '+=0.5')
      .to(stage(3), { autoAlpha: 0, duration: 0.35 }, '<55%')
      .to(stage(4), { autoAlpha: 1, duration: 0.35 }, '<');
  } else if (frame) {
    gsap.set([stage(1), stage(2), stage(3)], { autoAlpha: 0 });
    gsap.set(stage(4), { autoAlpha: 1 });
    frame.classList.add('wf-lit');
  }

  const cue = document.getElementById('scroll-cue');
  const hideCue = () => {
    if (window.scrollY > 60) {
      cue?.classList.add('cue-hidden');
      window.removeEventListener('scroll', hideCue);
    }
  };
  window.addEventListener('scroll', hideCue, { passive: true });
</script>
