---
// Hero intro: pieces of a webpage fly in from scattered spots and assemble
// into a finished, real-feeling site for a fictional client ("Atelier
// North") — real copy, a real photograph, our design language. After the
// pieces land it settles cinematically: shadow bloom, slow ken-burns on
// the photo, and a gentle breathing float. No auto-scroll — the cue below
// invites the visitor to move on their own.
---
<section class="relative flex min-h-screen items-center overflow-hidden px-6">
  <div
    id="wf-scene"
    class="pointer-events-none absolute right-[-6%] top-1/2 hidden w-[60%] -translate-y-1/2 lg:block"
    aria-hidden="true"
  >
    <div id="wf-frame" class="relative aspect-[800/540] w-full overflow-hidden rounded-[14px] border border-ink/10 bg-surface">
      <!-- browser chrome -->
      <div data-piece data-fly="0,-90,0" class="absolute inset-x-0 top-0 z-10 flex h-[9.5%] items-center gap-[0.9%] border-b border-ink/10 bg-canvas/80 px-[3%]">
        <span class="h-[26%] aspect-square rounded-full bg-ink/15"></span>
        <span class="h-[26%] aspect-square rounded-full bg-ink/15"></span>
        <span class="h-[26%] aspect-square rounded-full bg-ink/15"></span>
        <span class="ml-auto flex h-[46%] w-[30%] items-center rounded-full border border-ink/10 bg-surface px-[2%] font-heading text-[9px] text-muted">ateliernorth.com</span>
      </div>
      <!-- site nav -->
      <div data-piece data-fly="-160,-40,-4" class="absolute left-[4%] right-[4%] top-[13.5%] flex items-center justify-between">
        <span class="flex items-center gap-[7px]">
          <span class="h-[11px] w-[11px] rounded-full bg-accent"></span>
          <span class="font-heading text-[11px] font-semibold tracking-[0.14em] text-ink">ATELIER NORTH</span>
        </span>
        <span class="flex items-center gap-[14px]">
          <span class="font-heading text-[9px] tracking-wide text-muted">Exhibits</span>
          <span class="font-heading text-[9px] tracking-wide text-muted">Artists</span>
          <span class="font-heading text-[9px] tracking-wide text-muted">Visit</span>
          <span class="rounded-full bg-accent px-[10px] py-[4px] font-heading text-[8.5px] text-white">Plan a visit</span>
        </span>
      </div>
      <!-- hero copy block -->
      <div data-piece data-fly="-220,60,-6" class="absolute left-[4%] top-[30%] w-[41%]">
        <p class="font-display text-[clamp(16px,1.6vw,24px)] leading-[1.08] text-ink">
          Contemporary craft, <span class="italic text-accent">curated.</span>
        </p>
        <p class="mt-[8px] font-body text-[10px] leading-relaxed text-muted">
          Rotating exhibitions from forty makers — ceramics, fiber, glass, and
          light. Open Thursday through Sunday.
        </p>
        <span class="mt-[12px] inline-block rounded-full bg-accent px-[14px] py-[6px] font-heading text-[9px] text-white">Visit the gallery</span>
      </div>
      <!-- hero imagery -->
      <div data-piece data-fly="240,40,7" class="absolute right-[4%] top-[26%] h-[38%] w-[45%] overflow-hidden rounded-[10px]">
        <img id="wf-photo" src="/images/museum.webp" alt="" class="h-full w-full object-cover" loading="eager" fetchpriority="high" />
      </div>
      <!-- three feature cards -->
      <div data-piece data-fly="-120,190,-5" class="absolute bottom-[11%] left-[4%] h-[21%] w-[28%] rounded-[10px] border border-ink/10 bg-canvas/85 px-[1.8%] py-[1.4%]">
        <p class="font-heading text-[9px] font-semibold tracking-[0.12em] text-accent">EXHIBITS</p>
        <p class="mt-[5px] font-body text-[9.5px] leading-snug text-ink/80">Now showing: Terra — new ceramics from the north coast.</p>
      </div>
      <div data-piece data-fly="0,230,0" class="absolute bottom-[11%] left-[36%] h-[21%] w-[28%] rounded-[10px] border border-ink/10 bg-canvas/85 px-[1.8%] py-[1.4%]">
        <p class="font-heading text-[9px] font-semibold tracking-[0.12em] text-accent">ARTISTS</p>
        <p class="mt-[5px] font-body text-[9.5px] leading-snug text-ink/80">Forty studios under one roof, from throwers to weavers.</p>
      </div>
      <div data-piece data-fly="140,190,6" class="absolute bottom-[11%] right-[4%] h-[21%] w-[28%] rounded-[10px] border border-ink/10 bg-canvas/85 px-[1.8%] py-[1.4%]">
        <p class="font-heading text-[9px] font-semibold tracking-[0.12em] text-accent">VISIT</p>
        <p class="mt-[5px] font-body text-[9.5px] leading-snug text-ink/80">Thu–Sun, 10–6. Coffee cart on weekends.</p>
      </div>
      <!-- footer bar -->
      <div data-piece data-fly="0,110,0" class="absolute inset-x-0 bottom-0 flex h-[7%] items-center justify-between border-t border-ink/10 bg-canvas/80 px-[4%]">
        <span class="font-heading text-[8.5px] text-muted">&copy; Atelier North</span>
        <span class="font-heading text-[8.5px] text-muted">Instagram &middot; Maps</span>
      </div>
    </div>
  </div>

  <div class="relative mx-auto w-full max-w-6xl pt-20">
    <h1
      data-animate="type-settle"
      class="font-display max-w-4xl text-[clamp(3.25rem,9vw,7.5rem)] leading-[0.95] tracking-tight"
    >
      Built to <span class="text-accent italic">perform.</span>
    </h1>
    <p
      data-animate="type-settle"
      data-animate-delay="0.15"
      class="mt-8 max-w-xl text-lg leading-relaxed text-muted"
    >
      K &amp; A Performance crafts fast, animated, AI-ready websites for
      businesses that refuse to blend in.
    </p>
    <div data-animate="type-settle" data-animate-delay="0.3" class="mt-10 flex flex-wrap gap-4">
      <a href="/contact/#scope" class="btn-accent">Start a project</a>
      <a href="/work/" class="btn-ghost">See the work</a>
    </div>
  </div>

  <div
    id="scroll-cue"
    class="absolute bottom-8 left-1/2 flex -translate-x-1/2 flex-col items-center gap-3 text-muted transition-opacity duration-500"
    aria-hidden="true"
  >
    <span class="font-heading text-[0.65rem] uppercase tracking-[0.35em]">Scroll</span>
    <span class="cue-line"></span>
  </div>
</section>

<style>
  #wf-frame {
    transition: box-shadow 0.8s var(--ease-out-expo);
  }
  #wf-frame.wf-lit {
    box-shadow:
      0 1px 2px rgb(34 28 21 / 0.05),
      0 16px 40px -14px rgb(34 28 21 / 0.18),
      0 32px 80px -32px rgb(108 92 231 / 0.3);
  }
  .cue-line {
    position: relative;
    width: 1px;
    height: 2.75rem;
    background: rgb(34 28 21 / 0.15);
    overflow: hidden;
  }
  .cue-line::after {
    content: '';
    position: absolute;
    left: 0;
    top: -50%;
    width: 100%;
    height: 50%;
    background: var(--color-accent);
    animation: cue-drop 1.8s ease-in-out infinite;
  }
  @keyframes cue-drop {
    0% { transform: translateY(0); }
    100% { transform: translateY(300%); }
  }
  #scroll-cue.cue-hidden {
    opacity: 0;
    pointer-events: none;
  }
  :global(.motion-reduced) .cue-line::after {
    animation: none;
    top: 0;
    height: 100%;
  }
</style>

<script>
  import gsap from 'gsap';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const scene = document.getElementById('wf-scene');
  const frame = document.getElementById('wf-frame');
  const photo = document.getElementById('wf-photo');
  const pieces = frame ? [...frame.querySelectorAll('[data-piece]')] : [];

  if (frame && !reduced) {
    const tl = gsap.timeline({
      delay: 0.35,
      onComplete: () => {
        frame.classList.add('wf-lit');
        // Cinematic idle: the frame breathes, the photo drifts (ken burns).
        gsap.to(scene, { y: 10, duration: 5.5, ease: 'sine.inOut', yoyo: true, repeat: -1 });
        gsap.to(photo, { scale: 1.07, duration: 11, ease: 'sine.inOut', yoyo: true, repeat: -1 });
      },
    });
    tl.from(frame, { opacity: 0, scale: 0.94, duration: 0.6, ease: 'expo.out' });
    pieces.forEach((piece, i) => {
      const [x, y, r] = piece.dataset.fly.split(',').map(Number);
      tl.from(
        piece,
        { x, y, rotation: r, opacity: 0, duration: 0.75, ease: 'expo.out' },
        0.35 + i * 0.16
      );
    });
  } else if (frame) {
    frame.classList.add('wf-lit');
  }

  const cue = document.getElementById('scroll-cue');
  const hideCue = () => {
    if (window.scrollY > 60) {
      cue?.classList.add('cue-hidden');
      window.removeEventListener('scroll', hideCue);
    }
  };
  window.addEventListener('scroll', hideCue, { passive: true });
</script>
