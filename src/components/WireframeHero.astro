---
// Hero intro: pieces of a site (chrome, nav, copy, imagery, cards, footer)
// fly in from scattered spots and assemble into one finished mock — a
// stylized site built from our own tokens, not a screenshot. When the
// assembly lands, the page glides down to the work gallery on its own
// (unless the visitor has already started scrolling).
---
<section class="relative flex min-h-screen items-center overflow-hidden px-6">
  <div
    id="wf-scene"
    class="pointer-events-none absolute right-[-6%] top-1/2 hidden w-[60%] -translate-y-1/2 lg:block"
    aria-hidden="true"
  >
    <div id="wf-frame" class="relative aspect-[800/540] w-full overflow-hidden rounded-[14px] border border-ink/10 bg-surface">
      <!-- browser chrome -->
      <div data-piece data-fly="0,-90,0" class="absolute inset-x-0 top-0 flex h-[9.5%] items-center gap-[0.9%] border-b border-ink/10 bg-canvas/70 px-[3%]">
        <span class="h-[26%] aspect-square rounded-full bg-ink/15"></span>
        <span class="h-[26%] aspect-square rounded-full bg-ink/15"></span>
        <span class="h-[26%] aspect-square rounded-full bg-ink/15"></span>
        <span class="ml-auto h-[42%] w-[26%] rounded-full border border-ink/10 bg-surface"></span>
      </div>
      <!-- site nav -->
      <div data-piece data-fly="-160,-40,-4" class="absolute left-[4%] right-[4%] top-[14%] flex items-center justify-between">
        <span class="flex items-center gap-[6px]">
          <span class="h-[10px] w-[10px] rounded-full bg-accent"></span>
          <span class="h-[7px] w-[54px] rounded-full bg-ink/25"></span>
        </span>
        <span class="flex items-center gap-[10px]">
          <span class="h-[6px] w-[34px] rounded-full bg-ink/15"></span>
          <span class="h-[6px] w-[34px] rounded-full bg-ink/15"></span>
          <span class="h-[6px] w-[34px] rounded-full bg-ink/15"></span>
          <span class="h-[18px] w-[64px] rounded-full bg-accent/85"></span>
        </span>
      </div>
      <!-- hero copy block -->
      <div data-piece data-fly="-220,60,-6" class="absolute left-[4%] top-[30%] w-[40%]">
        <span class="block h-[13px] w-[92%] rounded-full bg-ink/40"></span>
        <span class="mt-[7px] block h-[13px] w-[70%] rounded-full bg-accent/50"></span>
        <span class="mt-[14px] block h-[6px] w-[88%] rounded-full bg-ink/15"></span>
        <span class="mt-[6px] block h-[6px] w-[64%] rounded-full bg-ink/15"></span>
        <span class="mt-[16px] inline-block h-[22px] w-[84px] rounded-full bg-accent"></span>
      </div>
      <!-- hero imagery -->
      <div data-piece data-fly="240,40,7" class="absolute right-[4%] top-[26%] h-[36%] w-[46%] overflow-hidden rounded-[10px] bg-gradient-to-br from-[#EFEAFB] to-[#D9CEF6]">
        <span class="absolute left-[12%] top-[18%] h-[46%] w-[46%] rounded-full bg-accent/25"></span>
        <span class="absolute bottom-[-18%] right-[-8%] h-[70%] w-[70%] rounded-full bg-accent/15"></span>
      </div>
      <!-- three feature cards -->
      <div data-piece data-fly="-120,190,-5" class="absolute bottom-[12%] left-[4%] h-[20%] w-[28%] rounded-[10px] border border-ink/10 bg-canvas/80 p-[1.6%]">
        <span class="block h-[8px] w-[36%] rounded-full bg-accent/60"></span>
        <span class="mt-[8px] block h-[5px] w-[82%] rounded-full bg-ink/15"></span>
        <span class="mt-[5px] block h-[5px] w-[60%] rounded-full bg-ink/15"></span>
      </div>
      <div data-piece data-fly="0,230,0" class="absolute bottom-[12%] left-[36%] h-[20%] w-[28%] rounded-[10px] border border-ink/10 bg-canvas/80 p-[1.6%]">
        <span class="block h-[8px] w-[36%] rounded-full bg-accent/60"></span>
        <span class="mt-[8px] block h-[5px] w-[82%] rounded-full bg-ink/15"></span>
        <span class="mt-[5px] block h-[5px] w-[60%] rounded-full bg-ink/15"></span>
      </div>
      <div data-piece data-fly="140,190,6" class="absolute bottom-[12%] right-[4%] h-[20%] w-[28%] rounded-[10px] border border-ink/10 bg-canvas/80 p-[1.6%]">
        <span class="block h-[8px] w-[36%] rounded-full bg-accent/60"></span>
        <span class="mt-[8px] block h-[5px] w-[82%] rounded-full bg-ink/15"></span>
        <span class="mt-[5px] block h-[5px] w-[60%] rounded-full bg-ink/15"></span>
      </div>
      <!-- footer bar -->
      <div data-piece data-fly="0,110,0" class="absolute inset-x-0 bottom-0 flex h-[7%] items-center justify-between border-t border-ink/10 bg-canvas/70 px-[4%]">
        <span class="h-[24%] w-[14%] rounded-full bg-ink/20"></span>
        <span class="h-[24%] w-[24%] rounded-full bg-ink/10"></span>
      </div>
    </div>
  </div>

  <div class="relative mx-auto w-full max-w-6xl pt-20">
    <h1
      data-animate="type-settle"
      class="font-display max-w-4xl text-[clamp(3.25rem,9vw,7.5rem)] leading-[0.95] tracking-tight"
    >
      Built to <span class="text-accent italic">perform.</span>
    </h1>
    <p
      data-animate="type-settle"
      data-animate-delay="0.15"
      class="mt-8 max-w-xl text-lg leading-relaxed text-muted"
    >
      K &amp; A Performance crafts fast, animated, AI-ready websites for
      businesses that refuse to blend in.
    </p>
    <div data-animate="type-settle" data-animate-delay="0.3" class="mt-10 flex flex-wrap gap-4">
      <a href="/contact/#scope" class="btn-accent">Start a project</a>
      <a href="/work/" class="btn-ghost">See the work</a>
    </div>
  </div>

  <div
    id="scroll-cue"
    class="absolute bottom-8 left-1/2 flex -translate-x-1/2 flex-col items-center gap-3 text-muted transition-opacity duration-500"
    aria-hidden="true"
  >
    <span class="font-heading text-[0.65rem] uppercase tracking-[0.35em]">Scroll</span>
    <span class="cue-line"></span>
  </div>
</section>

<style>
  #wf-frame {
    transition: box-shadow 0.8s var(--ease-out-expo);
  }
  #wf-frame.wf-lit {
    box-shadow:
      0 1px 2px rgb(34 28 21 / 0.05),
      0 16px 40px -14px rgb(34 28 21 / 0.18),
      0 32px 80px -32px rgb(108 92 231 / 0.3);
  }
  .cue-line {
    position: relative;
    width: 1px;
    height: 2.75rem;
    background: rgb(34 28 21 / 0.15);
    overflow: hidden;
  }
  .cue-line::after {
    content: '';
    position: absolute;
    left: 0;
    top: -50%;
    width: 100%;
    height: 50%;
    background: var(--color-accent);
    animation: cue-drop 1.8s ease-in-out infinite;
  }
  @keyframes cue-drop {
    0% { transform: translateY(0); }
    100% { transform: translateY(300%); }
  }
  #scroll-cue.cue-hidden {
    opacity: 0;
    pointer-events: none;
  }
  :global(.motion-reduced) .cue-line::after {
    animation: none;
    top: 0;
    height: 100%;
  }
</style>

<script>
  import gsap from 'gsap';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const frame = document.getElementById('wf-frame');
  const pieces = frame ? [...frame.querySelectorAll('[data-piece]')] : [];

  let userScrolled = false;
  const markScrolled = () => { userScrolled = true; };
  ['wheel', 'touchstart', 'keydown'].forEach((ev) =>
    window.addEventListener(ev, markScrolled, { passive: true, once: true })
  );

  function glideToGallery() {
    if (userScrolled || window.scrollY > 60) return;
    const target = document.getElementById('gallery');
    if (!target) return;
    const lenis = window.__motion?.lenis;
    if (lenis) lenis.scrollTo(target, { duration: 1.6, offset: -40 });
    else target.scrollIntoView({ behavior: 'smooth' });
  }

  if (frame && !reduced) {
    const tl = gsap.timeline({
      delay: 0.35,
      onComplete: () => {
        frame.classList.add('wf-lit');
        setTimeout(glideToGallery, 1400);
      },
    });
    tl.from(frame, { opacity: 0, scale: 0.94, duration: 0.6, ease: 'expo.out' });
    pieces.forEach((piece, i) => {
      const [x, y, r] = piece.dataset.fly.split(',').map(Number);
      tl.from(
        piece,
        { x, y, rotation: r, opacity: 0, duration: 0.75, ease: 'expo.out' },
        0.35 + i * 0.16
      );
    });
  } else if (frame) {
    frame.classList.add('wf-lit');
  }

  const cue = document.getElementById('scroll-cue');
  const hideCue = () => {
    if (window.scrollY > 60) {
      cue?.classList.add('cue-hidden');
      window.removeEventListener('scroll', hideCue);
    }
  };
  window.addEventListener('scroll', hideCue, { passive: true });
</script>
