---
// The brand lockup: a browser window framing "K & A" in serif with the rust
// looped ampersand, "PERFORMANCE" in tracked caps breaking the frame, and a
// mouse hanging off the right edge. Delivered as finished artwork, so it ships
// as an image rather than being reassembled from live type; `New Logo/K&A
// Logo.ai` is the vector source of truth for print and any future SVG.
//
// Both variants size off the parent's font-size in em, which is what lets the
// nav lockup ride the shrink-on-scroll transform without its own breakpoints.
//
// variant "nav": mark only, compact.
// variant "full": mark plus the letterspaced descriptor, for the footer.
interface Props {
  variant?: 'nav' | 'full';
}
const { variant = 'full' } = Astro.props;
---
{variant === 'nav' ? (
  <span class="logo-lockup logo-nav">
    <img class="logo-mark" src="/images/logo-lockup.webp?v=1" alt="" width="800" height="303" decoding="async" />
  </span>
) : (
  <span class="logo-lockup logo-full">
    <img class="logo-mark" src="/images/logo-lockup.webp?v=1" alt="" width="800" height="303" decoding="async" />
    <span class="logo-tag">Web Design &amp; AI Integration</span>
  </span>
)}

<style is:global>
  /* Global: the lockup renders inside nav links and the footer alike. */
  .logo-lockup {
    display: inline-flex;
    flex-direction: column;
    color: var(--color-ink);
    line-height: 1;
  }
  .logo-mark {
    display: block;
    height: auto;
    /* The anchors carry the accessible name, so the mark stays decorative. */
  }
  .logo-nav {
    align-items: flex-start;
  }
  .logo-nav .logo-mark {
    width: 4.5em;
  }
  /* Left-aligned so the descriptor hangs off the same edge as the mark and the
     footer copy beneath it. Centring made the tracked caps, which run wider
     than the mark, overhang it on both sides. */
  .logo-full {
    align-items: flex-start;
  }
  .logo-full .logo-mark {
    width: 5.6em;
  }
  .logo-full .logo-tag {
    font-family: var(--font-mono);
    font-size: 0.2em;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-top: 1.2em;
  }
</style>
