---
// The brand lockup: a browser window framing "K & A" in serif with the rust
// looped ampersand, "PERFORMANCE" in tracked caps breaking the frame, and a
// mouse hanging off the right edge. Delivered as finished artwork, so it ships
// as an image rather than being reassembled from live type; `New Logo/K&A
// Logo.ai` is the vector source of truth for print and any future SVG.
//
// Both variants size off the parent's font-size in em, which is what lets the
// nav lockup ride the shrink-on-scroll transform without its own breakpoints.
//
// variant "nav": mark only, compact.
// variant "full": mark plus the letterspaced descriptor, for the footer.
import LogoIntroAnimation from './LogoIntroAnimation.astro';

interface Props {
  variant?: 'nav' | 'full';
  /** Draw the mark on once before settling into the static artwork. */
  intro?: boolean;
}
const { variant = 'full', intro = false } = Astro.props;
---
{variant === 'nav' ? (
  <span class="logo-lockup logo-nav">
    {/* The drawn intro sits on top of the finished mark and only takes over
        while it is actually playing, so the <img> keeps defining the box and
        nothing moves. Ordered before the mark so the CSS sibling rule below
        can hide it without any script. */}
    {intro && <LogoIntroAnimation />}
    {/* alt="" on purpose: the wrapping link already announces "K & A
        Performance home", so naming the mark would say it twice. */}
    <img class="logo-mark" src="/images/logo-lockup.webp?v=1" alt="" width="800" height="303" decoding="async" />
  </span>
) : (
  <span class="logo-lockup logo-full">
    {/* alt="" on purpose, same reason as the nav variant: the link around it
        carries the accessible name. */}
    <img class="logo-mark" src="/images/logo-lockup.webp?v=1" alt="" width="800" height="303" decoding="async" />
    <span class="logo-tag">Web Design &amp; AI Integration</span>
  </span>
)}

<style is:global>
  /* Global: the lockup renders inside nav links and the footer alike. */
  .logo-lockup {
    display: inline-flex;
    flex-direction: column;
    color: var(--color-ink);
    line-height: 1;
  }
  .logo-mark {
    display: block;
    height: auto;
    /* The anchors carry the accessible name, so the mark stays decorative. */
  }
  .logo-nav {
    align-items: flex-start;
    position: relative;
  }
  /* While the intro is drawing it covers the finished mark; the moment it
     stops (scroll, or reduced motion, or already seen this session) the
     static artwork is what's left. Pure CSS so there is no scripted swap. */
  .logo-nav .ka-logo-anim {
    z-index: 1;
    transition: opacity 0.35s ease;
  }
  .logo-nav .logo-mark {
    transition: opacity 0.35s ease;
  }
  .logo-nav .ka-logo-anim[data-playing] ~ .logo-mark {
    opacity: 0;
  }
  .logo-nav .logo-mark {
    width: 4.5em;
  }
  /* Left-aligned so the descriptor hangs off the same edge as the mark and the
     footer copy beneath it. Centring made the tracked caps, which run wider
     than the mark, overhang it on both sides. */
  .logo-full {
    align-items: flex-start;
  }
  .logo-full .logo-mark {
    width: 5.6em;
  }
  .logo-full .logo-tag {
    font-family: var(--font-mono);
    font-size: 0.2em;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-top: 1.2em;
  }
</style>
