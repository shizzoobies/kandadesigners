---
import LogoLockup from './LogoLockup.astro';

const year = new Date().getFullYear();
---
<footer class="border-t border-ink/10">
  <div class="mx-auto flex max-w-6xl flex-col gap-10 px-6 py-16 md:flex-row md:items-start md:justify-between">
    <div class="flex flex-col gap-4">
      <a href="/" class="self-start text-[2.75rem]" aria-label="K & A Performance home">
        <LogoLockup variant="full" />
      </a>
      <p class="max-w-xs text-sm text-muted">
        Web design &amp; AI integration studio. Built in Florida, performing everywhere.
      </p>
    </div>
    <nav class="flex flex-col gap-3" aria-label="Footer">
      <a href="/services/" class="font-heading text-sm text-muted transition-colors hover:text-ink">Services</a>
      <a href="/artists/" class="font-heading text-sm text-muted transition-colors hover:text-ink">Artists</a>
      <a href="/contact/" data-no-modal class="font-heading text-sm text-muted transition-colors hover:text-ink">Contact</a>
      <a href="/privacy/" class="font-heading text-sm text-muted transition-colors hover:text-ink">Privacy</a>
    </nav>
    <div class="flex flex-col gap-3">
      <a href="mailto:alex@ka-performancefl.com" class="font-heading text-sm text-ink transition-colors hover:text-accent">
        alex@ka-performancefl.com
      </a>
      <p class="text-xs text-muted">&copy; {year} K &amp; A Performance. All rights reserved.</p>
    </div>
  </div>
</footer>
