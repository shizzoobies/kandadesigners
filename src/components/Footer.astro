---
import LogoLockup from './LogoLockup.astro';
import { phone, email, hours } from '../data/contact.js';
import { socials } from '../data/social.js';
import { regions } from '../data/locations.js';

const year = new Date().getFullYear();

// The serving line, grouped by region in the order src/data/locations.js
// gives them, so it names exactly the towns the schema's areaServed does.
const regionPhrases = regions.map((r) => `${r.label} (${r.cities.join(', ')})`);
const servingLine = `Serving ${regionPhrases.slice(0, -1).join(', ')}, and ${regionPhrases.at(-1)}.`;

// Grouped so the footer reads as columns instead of one twelve-link ladder
// running off the bottom of the screen. Adding a page means adding a line
// here, and the column it belongs in is obvious.
const columns = [
  {
    heading: 'Services',
    links: [
      { href: '/services/', label: 'All services' },
      { href: '/services/web-design/', label: 'Web design' },
      { href: '/services/ai-integration/', label: 'AI integration' },
      { href: '/services/seo-ai-search/', label: 'SEO & AI search' },
      { href: '/services/accessibility/', label: 'Accessibility audits' },
      { href: '/training/', label: 'Training content' },
    ],
  },
  {
    heading: 'Locations',
    links: [
      { href: '/locations/gainesville/', label: 'Gainesville, FL' },
      { href: '/locations/jacksonville/', label: 'Jacksonville, FL' },
      { href: '/locations/ellenton/', label: 'Ellenton, FL' },
      { href: '/locations/bradenton-sarasota/', label: regions.find((r) => r.key === 'bradenton-sarasota').label },
    ],
  },
  {
    heading: 'Studio',
    links: [
      { href: '/artists/', label: 'Artists' },
      { href: '/free-course/', label: 'Free course' },
      { href: '/training/ai/', label: 'AI training' },
      // Footer contact stays a real navigation, not the modal.
      { href: '/contact/', label: 'Contact', noModal: true },
    ],
  },
  {
    heading: 'Legal',
    links: [
      { href: '/privacy/', label: 'Privacy' },
      { href: '/terms/', label: 'Terms & conditions' },
      { href: '/accessibility/', label: 'Accessibility statement' },
    ],
  },
];
---
<footer class="border-t border-ink/10">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="flex flex-col gap-12 md:flex-row md:items-start md:justify-between md:gap-16">
      <div class="flex flex-col gap-4 md:max-w-xs">
        {/* The accessible name must contain the lockup's visible descriptor
            text (WCAG 2.5.3, Label in Name), which Lighthouse flagged on every
            page until 2026-09-03. Voice control users say what they see. */}
        <a href="/" class="self-start text-[2.75rem]" aria-label="K & A Performance home. Web Design & AI Integration">
          <LogoLockup variant="full" />
        </a>
        <p class="text-sm text-muted">
          Web design &amp; AI integration studio. Built in Gainesville, FL. Performing everywhere.
        </p>
        <p class="text-xs text-muted">{servingLine}</p>
        {/* Hours from src/data/contact.js, the same list the schema's
            openingHoursSpecification reads. Days ink, times muted, set as a
            two-column list so the times line up. */}
        <div>
          <h2 class="font-mono text-xs uppercase tracking-[0.2em] text-ink">Hours</h2>
          <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-xs">
            {hours.map((h) => (
              <Fragment>
                <dt class="text-ink">{h.label}</dt>
                <dd class="text-muted">{h.time}</dd>
              </Fragment>
            ))}
          </dl>
        </div>
        {/* Icon-only links, so each carries its full name for screen readers.
            The 44px box is the tap target; the negative margin lines the first
            icon up with the text above. */}
        <ul class="-ml-3 flex items-center" aria-label="K & A Performance on social media">
          {socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                class="inline-flex h-11 w-11 items-center justify-center rounded transition-opacity hover:opacity-75"
              >
                <svg viewBox="0 0 24 24" class="h-6 w-6" aria-hidden="true" focusable="false">
                  {s.gradient && (
                    <defs>
                      <linearGradient id={`social-${s.name.toLowerCase()}`} x1="0" y1="1" x2="1" y2="0">
                        {s.gradient.map((c, i) => (
                          <stop offset={i / (s.gradient.length - 1)} stop-color={c} />
                        ))}
                      </linearGradient>
                    </defs>
                  )}
                  <path d={s.path} fill={s.gradient ? `url(#social-${s.name.toLowerCase()})` : s.color} />
                </svg>
                <span class="sr-only">K &amp; A Performance on {s.name} (opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Two columns on a phone, then a natural-width row. Equal grid tracks
           squeezed "Accessibility statement" onto two lines; letting the
           columns size to their content keeps every label on one. -->
      <nav class="grid grid-cols-2 gap-x-10 gap-y-10 sm:flex sm:flex-wrap sm:gap-x-12" aria-label="Footer">
        {columns.map((column) => (
          <div class="flex flex-col gap-4">
            <h2 class="font-mono text-xs uppercase tracking-[0.2em] text-ink">{column.heading}</h2>
            <ul class="flex flex-col gap-3">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    data-no-modal={link.noModal ? '' : undefined}
                    class="hit-24 font-heading text-sm text-muted transition-colors hover:text-ink"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
      <button type="button" data-privacy-open class="hit-24 font-heading text-sm text-muted underline">Privacy choices</button>
    </div>

    <div class="mt-14 flex flex-col gap-3 border-t border-ink/10 pt-8 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-8">
        <a href={`mailto:${email}`} class="hit-24 font-heading text-sm text-ink transition-colors hover:text-accent">
          {email}
        </a>
        <a href={phone.href} class="hit-24 font-heading text-sm text-ink transition-colors hover:text-accent">
          Call <span class="whitespace-nowrap">{phone.display}</span>
        </a>
      </div>
      <p class="text-xs text-muted">&copy; {year} K &amp; A Performance. All rights reserved.</p>
    </div>
  </div>
</footer>
