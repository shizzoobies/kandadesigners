---
import LogoLockup from './LogoLockup.astro';

const year = new Date().getFullYear();
---
<footer class="border-t border-ink/10">
  <div class="mx-auto flex max-w-6xl flex-col gap-10 px-6 py-16 md:flex-row md:items-start md:justify-between">
    <div class="flex flex-col gap-4">
      <a href="/" class="self-start text-[2.75rem]" aria-label="K & A Performance home">
        <LogoLockup variant="full" />
      </a>
      <p class="max-w-xs text-sm text-muted">
        Web design &amp; AI integration studio. Built in Gainesville, FL. Performing everywhere.
      </p>
      <p class="max-w-xs text-xs text-muted">
        Serving Gainesville, Alachua, Newberry, High Springs, Ocala, Jacksonville,
        Orange Park, Fleming Island, and St. Augustine.
      </p>
    </div>
    <nav class="flex flex-col gap-3" aria-label="Footer">
      <a href="/services/" class="font-heading text-sm text-muted transition-colors hover:text-ink">Services</a>
      <a href="/services/web-design/" class="font-heading text-sm text-muted transition-colors hover:text-ink">Web design</a>
      <a href="/services/ai-integration/" class="font-heading text-sm text-muted transition-colors hover:text-ink">AI integration</a>
      <a href="/services/seo-ai-search/" class="font-heading text-sm text-muted transition-colors hover:text-ink">SEO &amp; AI search</a>
      <a href="/services/accessibility/" class="font-heading text-sm text-muted transition-colors hover:text-ink">Accessibility audits</a>
      <a href="/locations/gainesville/" class="font-heading text-sm text-muted transition-colors hover:text-ink">Gainesville, FL</a>
      <a href="/locations/jacksonville/" class="font-heading text-sm text-muted transition-colors hover:text-ink">Jacksonville, FL</a>
      <a href="/artists/" class="font-heading text-sm text-muted transition-colors hover:text-ink">Artists</a>
      <a href="/contact/" data-no-modal class="font-heading text-sm text-muted transition-colors hover:text-ink">Contact</a>
      <a href="/privacy/" class="font-heading text-sm text-muted transition-colors hover:text-ink">Privacy</a>
      <a href="/accessibility/" class="font-heading text-sm text-muted transition-colors hover:text-ink">Accessibility statement</a>
    </nav>
    <div class="flex flex-col gap-3">
      <a href="mailto:alex@ka-performancefl.com" class="font-heading text-sm text-ink transition-colors hover:text-accent">
        alex@ka-performancefl.com
      </a>
      <p class="text-xs text-muted">&copy; {year} K &amp; A Performance. All rights reserved.</p>
    </div>
  </div>
</footer>
