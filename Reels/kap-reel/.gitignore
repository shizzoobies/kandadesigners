node_modules
dist
.DS_Store
.env

# Ignore the output video from Git but not videos you import into src/.
out

# Generated captures and audio, not studio assets. assets/plates and
# assets/brand stay tracked, those are permanent studio assets.
assets/captures/
assets/audio/

# Plate debug overlays and zoom crops. Regenerated on demand by
# scripts/find-quad.ts, and one per candidate is a lot of near-duplicate PNG.
assets/plates/*.quad-debug.png
assets/plates/*.zoom-*.png
# The API smoke test frame. It proved the response shape and appears nowhere.
assets/plates/smoke/

# Only the seven accepted plates are tracked (about 5 MB each). Rejected
# candidates stay on disk; config/plates.json records every generation.
assets/plates/*.png
!assets/plates/plate-laptop-shoulder-c01.png
!assets/plates/plate-ipad-lap-c01.png
!assets/plates/plate-desktop-wide-c01.png
!assets/plates/plate-handoff-c03.png
!assets/plates/plate-tablet-b-c03.png
!assets/plates/plate-phone-hands-b-c03.png
!assets/plates/plate-phone-hands-c03.png
