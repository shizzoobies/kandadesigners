# HTML must always revalidate at the edge so new deploys go live instantly.
# (The old site shipped a 7-day s-maxage that once cached, hid new deploys.)
/*
  Cache-Control: public, max-age=0, must-revalidate

# Hashed build assets are immutable: cache hard.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=86400

# Legacy apps and demos kept live for direct links, but deliberately kept out
# of search so they don't compete with the studio pages. These are static HTML
# in public/, not Astro routes, so they can't take a <meta robots> from the
# layout — the header does the same job without editing every file.
/chess/*
  X-Robots-Tag: noindex, nofollow
/tdgame/*
  X-Robots-Tag: noindex, nofollow
/sky-raider-blitz/*
